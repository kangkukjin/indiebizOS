{
  "_comment": "선언 반환 계약 ↔ 실측 대조 표본(backend/ibl/ibl_contract_drift.py, 자가점검 §1B-2). scripts 는 등록 스크립트 id → args 목록, idioms 는 관용구 이름 → 인자 목록. 검사기가 효과 없음(pure)으로 판정한 표본만 실행한다. 계약을 선언한 pure 스크립트에 표본이 없으면 점검이 '표본 없음'으로 알린다. op 마다 반환이 다르면 op 마다 하나씩 둔다.",
  "scripts": {
    "LS102Normalize": [
      {"kind": "rows", "payload": [{"item": "alias-K", "quantity": "3", "note": "preserve"}], "aliases": {"alias-K": "K"}},
      {"kind": "jsonl", "payload": "{\"item\":\"K\",\"pack\":\"2\",\"unit_price\":null}\n", "aliases": {}}
    ],
    "LS103Normalize": [
      {"items": [{"item": "K", "pack": "5", "pack_price": "675", "shipping": "80"}]}
    ],
    "판정관용구": [
      {"op": "urls", "source": {"items": [{"url": "https://example.test", "text": "needle", "title": "title"}]}},
      {"op": "prepare", "mode": "body", "source": {"items": [{"url": "https://example.test", "text": "needle", "title": "title"}]}, "question": "needle", "limit": 2},
      {"op": "match", "source": {"items": [{"url": "https://example.test", "text": "needle", "title": "title"}]}, "pattern": "needle", "limit": 2},
      {"op": "collect", "results": [{"ok": true, "value": {"items": [{"url": "https://example.test", "text": "needle"}]}}]}
    ]
  },
  "idioms": {
    "본문에서찾기": [
      {"목록": {"items": [{"url": "https://example.test", "text": "needle"}]}, "패턴": "needle", "문맥": 0, "개수": 6}
    ]
  }
}
