$시작 = [self:script]{op:"run",id:"AI팁보고서",args:{op:"start",config:$설정}}
$질의안 = $시작 >> [table:ai]{instruction:"task에 따라 result 객체를 추가하라.",schema:"result(task의 JSON 출력)",input_fields:["task","input"],preserve_rows:true}
$질의 = $질의안 >> [self:script]{op:"run",id:"AI팁보고서",args:{op:"queries",run:"$시작.run"},input_as:"data"}
$검색 = $질의 >> [table:each]{limit:$질의.count,parallel:3,collect:true,keep:["query"],on_error:"keep"} {
  $결과 = [sense:search_youtube]{query:$it.query,count:10}
  $return = {query:$it.query,data:{items:${결과.items?},success:${결과.success?},error:${결과.error?},partial:${결과.partial?},error_count:${결과.error_count?},errors:${결과.errors?},truncated:${결과.truncated?},rows_dropped:${결과.rows_dropped?},rows_unprocessed:${결과.rows_unprocessed?},unprocessed:${결과.unprocessed?}}}
}
$후보 = $검색 >> [self:script]{op:"run",id:"AI팁보고서",args:{op:"search",run:"$시작.run"},input_as:"data"}
$메타 = $후보 >> [table:each]{limit:$후보.count,parallel:4,collect:true,keep:["video_id"],on_error:"keep"} {
  $정보 = [sense:video]{op:"info",video_id:$it.video_id}
  $return = {video_id:$it.video_id,data:{items:${정보.items?},success:${정보.success?},error:${정보.error?},partial:${정보.partial?},error_count:${정보.error_count?},errors:${정보.errors?},truncated:${정보.truncated?},rows_dropped:${정보.rows_dropped?},rows_unprocessed:${정보.rows_unprocessed?},unprocessed:${정보.unprocessed?}}}
}
$선정요청 = $메타 >> [self:script]{op:"run",id:"AI팁보고서",args:{op:"metadata",run:"$시작.run"},input_as:"data"}
$선정안 = $선정요청 >> [table:ai]{instruction:"task에 따라 result 객체를 추가하라.",schema:"result(task의 JSON 출력)",input_fields:["task","input"],preserve_rows:true}
$영상 = $선정안 >> [self:script]{op:"run",id:"AI팁보고서",args:{op:"videos",run:"$시작.run"},input_as:"data"}
$자막 = $영상 >> [table:each]{limit:4,parallel:4,collect:true,keep:["video_id"],on_error:"keep"} {
  $본문 = [sense:video]{op:"transcript",video_id:$it.video_id}
  $return = {video_id:$it.video_id,data:{items:${본문.items?},success:${본문.success?},error:${본문.error?},partial:${본문.partial?},error_count:${본문.error_count?},errors:${본문.errors?},truncated:${본문.truncated?},rows_dropped:${본문.rows_dropped?},rows_unprocessed:${본문.rows_unprocessed?},unprocessed:${본문.unprocessed?},ref:${본문.ref?},saved_to_file:${본문.saved_to_file?},file_path:${본문.file_path?},transcript:${본문.transcript?},text:${본문.text?},content:${본문.content?}}}
}
$추출요청 = $자막 >> [self:script]{op:"run",id:"AI팁보고서",args:{op:"transcripts",run:"$시작.run"},input_as:"data"}
$팁 = $추출요청 >> [table:each]{limit:$추출요청.count,parallel:4,collect:true,keep:["job_id","video_id"],on_error:"keep"} {
  $추출 = [table:ai]{items:[$it],instruction:"task에 따라 팁과 구체 방법을 추출하고 result를 추가하라.",schema:"result(task의 JSON 출력)",input_fields:["task","input"],preserve_rows:true}
  $return = $추출 >> [self:script]{op:"run",id:"AI팁보고서",args:{op:"extracted_part",run:"$시작.run"},input_as:"data"}
}
$작성요청 = $팁 >> [self:script]{op:"run",id:"AI팁보고서",args:{op:"compose",run:"$시작.run"},input_as:"data"}
$보고서 = $작성요청 >> [table:ai]{instruction:"task에 따라 보고서를 작성하고 result 객체를 추가하라.",schema:"result(task의 JSON 출력)",input_fields:["task","input"],preserve_rows:true}
$완성 = $보고서 >> [self:script]{op:"run",id:"AI팁보고서",args:{op:"finish",run:"$시작.run"},input_as:"data"}
$return = $완성 >> [table:take]{n:1}
