#!ibl edition=2
[def:AI팁보고서쓰기]($설정={}) {
  $시작 = [self:script]{id:"AI팁보고서",args:{op:"start",config:$설정}}
  [if:get($시작,"completed",false)] { return $시작.items[0] }
  $질의안 = [table:ai]{items:$시작.items,instruction:"task에 따라 result 객체를 추가하라.",schema:"result(task의 JSON 출력)",input_fields:["task","input"],preserve_rows:true}
  $질의 = [self:script]{id:"AI팁보고서",args:{op:"queries",run:$시작.run,data:$질의안}}
  $검색 = $질의.items >> [table:each]{parallel:3} {
    [try] {
      $결과 = [sense:search_youtube]{query:$it.query,count:10}
      return {query:$it.query,data:$결과}
    } [catch] { return {query:$it.query,_error:$error.message} }
  }
  $후보 = [self:script]{id:"AI팁보고서",args:{op:"search",run:$시작.run,data:$검색}}
  $메타 = $후보.items >> [table:each]{parallel:4} {
    [try] {
      $정보 = [sense:video]{op:"info",video_id:$it.video_id}
      return {video_id:$it.video_id,data:$정보}
    } [catch] { return {video_id:$it.video_id,_error:$error.message} }
  }
  $선정요청 = [self:script]{id:"AI팁보고서",args:{op:"metadata",run:$시작.run,data:$메타}}
  $선정안 = [table:ai]{items:$선정요청.items,instruction:"task에 따라 result 객체를 추가하라.",schema:"result(task의 JSON 출력)",input_fields:["task","input"],preserve_rows:true}
  $영상 = [self:script]{id:"AI팁보고서",args:{op:"videos",run:$시작.run,data:$선정안}}
  $자막 = $영상.items >> [table:each]{parallel:4} {
    [try] {
      $본문 = [sense:video]{op:"transcript",video_id:$it.video_id}
      return {video_id:$it.video_id,data:$본문}
    } [catch] { return {video_id:$it.video_id,_error:$error.message} }
  }
  $추출요청 = [self:script]{id:"AI팁보고서",args:{op:"transcripts",run:$시작.run,data:$자막}}
  $팁 = $추출요청.items >> [table:each]{parallel:4} {
    [try] {
      $추출 = [table:ai]{items:[$it],instruction:"task에 따라 팁과 구체 방법을 추출하고 result를 추가하라.",schema:"result(task의 JSON 출력)",input_fields:["task","input"],preserve_rows:true}
      [self:script]{id:"AI팁보고서",args:{op:"extracted_part",run:$시작.run,data:$추출}}
      return {job_id:$it.job_id}
    } [catch] { return {job_id:$it.job_id,_error:$error.message} }
  }
  $작성요청 = [self:script]{id:"AI팁보고서",args:{op:"compose",run:$시작.run,data:$팁}}
  $보고서 = [table:ai]{items:$작성요청.items,instruction:"task에 따라 보고서를 작성하고 result 객체를 추가하라.",schema:"result(task의 JSON 출력)",input_fields:["task","input"],preserve_rows:true}
  $완성 = [self:script]{id:"AI팁보고서",args:{op:"finish",run:$시작.run,data:$보고서}}
  return $완성.items[0]
}
