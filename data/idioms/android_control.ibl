#!ibl edition=2
[def:Android제어]($대상,$요청,$대기=null) {
  $단계 = "target"
  $작업 = {status:"failed",target:$대상,verified:false,result:null,task_ref:null,verification:null,evidence_ref:null,failure:null}
  [try] {
    $목록 = [self:limb]{op:"list",limb:$대상}
    $선택 = [self:script]{id:"Android제어부품",args:{op:"select",target:$대상,request:$요청,limbs:$목록.limbs,wait:$대기}}
    $단계 = "prepare"
    $원문 = [self:read]{path:$선택.source_path}
    $계획 = [self:script]{id:"Android제어부품",args:{op:"prepare",source:$원문.text,request:$선택.request}}
    $작업 = {**$작업,verification:{request:$계획.request,request_id:$계획.request_id,platform:$계획.platform,source_sha256:$계획.source_sha256},evidence_ref:{plan:get($계획,"_receipt_ref",{})}}
    $단계 = "submit"
    $접수 = [limbs:guestpc]{limb:$대상,op:"python",code:$계획.code,request_id:$계획.request_id,timeout:$선택.timeout,background:true}
    $작업 = {**$작업,status:"pending",task_ref:$접수.task_ref,evidence_ref:{plan:get($계획,"_receipt_ref",{}),job:get($접수,"_receipt_ref",{})}}
    $단계 = "wait"
    return [fn:Android제어확인]{작업:$작업,대기:$선택.wait}
  } [catch] {
    $상태 = "failed"
    $다음 = "대상·연결·인수를 확인하세요. 장치 작업은 접수되지 않았습니다."
    [if:$단계 in ["submit","wait"]] {
      $상태 = "unknown"
      $다음 = "원래 request_id·작업 기록을 확인하세요. 변경을 재전송하지 마세요."
    }
    $조각 = split($error.message,":")
    $머리 = $조각[0]
    $코드 = null
    [if:$머리!="" and len($머리)>=3 and strip($머리,"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_")==""] { $코드 = $머리 }
    return {**$작업,status:$상태,failure:{stage:$단계,code:$코드,message:$error.message,next:$다음}}
  }
}
