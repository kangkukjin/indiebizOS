#!ibl edition=2
[def:외부PC작업확인]($작업,$대기=0) {
  $참조 = get($작업,"task_ref",{})
  [if:get($참조,"kind","")!="guestpc" or len(get($참조,"task_id",""))==0 or (has($작업,"limb") and len(get($작업,"limb",""))==0) or $대기<0 or $대기>240] {
    return {ok:false,status:"invalid_input",task:$작업,reason:"guestpc 접수증과 0~240초 대기가 필요합니다",settled:false,command_ok:null}
  }
  $관측 = {}
  [try] { $관측 = [self:task]{op:"wait",ref:$참조,timeout:$대기} }
  [catch] {
    $관측 = get($error,"details",{})
    $관측 = get($관측,"task_observation",$관측)
    [if:get($관측,"task_ref",{})!=$참조 or len(get($관측,"state",""))==0] {
      return {**$작업,ok:false,status:"observation_failed",settled:false,command_ok:null,reason:$error.message}
    }
  }
  $대상 = get($관측,"limb",get($작업,"limb",""))
  [if:len(get($작업,"limb",""))>0 and get($작업,"limb","")!=$대상] {
    return {ok:false,status:"target_mismatch",settled:false,command_ok:null,task_ref:$참조}
  }
  $작업 = {**$작업,limb:$대상,helper_mode:get($관측,"helper_mode",get($작업,"helper_mode","")),op:get($관측,"op",get($작업,"op","shell"))}
  $상태 = $관측.state
  $결과 = get($관측,"result",null)
  [if:$결과==null] { $결과 = get($관측,"execution_result",null) }
  $진행 = get($관측,"progress",null)
  $실패 = get($관측,"failure",null)
  [if:$결과==null and $상태 in ["failed","cancelled","unknown","interrupted"] and get($작업,"helper_mode","")=="resident"] {
    [try] {
      $기록 = [limbs:guestpc]{op:"history",limb:$작업.limb,job:$참조.task_id}
      [if:len($기록.tasks)==1] { $결과 = $기록.tasks[0].result }
    } [catch] { $실패 = {task_failure:$실패,history_failure:$error.message} }
  }
  $종료 = null
  $성공 = null
  [if:$상태 in ["failed","cancelled","interrupted"]] { $성공 = false }
  [if:$결과!=null] {
    $종료 = get($결과,"exit",null)
    [if:$상태=="succeeded"] {
      [if:$종료!=null] { $성공 = $종료==0 and get($결과,"timeout",false)==false and len(get($결과,"error",""))==0 }
      [if:$종료==null and get($작업,"op","shell") in ["transfer","info","wake"]] { $성공 = len(get($결과,"error",""))==0 }
    }
  }
  return {**$작업,ok:true,status:$상태,limb_name:get($작업,"limb_name",$작업.limb),
    settled:$상태 in ["succeeded","failed","cancelled","interrupted"],command_ok:$성공,exit:$종료,
    started_at:get($관측,"started_at",null),ended_at:get($관측,"ended_at",null),seconds:get($관측,"seconds",null),
    history_args:get($관측,"history_args",null),progress_scope:get($관측,"progress_scope",null),
    outcome:get($관측,"outcome",$상태),
    timed_out:get($관측,"timed_out",false),progress:$진행,result:$결과,failure:$실패}
}
