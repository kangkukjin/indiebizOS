#!ibl edition=2
[def:외부PC작업실행]($PC,$명령,$작업폴더="",$셸="",$실행제한=1800,$대기=0,$입력="",$환경초기화=false,$요청ID="",$환경={},$모드="background",$관리자=false,$준비={},$작업={},$완료까지=false) {
  $공간 = get($준비,"workspace",{})
  [if:len($작업폴더)==0] { $작업폴더 = get($공간,"cwd","") }
  $환경 = {**get($공간,"env",{}),**$환경}
  [if:len($PC)==0 or len($명령)==0 or len($작업폴더)==0 or $실행제한<1 or $실행제한>86400 or $대기<0 or $대기>240] {
    return {ok:false,status:"invalid_input",reason:"PC·명령·작업폴더, 1~86400초 실행제한, 0~240초 대기가 필요합니다"}
  }
  [if:$모드=="observe" and $실행제한>10] { return {ok:false,status:"invalid_input",reason:"확인용 observe 모드는 실행제한 1~10초가 필요합니다"} }
  $대상 = $PC
  [if:len($준비)>0] {
    [if:get($준비,"ok",false)!=true or len(get($준비,"limb",""))==0 or ($PC!=get($준비,"limb","") and $PC!=get($준비,"limb_name",""))] {
      return {ok:false,status:"target_mismatch",reason:"준비한 PC와 실행 대상이 다릅니다"}
    }
    $대상 = get($준비,"limb","")
  }
  $계약 = {pc:$대상,cmd:$명령,cwd:$작업폴더,shell:$셸,timeout:$실행제한,mode:$모드,elevate:$관리자,reset:$환경초기화,request_id:$요청ID}
  [if:len($작업)>0] {
    [if:get($작업,"invocation",{})!=$계약] { return {ok:false,status:"resume_mismatch",task:$작업} }
    $확인 = [fn:외부PC작업확인]{작업:$작업,대기:$대기,완료까지:$완료까지}
    return {**$작업,history_cursor:get($확인,"history_cursor",0),observation:$확인}
  }
  $접수 = [limbs:guestpc]{op:"shell",limb:$대상,cmd:$명령,cwd:$작업폴더,shell:$셸,
    timeout:$실행제한,background:true,stdin:$입력,reset:$환경초기화,request_id:$요청ID,env:$환경,mode:$모드,elevate:$관리자}
  $작업 = {**$접수,limb_name:get($접수,"limb_name",$PC),op:"shell",invocation:$계약}
  $확인 = [fn:외부PC작업확인]{작업:$작업,대기:$대기,완료까지:$완료까지}
  return {**$작업,ok:true,status:"accepted",cwd:$작업폴더,history_cursor:get($확인,"history_cursor",0),observation:$확인}
}
