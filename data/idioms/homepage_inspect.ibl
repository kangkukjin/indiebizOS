#!ibl edition=2
[def:홈페이지살펴보기]($사이트,$화면=true) {
  $등록 = [engines:web_site]{op:"list"}
  $대상 = $등록.sites >> [table:filter]{where:($행)=>$행.id == $사이트}
  [if:len($대상)!=1] { return {ok:false,site_id:$사이트,error:"등록된 site_id 하나를 지정하세요",items:[]} }
  $주소 = $대상[0].deploy_url
  [if:$주소 == ""] { return {ok:false,site_id:$사이트,error:"배포 URL이 없습니다",items:[]} }
  $자료 = ["content","links","screen"] >> [table:each] {
    [try] {
      [if:$it == "screen"] {
        [if:$화면] {
          $검사 = [engines:web]{op:"check",url:$주소,checks:["status","screenshot"]}
          $실패 = $검사.items >> [table:filter]{where:($행)=>$행.ok == false}
          return {kind:$it,ok:len($실패)==0,value:$검사}
        } [else] { return {kind:$it,ok:true,skipped:true} }
      }
      $읽기 = [sense:crawl]{url:$주소,op:$it,refresh:($it == "content")}
      return {kind:$it,ok:true,value:$읽기}
    } [catch] { return {kind:$it,ok:false,error:$error.message} }
  }
  $실패 = $자료 >> [table:filter]{where:($행)=>$행.ok == false}
  return {ok:len($실패)==0,site:$대상[0],items:$자료,failed:len($실패),screen_scope:"요청 시 데스크톱 1280×800 캡처; 모바일·미적 품질·링크 목적지 응답은 별도 확인"}
}
