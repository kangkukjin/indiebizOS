#!ibl edition=2
[def:매물재방문비교]($기존,$현재) {
  $변동 = $기존 >> [table:each] {
    $옛것 = $it
    $일치 = $현재 >> [table:filter]{where:($행)=>$행.id==$옛것.id}
    [if:get($옛것,"status","")=="rejected"] { return {id:$옛것.id,status:"rejected",previous:$옛것} }
    [if:len($일치)==0] { return {id:$옛것.id,status:"needs_recheck",previous:$옛것} }
    [if:len($일치)>1] { return {id:$옛것.id,status:"conflict",previous:$옛것,current:$일치} }
    [if:$일치[0].price!=$옛것.price] { return {id:$옛것.id,status:"changed",previous:$옛것,current:$일치[0]} }
    return {id:$옛것.id,status:"unchanged",previous:$옛것,current:$일치[0]}
  }
  $새것 = $현재 >> [table:each]{mode:"flat_map"} {
    $현재행 = $it
    $일치 = $기존 >> [table:filter]{where:($행)=>$행.id==$현재행.id}
    [if:len($일치)==0] { return [{id:$현재행.id,status:"new",current:$현재행}] }
    return []
  }
  return {items:$변동+ $새것,note:"양쪽 price는 같은 단위·거래 형식이어야 합니다. 검색 누락은 소멸 증거가 아니며 needs_recheck는 링크 재확인 대상입니다. DB를 쓰지 않습니다."}
}
