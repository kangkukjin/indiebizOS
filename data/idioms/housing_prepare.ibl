#!ibl edition=2
[def:부동산준비읽기]($폴더,$슬러그="") {
  $설정 = [{kind:"config",path:f"${폴더}/_report_config.json"}] >> [table:each] {
    [try] {
      $읽기 = [self:read]{path:$it.path}
      return {kind:$it.kind,path:$it.path,ok:true,text:$읽기.text}
    } [catch] { return {kind:$it.kind,path:$it.path,ok:false,error:$error.message} }
  }
  $순회 = [{kind:"rotation",path:f"${폴더}/db/rotation.json"}] >> [table:each] {
    [try] {
      $큐 = [self:ledger]{op:"select",path:$it.path,target:"queue",fields:["slug","name","unit","verdict","last_visited","visits"]}
      $탐험 = [self:ledger]{op:"select",path:$it.path,target:"explore_first"}
      return {kind:$it.kind,path:$it.path,ok:true,queue:$큐.items,queue_count:len($큐.items),explore_first:$탐험.items,note:"행 상세(sub_verdicts·verdict_note)는 target:\"queue\" where:{slug:…} 로, 최상위 설정값은 [self:read]{path} 로"}
    } [catch] { return {kind:$it.kind,path:$it.path,ok:false,error:$error.message} }
  }
  $노트 = [{kind:"thesis",path:f"${폴더}/_thesis.md"}] >> [table:each] {
    [try] {
      $전체 = [self:read]{path:$it.path}
      $블록 = get($전체,"blocks",[])
      $제목 = $블록 >> [table:filter]{where:($b)=>get($b,"type","")=="heading"} >> [table:select]{columns:["level","text"]}
      $머리 = $블록 >> [table:take]{n:6} >> [table:each] { return {type:get($it,"type",""),text:get($it,"text","")} }
      return {kind:$it.kind,path:$it.path,ok:true,chars:len($전체.text),head_blocks:$머리,headings:$제목}
    } [catch] { return {kind:$it.kind,path:$it.path,ok:false,error:$error.message} }
  }
  $이전 = [self:list]{path:$폴더,pattern:"housing_report_*.md"}
  $직전 = $이전 >> [table:filter]{where:($행)=>get($행,"is_dir",false)==false} >> [table:sort]{by:"name",descending:true} >> [table:take]{n:1} >> [table:each] {
    $전체 = [self:read]{path:$it.path}
    $블록 = get($전체,"blocks",[])
    $제목 = $블록 >> [table:filter]{where:($b)=>get($b,"type","")=="heading"} >> [table:select]{columns:["level","text"]}
    $머리 = $블록 >> [table:take]{n:10} >> [table:each] { return {type:get($it,"type",""),text:get($it,"text","")} }
    return {kind:"previous",path:$it.path,ok:true,chars:len($전체.text),head_blocks:$머리,headings:$제목}
  }
  $지역 = []
  [if:$슬러그!=""] {
    $지역파일 = [self:list]{path:f"${폴더}/db/regions",pattern:f"${슬러그}.json"}
    $지역 = $지역파일 >> [table:each] {
      $매물 = [self:ledger]{op:"select",path:$it.path,target:"listings",fields:["id","title","form","deal","price","status","found","last_seen","last_checked"]}
      $머리 = [self:read]{path:$it.path,start_line:1,end_line:20}
      return {kind:"region",path:$it.path,ok:true,listings:$매물.items,listings_count:len($매물.items),head:$머리.text,note:"verdict·recheck_if·profile·market_stats·history 는 [self:read]{path} 로"}
    }
  }
  $필수 = $설정 + $순회 + $노트
  $실패 = $필수 >> [table:filter]{where:($행)=>$행.ok==false}
  return {ok:len($실패)==0,documents:$필수 + $직전 + $지역,failed:len($실패),previous_found:len($직전)>0,region_requested:$슬러그,region_found:len($지역)>0,note:"문서마다 요약·머리 블록·경로만 싣는다. 본문 전체는 path 를 [self:read] 로(구간은 start_line·end_line) 읽는다."}
}
