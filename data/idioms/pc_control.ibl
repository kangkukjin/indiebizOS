#!ibl edition=2
[def:PC제어]($대상,$요청,$대기=null) {
  $단계 = "target"
  $작업 = {status:"failed",target:$대상,verified:false,result:null,task_ref:null,verification:null,evidence_ref:null,failure:null}
  [try] {
    $목록 = {limbs:[]}
    [if:$대상!="__local__"] { $목록 = [self:limb]{op:"list",limb:$대상} }
    $선택 = [self:script]{id:"PC제어부품",args:{op:"select",target:$대상,request:$요청,limbs:$목록.limbs,wait:$대기}}
    $단계 = "prepare"
    $원문 = [self:read]{path:$선택.source_path}
    return [fn:PC제어실행]{선택:$선택,원문:$원문}
  } [catch] {
    $정보 = get($error,"details",{})
    $원실패 = [try] { $값 = get($정보,"failure",{}); keys($값); $값 } [catch] { {} }
    $복구 = [try] { $값 = get($정보,"recovery",{}); keys($값); $값 } [catch] { {} }
    $조각 = split($error.message,":")
    $머리 = $조각[0]
    $코드 = get($정보,"error_code",get($원실패,"code",null))
    [if:$코드==null and $머리!="" and len($머리)>=3 and strip($머리,"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_")==""] { $코드 = $머리 }
    return {**$작업,failure:{**$원실패,stage:$단계,code:$코드,message:$error.message,cause:$error,recovery:$복구,next:get($복구,"next",get($원실패,"next","대상·연결·지원 동작을 확인하세요. 장치 작업은 접수되지 않았습니다."))}}
  }
}
