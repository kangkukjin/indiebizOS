#!ibl edition=2
[def:PC제어]($대상,$요청,$대기=null) {
  $단계 = "target"
  $작업 = {status:"failed",target:$대상,verified:false,result:null,task_ref:null,verification:null,evidence_ref:null,failure:null}
  [try] {
    $목록 = {limbs:[]}
    [if:$대상!="__local__"] { $목록 = [self:limb]{op:"list"} }
    $선택 = [self:script]{id:"PC제어부품",args:{op:"select",target:$대상,request:$요청,limbs:$목록.limbs,wait:$대기}}
    $단계 = "prepare"
    $원문 = [self:read]{path:$선택.source_path}
    return [fn:PC제어실행]{선택:$선택,원문:$원문}
  } [catch] {
    return {**$작업,failure:{stage:$단계,message:$error.message,next:"대상·연결·지원 동작을 확인하세요. 장치 작업은 접수되지 않았습니다."}}
  }
}
