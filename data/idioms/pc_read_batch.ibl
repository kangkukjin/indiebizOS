#!ibl edition=2
[def:PC조회묶음]($대상,$항목=["status","display","power","presence"],$대기=null) {
  assert len($항목)>0 and len($항목)<=16, "조회 항목은 1~16개입니다"
  [table:each]{items:$항목,mode:"effect"} {
    assert $it in ["status","display","power","presence","apps","clipboard","network","shortcuts"], "PC조회묶음은 읽기 동작만 받습니다"
  }
  $단계 = "target"
  $준비 = [try] {
    $목록 = {limbs:[]}
    [if:$대상!="__local__"] { $목록 = [self:limb]{op:"list",limb:$대상} }
    $선택 = [self:script]{id:"PC제어부품",args:{op:"select",target:$대상,request:{action:"status"},limbs:$목록.limbs,wait:$대기}}
    $단계 = "prepare"
    $원문 = [self:read]{path:$선택.source_path}
    {ok:true,선택:$선택,원문:$원문}
  } [catch] {
    $정보 = get($error,"details",{})
    $원실패 = [try] { $값 = get($정보,"failure",{}); keys($값); $값 } [catch] { {} }
    $복구 = [try] { $값 = get($정보,"recovery",{}); keys($값); $값 } [catch] { {} }
    $조각 = split($error.message,":")
    $머리 = $조각[0]
    $코드 = get($정보,"error_code",get($원실패,"code",null))
    [if:$코드==null and $머리!="" and len($머리)>=3 and strip($머리,"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_")==""] { $코드 = $머리 }
    {ok:false,failure:{**$원실패,stage:$단계,code:$코드,message:$error.message,cause:$error,recovery:$복구,next:get($복구,"next",get($원실패,"next","대상·연결·지원 동작을 확인하세요. 장치 작업은 접수되지 않았습니다."))}}
  }
  $행 = [table:each]{items:$항목} {
    [if:$준비.ok==false] {
      {action:$it,status:"failed",target:$대상,verified:false,result:null,task_ref:null,failure:$준비.failure}
    } [else] {
      [if:not ($it in $준비.선택.supported_actions)] {
        {action:$it,status:"failed",target:$대상,verified:false,result:null,task_ref:null,failure:{stage:"target",code:"UNSUPPORTED_ACTION",message:"UNSUPPORTED_ACTION: 선택 PC에서 지원하지 않는 동작입니다",next:"supported_actions를 확인하세요. 장치 작업은 접수되지 않았습니다."}}
      } [else] {
        $선택 = {**$준비.선택,request:{action:$it}}
        $결과 = [fn:PC제어실행]{선택:$선택,원문:$준비.원문}
        {**$결과,action:$it}
      }
    }
  }
  return {target:$대상,items:$행}
}
