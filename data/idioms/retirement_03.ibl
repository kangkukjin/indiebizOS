#!ibl edition=2
[def:최신범위읽기]($폴더,$패턴,$시작줄,$줄수) {
  $후보 = [self:list]{path:$폴더,pattern:$패턴} >> [table:filter]{where:($행)=>get($행,"is_dir",false)==false} >> [table:sort]{by:"mtime",descending:true} >> [table:take]{n:1}
  [if:len($후보)==0] { return {found:false,items:[],count:0} }
  return [self:read]{path:$후보[0].path,start_line:$시작줄,limit:$줄수}
}
