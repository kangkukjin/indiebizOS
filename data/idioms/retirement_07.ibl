#!ibl edition=2
[def:관련자료골라읽기]($목록,$질문,$개수,$문맥=0) {
  $원본 = [self:script]{id:"판정관용구",args:{op:"urls",source:$목록}}
  $준비 = [self:script]{id:"판정관용구",args:{op:"prepare",mode:"search",source:$원본,origin:$원본,question:$질문,limit:$개수,context:$문맥}}
  $판정 = $준비.items >> [table:each]{mode:"flat_map"} {
    $답 = [table:judge]{items:$it.items,instruction:$준비.instruction}
    return $답.items
  }
  $선별 = [self:script]{id:"판정관용구",args:{op:"select",mode:"search",prepared:$준비.plan,judged:{items:$판정,error_count:0},limit:$개수,context:$문맥}}
  $대상 = $선별.items
  $수집 = $대상 >> [table:each]{on_error:"collect"} { return [sense:crawl]{url:$it.url} }
  $값 = $수집 >> [table:each]{} {
    [if:is_ok($it)] { return {ok:true,source:$대상[$i],value:unwrap($it)} }
    return {ok:false,source:$대상[$i],error:error_of($it)}
  }
  $결과 = [self:script]{id:"판정관용구",args:{op:"collect",results:$값,keep:["title", "url"]}}
  return [self:script]{id:"판정관용구",args:{op:"finish",selection:$선별.selection,result:$결과}}
}
