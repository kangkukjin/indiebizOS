#!ibl edition=2
[def:검색묶음추리기]($질의들,$기간=7,$개수=6) {
  [if:$기간<1 or $개수<1] { return {ok:false,error:"기간과 개수는 1 이상이어야 합니다",items:[],queries:[],failed:0} }
  $결과 = $질의들 >> [table:each]{parallel:4} {
    $질의 = $it
    [try] {
      $원본 = [sense:search]{source:$질의.source,query:$질의.query,days:$기간,limit:$개수}
      $행들 = $원본.items >> [table:take]{n:$개수} >> [table:select]{columns:($행)=>{
        section:get($질의,"section",""),source:$질의.source,query:$질의.query,
        title:get($행,"title",""),url:get($행,"url",""),summary:get($행,"summary",""),meta:get($행,"meta",""),
        dates:{date:get($행,"date",null),published_at:get($행,"published_at",null),pubDate:get($행,"pubDate",null),published:get($행,"published",null)}
      }}
      return {ok:true,query:$질의,received:len($원본.items),shown:len($행들),items:$행들}
    } [catch] { return {ok:false,query:$질의,received:null,shown:0,items:[],error:$error} }
  }
  $항목 = $결과 >> [table:each]{mode:"flat_map"} { return $it.items }
  $관측 = $결과 >> [table:select]{columns:($행)=>{query:$행.query,ok:$행.ok,received:$행.received,shown:$행.shown,error:get($행,"error",null)}}
  $실패 = $결과 >> [table:filter]{where:($행)=>$행.ok==false}
  return {ok:len($실패)==0,items:$항목,queries:$관측,failed:len($실패)}
}
