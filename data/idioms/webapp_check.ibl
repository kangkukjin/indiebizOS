#!ibl edition=2
[def:웹앱검사하기]($프로젝트,$검사=["test","build"],$시한=120) {
  $계획 = [self:script]{op:"run",id:"웹앱작업",args:{op:"plan",project:$프로젝트,checks:$검사}}
  $결과 = $계획.items >> [table:each] {
    [try] {
      return [self:script]{op:"run",id:"웹앱작업",args:{op:"run",project:$계획.project,name:$it.name,timeout:$시한,fingerprint:$계획.fingerprint}}
    } [catch] { return {name:$it.name,ok:false,status:"error",error:$error.message} }
  }
  $실패 = $결과 >> [table:filter]{where:($행)=>$행.ok == false}
  return {project:$계획.project,ok:len($실패)==0,items:$결과,failed:len($실패)}
}
