$기존영상 = [self:ledger]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/_covered_videos.json", "target": "covered", "fields": ["id", "verdict"]};

$최근주제 = [self:ledger]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/_covered_videos.json", "target": "recent_topics"};

$기존팁 = [self:ledger]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/db/tips.json", "fields": ["tip", "date"], "where": {"topic": "디버깅"}};

$검색 = ([sense:search_youtube]{"query": "클로드 코드 디버깅 오류 수정", "count": 12} >> [table:compute]{"set": {"branch": "'한국어'"}}) & ([sense:search_youtube]{"query": "AI coding debugging workflow", "count": 12} >> [table:compute]{"set": {"branch": "'영어'"}}) & ([sense:search_youtube]{"query": "Claude Code debug failing tests", "count": 12} >> [table:compute]{"set": {"branch": "'워크플로'"}}) & ([sense:search_youtube]{"query": "AI coding debugging limitations", "count": 12} >> [table:compute]{"set": {"branch": "'회의론'"}}) & ([sense:search_youtube]{"query": "에러 로그 AI 버그 재현", "count": 12} >> [table:compute]{"set": {"branch": "'행위'"}}) >> [table:union] >> [table:dedup]{"by": "video_id"};

$저장_01_search = $검색 >> [self:write]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/01_search.json", "format": "json"};

$신규 = $검색 >> [table:filter]{"where": {"field": "video_id", "op": "not_in", "value": "${기존영상.items.*.id}"}};

$조회 = $신규 >> [table:each]{"limit": 60, "parallel": 4, "on_error": "keep", "keep": ["branch"], "do": "[sense:video]{\"op\": \"info\", \"video_id\": \"$it.video_id\"}"};

$정보 = $조회 >> [table:each]{"limit": 60, "do": "[table:take]{\"items\": [{\"video_id\": \"${it.video_id?}\", \"title\": \"${it.title?}\", \"uploader\": \"${it.uploader?}\", \"duration\": \"${it.duration?}\", \"view_count\": \"${it.view_count?}\", \"upload_date\": \"${it.upload_date?}\", \"url\": \"${it.url?}\", \"branch\": \"${it.branch?}\", \"info_error\": \"${it._error?}\"}], \"n\": 1}"};

$저장_02_info = $정보 >> [self:write]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/02_info.json", "format": "json"};

$최신 = $정보 >> [table:filter]{"where": [{"field": "info_error", "op": "eq", "value": ""}, {"field": "upload_date", "op": "gte", "value": "2026-03-12"}, {"field": "upload_date", "op": "lte", "value": "2026-09-08"}]};

$심사 = $최신 >> [table:ai]{"instruction": "모든 입력 행과 원 필드를 유지하고 selected(불리언), reason(한국어 한 문장), language(ko/en)만 추가하라. 디버깅의 실제 재현·로그·테스트 실패·수정 검증에 쓸 조작 지식이 있을 영상을 정확히 4편 선정하라(후보가 4편 미만이면 전부). 한국어와 영어 층을 섞고, branch 회의론의 관련 영상이 있으면 최소 1편 넣는다. 같은 채널 중복보다 관점 다양성, 뉴스·홍보·단순 시연보다 구체적 튜토리얼 우선. duration은 초이며 3600초 이상은 최대 1편. source metadata를 수정하지 말라.", "criteria": "입력 행 수·video_id 보존. selected는 불리언, reason과 language가 모든 행에 있다. selected true는 4편(입력이 4편 미만이면 전부), 3600초 이상 최대 1편."};

$저장_03_selection = $심사 >> [self:write]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/03_selection.json", "format": "json"};

$선정 = $심사 >> [table:filter]{"where": {"selected": true}} >> [table:take]{"n": 4};

$팁후보 = $선정 >> [table:each]{"limit": 4, "parallel": 4, "on_error": "continue", "keep": ["video_id", "title", "uploader", "url", "language"], "do": "$자막 = [sense:video]{\"op\": \"transcript\", \"video_id\": \"$it.video_id\", \"language\": \"$it.language\"} ?? [sense:video]{\"op\": \"transcript\", \"video_id\": \"$it.video_id\", \"language\": \"en\"}; $자막보존 = $자막 >> [self:write]{\"path\": \"/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/transcripts/${it.video_id}.json\", \"format\": \"json\"}; $자막 >> [self:struct]{\"grounded\": true, \"known\": \"${기존팁.items.*.tip}\", \"schema\": \"tip(한국어 실행형 팁 제목·동사로 끝남), timestamp(MM:SS)\", \"instruction\": \"디버깅·재현·로그·테스트·검증 관련 실제 조작 팁만 최대 8개. 덕담·홍보 제외. 제목과 타임스탬프만. 근거 _quote는 원문 철자 그대로 8~12단어 안의 앵커.\", \"criteria\": \"행마다 tip와 _quote가 있다. 실행 가능한 디버깅 팁이며 최대 8행. timestamp는 원문 시간 또는 null이며 꾸민 시각을 넣지 않는다.\"}"};

$저장_04_tip_candidates = $팁후보 >> [self:write]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/04_tip_candidates.json", "format": "json"};

$절제 = $팁후보 >> [table:ai]{"instruction": "입력의 모든 행과 원 필드는 유지하고 selected 불리언과 dedup_note 한 문장만 추가. 영상당 2~5개, 전체 8~15개(가능하면 12개)의 가장 실행 가능한 팁을 선정하라. 영상 균형·서로 다른 디버깅 단계·반대 관점을 살리고 같은 행동의 재탕은 제거. 이미 수집한 오늘 주제 팁과 대조: ${기존팁.items}. 재탕이면 selected false와 수집 날짜. 유효한 후보가 적으면 수를 채우려고 만들지 말라.", "criteria": "모든 입력 행과 tip·video_id 보존, selected 불리언과 dedup_note 존재. 선정은 영상당 2~5행, 전체 8~15행. 원문 밖 팁을 추가하지 않는다."};

$저장_05_tip_selection = $절제 >> [self:write]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/05_tip_selection.json", "format": "json"};

$선정팁 = $절제 >> [table:filter]{"where": {"selected": true}} >> [table:take]{"n": 15};

$정독영상 = $선정 >> [table:filter]{"where": {"field": "video_id", "op": "in", "value": "${선정팁.items.*.video_id}"}};

$상세 = $정독영상 >> [table:each]{"limit": 4, "parallel": 4, "on_error": "continue", "keep": ["video_id", "title", "uploader", "url"], "do": "$이영상팁 = [table:filter]{\"items\": \"${선정팁.items}\", \"where\": {\"field\": \"video_id\", \"op\": \"eq\", \"value\": \"$it.video_id\"}}; [self:struct]{\"file\": \"/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/transcripts/${it.video_id}.json\", \"grounded\": true, \"known\": \"${기존팁.items.*.tip}\", \"schema\": \"tip(주어진 제목 그대로), how(구체적 단계·설정·명령·프롬프트; 원문에 없으면 빈 문자열), tools(문자열), hype(과장 간극 한국어 한 줄; 없으면 빈 문자열), timestamp(MM:SS)\", \"instruction\": \"다음 제목들에 대해서만 각 1행: ${이영상팁.items.*.tip}. how는 한국어로 원문에서 설명한 방법만 쓴다. 원문에 없는 명령·수치·단계는 보완하지 않는다. 고유명사 철자가 불확실하면 (자막 표기·철자 불확실)을 붙인다. _quote 원문 앵커 필수.\", \"criteria\": \"요청한 tip 제목 각각 1행, 새 제목 추가 금지. 모든 행에 how/tools/hype/_quote. 원문에서 말한 실행 방법만 담고 timestamp는 원문 시간 또는 null.\"}"};

$저장_06_details = $상세 >> [self:write]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/06_details.json", "format": "json"};

$확정 = [table:join]{"left": "$상세", "right": "$선정팁", "on": ["video_id", "tip"]};

$팁수 = $확정 >> [table:groupby]{"by": "video_id", "agg": {"tip_count": ["count"]}};

$완료영상 = [table:join]{"left": "$정독영상", "right": "$팁수", "on": "video_id"};

$편집 = $확정 >> [table:ai]{"instruction": "입력 모든 행·사실·방법·출처를 그대로 보존하고 implication(한 줄)과 try_candidate(불리언, true 최대 3개)만 추가하라. 사용자는 Claude Code·IndieBiz OS를 쓰는 고급 사용자이며 하네스의 실행 오류·AI 호출·시간·토큰을 줄이고 싶다. implication은 이미 하는 것/이식 후보/해당 없음 중 하나로 시작. 실제 구현을 확인하지 못했으므로 이미 하는 것이라고 단정하지 말고, 구체적인 적용 제안은 원문 사실과 분리해 '이식 후보:'로 적는다. 시도 후보는 오늘 호 안에서만 끝난다.", "criteria": "입력 행수 및 모든 원 필드 보존. implication이 모든 행에 있다. try_candidate는 모든 행에서 불리언이며 true는 최대 3행."};

$저장_07_edited = $편집 >> [self:write]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/07_edited.json", "format": "json"};

$검법팁수 = $편집 >> [table:reduce]{"init": 0, "step": "acc + 1"};

$검법편수 = $완료영상 >> [table:reduce]{"init": 0, "step": "acc + 1"};

$불균형 = $팁수 >> [table:filter]{"where": "tip_count < 2 or tip_count > 5"};

[if: $검법팁수.value >= 8 and $검법팁수.value <= 15 and $검법편수.value >= 2 and $검법편수.value <= 4 and empty($불균형.items)]{
$원장델타 = $정보 >> [table:each]{"limit": 60, "do": "$건수 = [table:filter]{\"items\": \"${팁수.items}\", \"where\": {\"field\": \"video_id\", \"op\": \"eq\", \"value\": \"$it.video_id\"}} >> [table:reduce]{\"init\": 0, \"step\": \"acc + tip_count\"}; [table:take]{\"items\": [{\"id\": \"$it.video_id\", \"title\": \"$it.title\", \"channel\": \"$it.uploader\", \"date\": \"2026-09-08\", \"upload_date\": \"$it.upload_date\", \"topic\": \"디버깅\", \"n\": \"$건수.value\", \"info_error\": \"$it.info_error\"}], \"n\": 1} >> [table:compute]{\"set\": {\"verdict\": \"'tips_' + str(n) if n > 0 else ('not_selected' if info_error else ('too_old' if upload_date < '2026-03-12' else 'not_selected'))\", \"note\": \"'영상 정보 조회 실패; 최신성 미확인' if info_error else ('자막에서 팁 추출' if n > 0 else '선정·정독·팁 확정 제외; 실험 단계 파일 참조')\"}} >> [table:select]{\"columns\": [\"id\", \"title\", \"channel\", \"date\", \"upload_date\", \"topic\", \"verdict\", \"note\"]}"};

$저장_08_ledger_delta = $원장델타 >> [self:write]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/08_ledger_delta.json", "format": "json"};

$평탄팁 = $편집 >> [table:compute]{"set": {"topic": "'디버깅'", "channel": "uploader", "date": "'2026-09-08'", "report": "'ai_tips_report_2026-09-08_디버깅.md'"}} >> [table:select]{"columns": ["tip", "how", "topic", "video_id", "title", "channel", "url", "date", "report", "try_candidate"]};

$저장_09_tips_flat = $평탄팁 >> [self:write]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/09_tips_flat.json", "format": "json"};

$중첩 = [self:script]{"op": "run", "id": "팁행source중첩", "args": {"src": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/09_tips_flat.json", "out": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/10_tips_nested.json"}};

$원장갱신 = [self:ledger]{"op": "upsert", "path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/_covered_videos.json", "target": "covered", "key": "id", "items_file": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/08_ledger_delta.json"};

$주제갱신 = [self:ledger]{"op": "append", "path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/_covered_videos.json", "target": "recent_topics", "item": {"date": "2026-09-08", "topic": "디버깅"}, "max_items": 10};

$팁갱신 = [self:ledger]{"op": "append", "path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/db/tips.json", "items_file": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/10_tips_nested.json"};

$M = [self:ledger]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/db/tips.json", "fields": ["tip"]} >> [table:reduce]{"init": 0, "step": "acc + 1"};

$K = [self:ledger]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/_covered_videos.json", "target": "covered", "fields": ["id"], "where": {"field": "verdict", "op": "startswith", "value": "tips_"}} >> [table:reduce]{"init": 0, "step": "acc + 1"};

$T = [self:ledger]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/_covered_videos.json", "target": "covered", "fields": ["id"]} >> [table:reduce]{"init": 0, "step": "acc + 1"};

$N = $완료영상 >> [table:reduce]{"init": 0, "step": "acc + 1"};

$검사수 = $정보 >> [table:reduce]{"init": 0, "step": "acc + 1"};

$최신수 = $최신 >> [table:reduce]{"init": 0, "step": "acc + 1"};

$오늘팁수 = $편집 >> [table:reduce]{"init": 0, "step": "acc + 1"};

$보고재료 = $편집 >> [table:select]{"columns": ["tip", "how", "tools", "hype", "timestamp", "_quote", "video_id", "title", "uploader", "url", "implication", "try_candidate"]};

$보고서 = $보고재료 >> [table:brief]{"instruction": "유튜브 AI 팁 보고서 완성본을 한국어 Markdown으로 쓴다. H1 정확히 '# 유튜브 AI 팁 보고서 — 2026-09-08 — 디버깅'. 머리줄 정확히 '> 오늘의 영상 ${N.value}편 · 누적: 팁 ${M.value}개 / 다룬 영상 ${K.value}편(후보 등재 ${T.value}편)'. ## 한눈에 (TL;DR): 최강 신호 2~3개, 서로 다른 영상이 같은 결론/반대 결론이면 명시하되 억지 교차 확인 금지. ## 오늘의 팁: 입력 모든 ${오늘팁수.value}개를 tip 제목 그대로 ### 번호. 제목으로 배치하고 각각 - **방법**: how의 구체적 단계·설정을 빠짐없이, - **출처**: [title](url) — uploader · timestamp, - **보정**: hype(없으면 생략), - **우리 시스템 함의**: implication 순서. 원문에 없는 단계·명령·도구·수치는 추가하지 말고 how가 비면 영상 확인 필요라고 적는다. timestamp가 null이면 '시각 미확인'으로 표시. 불확실한 고유명사는 자막 표기·철자 불확실이라고 표시한다. ## 시도 후보: try_candidate true인 것만 최대 3개. 그날 호의 제안으로만 쓰고 재촉·부채 금지. ## 오늘의 영상: 아래 실제 영상 목록 각각 [title](url) — uploader · view_count회 · duration초 · upload_date · 팁 밀도·과장에 대한 한줄평. 영상 목록: ${완료영상.items}. ## 지켜볼 점 / 내일 주제 후보: 디버깅 관점의 남은 논점과 최근 주제에 없는 후보 2개. 최근 주제: ${최근주제.items}. ## 이 호의 한계: 자막만 읽었고 실효는 테스트하지 않았음, 날짜 확인 ${검사수.value}편 중 180일 통과 ${최신수.value}편, 팁 확정에 기여한 정독 ${N.value}편. 원장 복사본에서 실행한 실험판이며 누적 수는 그 복사본 기준임을 명시. _quote는 기계 검증용 근거이므로 장문 인용을 싣지 말라. 본문 전체를 코드펜스로 감싸지 말라.", "criteria": "지정한 H1·머리줄과 6개 섹션을 갖춘 한국어 보고서. 입력 팁을 모두 다루고 각 팁에 방법·정확한 출처 URL·시각 또는 시각 미확인·우리 시스템 함의가 있다. 입력 밖 방법·명령·수치를 추가하지 않으며 시도 후보 최대 3개. 실효 미검증·실험판을 명시."};

