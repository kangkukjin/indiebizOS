$情報修正 = [self:read]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/02_info.json"};
$팁수정 = [self:read]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/07_edited.json"} >> [table:groupby]{"by": "video_id", "agg": {"n": ["count"]}};
$有 = [table:join]{"left": "$情報修正", "right": "$팁수정", "on": "video_id"};
$無 = $情報修正 >> [table:filter]{"where": {"field": "video_id", "op": "not_in", "value": "${팁수정.items.*.video_id}"}} >> [table:compute]{"set": {"n": "0"}};
$全 = $有 & $無 >> [table:union] >> [table:compute]{"set": {"id": "video_id", "channel": "uploader", "date": "'2026-09-08'", "topic": "'디버깅'", "verdict": "'tips_' + str(n) if n > 0 else ('too_old' if upload_date < '2026-03-12' else 'not_selected')", "note": "'자막에서 팁 추출' if n > 0 else '선정·정독·팁 확정 제외; 실험 단계 파일 참조'"}} >> [table:select]{"columns": ["id", "title", "channel", "date", "upload_date", "topic", "verdict", "note"]};
$수정파일 = $全 >> [self:write]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/08_ledger_delta.json", "format": "json"};
$수정원장 = [self:ledger]{"op": "upsert", "path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/_covered_videos.json", "target": "covered", "key": "id", "items_file": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/08_ledger_delta.json"};
$새총수 = [self:ledger]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/_covered_videos.json", "target": "covered", "fields": ["id"]} >> [table:reduce]{"init": 0, "step": "acc + 1"};
$머리수정 = [self:edit]{"path": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/ai_tips_report_2026-09-08_디버깅.md", "old_string": "후보 등재 1264편", "new_string": "후보 등재 ${새총수.value}편", "replace_all": true};
$html수정 = [self:script]{"op": "run", "id": "보고서HTML", "args": {"src": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/ai_tips_report_2026-09-08_디버깅.md", "dst": "/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/experiments/ai_tips_onepass_2026_09_08/AI 팁 보고서 2026-09-08 디버깅.html", "subtitle": "IBL 한 번 실행 실험판 · 자막 기반 · 실효 미검증", "theme": "card", "drop_lines": ["우리 시스템 함의"]}};
