$투자 = [sense:search]{source: "gnews", queries: ["AI startup raises funding round valuation", "AI data center power grid nuclear deal", "AI chip export control semiconductor", "AI 스타트업 투자 유치 시리즈", "AI 반도체 수주 계약 실적"], limit: 12} & [sense:search]{source: "naver", type: "news", query: "AI 투자 유치 밸류에이션", sort: "date", limit: 15} >> [table:union] >> [table:dedup]{by: "url"} >> [table:filter]{where: "date >= 2026-08-26"} >> [table:select]{columns: ["title", "url", "date", "summary", "query"]}
$기술 = [sense:search]{source: "gnews", queries: ["new AI model release open weights", "on-device AI NPU smartphone model", "AI agent framework launch developers", "robot foundation model release humanoid", "AI 모델 공개 오픈소스 성능"], limit: 12} & [sense:search]{source: "hn", query: "LLM", days: 5, limit: 20} & [sense:search]{source: "hn", query: "AI agent", days: 5, limit: 15} >> [table:union] >> [table:dedup]{by: "url"} >> [table:filter]{where: "date >= 2026-08-26"} >> [table:select]{columns: ["title", "url", "date", "summary", "query"]}
$논문 = [self:script]{op: "run", id: "arxiv최신피드", args: {categories: ["cs.LG", "cs.AI"], limit: 50}} ?? [sense:paper]{op: "search", source: "arxiv", query: "large language model agents evaluation", limit: 30}
$사례 = [sense:search]{source: "gnews", queries: ["AI 활용 사례 병원 학교 행정 도입", "built with AI agent real world results productivity", "AI discovered new material drug scientists"], limit: 10} & [sense:search]{source: "naver", type: "blog", query: "AI로 만든 후기 직접", sort: "date", limit: 15} & [sense:search]{query: "site:reddit.com 'I used Claude Code to' 2026", limit: 10} >> [table:union] >> [table:dedup]{by: "url"} >> [table:select]{columns: ["title", "url", "date", "summary", "query"]}
$깃허브 = [self:script]{op: "run", id: "github저장소메타", args: {query: "topic:ai created:>2026-09-02", limit: 15, sort: "stars"}} & [self:script]{op: "run", id: "github저장소메타", args: {query: "topic:agents created:>2026-09-02", limit: 15, sort: "stars"}} >> [table:union] >> [table:dedup]{}
$공식 = [sense:feed]{url: "https://openai.com/news/rss.xml", limit: 8} & [sense:feed]{url: "https://blogs.nvidia.com/feed/", limit: 8} & [sense:feed]{url: "https://deepmind.google/blog/rss.xml", limit: 6} >> [table:union] >> [table:select]{columns: ["title", "url", "meta", "source"]}
[on_error: null] $앤스로픽 = [sense:crawl]{url: "https://www.anthropic.com/news", op: "links"} >> [table:take]{n: 30}
$예약 = [sense:search]{source: "gnews", queries: ["Zhipu GLM share placement funding", "Smaug model independent evaluation", "Cohere funding round valuation closed", "ChatGPT Pro new signups resume", "Unitree UnifoLM code release"], limit: 6} >> [table:filter]{where: "date >= 2026-09-12"} >> [table:select]{columns: ["title", "url", "date", "query"]}
$투자증류 = $투자 >> [table:take]{n: 45} >> [table:ai]{instruction: "오늘은 2026-09-16. AI 투자·경제 뉴스 후보다. 각 행에 section='투자', event_id(같은 사건은 같은 슬러그), label, delta, summary 를 채워라. label 규칙: NEW = date 가 2026-09-02 이후이고 아래 '이미 다룬 주제'에 없는 새 사건(자금조달·M&A·반도체 수급·빅테크 투자·정책·규제). CHANGED = 이미 다룬 주제의 실제 진전·반전(마감·확정·반박·수치 갱신). ONGOING = 이미 다룬 주제의 변화 없는 재보도. DROP = 단순 주가 등락·종목 시세·광고·리스티클·2026-08-26 이전 사건·AI 와 무관. 뉴스 수집기 date 는 발행일이 아닐 수 있으니 확신 없으면 NEW 대신 ONGOING. 이미 다룬 주제: 코히어 200억달러 협상, 오픈AI 글래스이미징 인수, 뉴언스 시리즈A, 앤스로픽 IPO·엔비디아 100억 투자·9650억 밸류, 즈푸 50억달러 조달, ADI Alif 인수, 구글 핀란드 130억유로, 퀄컴-아마존 워런트, 하비 5.5억, SK호라이즌 KKR, 미스트랄 30억유로, 코그니션 20억, 리슨랩스 철회, 포지트론, 엔비디아-허깅페이스 130억, TSMC 8월 매출, 엔플레임 상장, 화웨이 AI칩 인상, 뉴섬 AI법안 서명, GSA OneGov 50%, 샌더스 초지능 금지법안, Midas SB53, 한은 빅테크 투자 정점, 딥시크 과창판. delta 는 직전 대비 무엇이 새로운가 한 줄, summary 는 주체·수치·날짜·출처매체를 담은 두 문장.", schema: "section(문자열), event_id(사건 슬러그), label(NEW|CHANGED|ONGOING|DROP), delta(한 줄), summary(두 문장)", criteria: "label 은 NEW·CHANGED·ONGOING·DROP 중 하나; label 이 NEW 인 행의 date 는 2026-09-02 이상; rows_dropped == 0"} >> [table:filter]{where: "label != DROP"}
$기술증류 = $기술 >> [table:take]{n: 50} >> [table:ai]{instruction: "오늘은 2026-09-16. AI 기술·연구 뉴스 후보(구글뉴스+HN)다. 각 행에 section='기술', event_id, label, delta, summary 를 채워라. label: NEW = date 2026-09-02 이후이고 아래 '이미 다룬 주제'에 없는 새 모델·벤치마크·오픈소스·기법·에이전트·로보틱스·온디바이스 발표. CHANGED = 이미 다룬 주제의 진전·반전(공개 확정·외부 평가·정정). ONGOING = 변화 없는 재보도. DROP = 광고·리스티클·튜토리얼·의견 칼럼·2026-08-26 이전·AI 무관·단순 주가. date 가 발행일이 아닐 수 있으니 확신 없으면 ONGOING. 이미 다룬 주제: IFM K2 Horizon, 유니트리 UnifoLM-WLA, Real-SWE 벤치마크, 인실리코 과학 소형모델, 딥시크 V4.1 Flash·V4 Pro 라우팅, Smaug 3종, SWE-2, Fusion Desktop CLI, GPT-6 Astra·ChatGPT Pro 가입중단, 오픈AI Agents API·Codex 관리형, GPT-Live-1, ChatGPT Data 에이전트, 앤트그룹 Ling-3.0-flash-Fin, 휴메인 M3, MiniCPM5, XPENG IRON, AlphaGenome Atlas, 나비에스토크스 오픈AI, IBM PatchTST, GLM5.3, GPU-CFR, BioCLIP, TART, Gradio Workflow, Nemotron3Ultra, Gemini 3.8 Flash, WeatherNext 3, shadcn lint. delta 는 직전 대비 새 점 한 줄, summary 는 주체·수치·날짜·매체를 담은 두 문장.", schema: "section(문자열), event_id(사건 슬러그), label(NEW|CHANGED|ONGOING|DROP), delta(한 줄), summary(두 문장)", criteria: "label 은 NEW·CHANGED·ONGOING·DROP 중 하나; label 이 NEW 인 행의 date 는 2026-09-02 이상; rows_dropped == 0"} >> [table:filter]{where: "label != DROP"}
$논문증류 = $논문 >> [table:take]{n: 50} >> [table:ai]{instruction: "오늘은 2026-09-16. arXiv 최신 논문 목록이다. 각 행에 section='논문', event_id, label, delta, summary 를 채워라. AI 동향 보고서 독자(하네스·에이전트 시스템을 짓는 사람)에게 주목할 논문만 NEW 로: 발행일 2026-09-02 이후이고 에이전트·평가 방법론·추론 효율·하네스·도구 사용·데이터 오염·안전 중 새 발견·새 방법·반직관 결과가 있는 것. 점진적 성능 개선 보고·특정 도메인 응용·서베이는 DROP. 지난 호 논문(통신 티켓 자율연구 2609.13073, 이진 진실성 벤치 누출 2609.13003, Hopper SM 활용률 2609.12923, MoE 반복데이터 과적합, 타깃누수)은 DROP. NEW 는 최대 6편. delta 는 왜 주목하나 한 줄, summary 는 방법·핵심 결과 두 문장.", schema: "section(문자열), event_id(arXiv id), label(NEW|DROP), delta(한 줄), summary(두 문장)", criteria: "label 은 NEW·DROP 중 하나; label 이 NEW 인 행은 6행 이하; rows_dropped == 0"} >> [table:filter]{where: "label == NEW"}
$사례증류 = $사례 & $깃허브 >> [table:union] >> [table:take]{n: 55} >> [table:ai]{instruction: "오늘은 2026-09-16. AI 활용 사례 후보(뉴스·네이버 블로그·Reddit·최근 생성 GitHub 저장소)다. 각 행에 section='사례', event_id, label, delta, summary 를 채워라. 선별 기준 둘: 신규성(흔한 챗봇 Q&A·요약·코딩 보조 제외)과 파급력(일하는 방식·판도를 바꿀 잠재력). 1인칭 실사용담이나 구체 산출물(진단·수치·결과물)이 있으면 우대. NEW = 기준 통과이고 date 가 2026-09-02 이후로 확인되거나 GitHub created 가 2026-09-02 이후. 날짜 미확인이면 ONGOING. 껍데기 저장소·단순 래퍼·리스티클·광고·강의 홍보·지난 호 사례(사내 대시보드 Claude, shadcn lint, 김부장 액션, Rubato, reverify, tokentab, Copperhead, OtoDock, Geiger)는 DROP. NEW 는 최대 6건. delta 는 무엇이 새로운가 한 줄, summary 는 누가·무엇을·어떻게·결과 두 문장.", schema: "section(문자열), event_id(사건 슬러그), label(NEW|ONGOING|DROP), delta(한 줄), summary(두 문장)", criteria: "label 은 NEW·ONGOING·DROP 중 하나; label 이 NEW 인 행은 6행 이하; rows_dropped == 0"} >> [table:filter]{where: "label != DROP"}
$후보 = $투자증류 & $기술증류 & $논문증류 & $사례증류 >> [table:union]
$후보 >> [table:groupby]{by: ["section", "label"]}