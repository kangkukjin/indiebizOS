$원장 = [self:ledger]{path: "outputs/ai_tips_reports/_covered_videos.json", op: "select", target: "covered", fields: ["id", "verdict"]}
$검색 = [sense:search_youtube]{query: "AI로 공부", limit: 12} & [sense:search_youtube]{query: "study with AI", limit: 12} & [sense:search_youtube]{query: "AI tutor tips", limit: 12} & [sense:search_youtube]{query: "NotebookLM study tips", limit: 12} & [sense:search_youtube]{query: "AI studying overrated OR limitations OR trap", limit: 12} >> [table:union] >> [table:dedup]{by: "video_id"} >> [table:filter]{where: {field: "video_id", op: "not_in", value: "${원장.items.*.id}"}}
$정보 = $검색 >> [table:each]{do: "[sense:video]{op: 'info', video_id: '$it.video_id'}", limit: 70, on_error: "continue"}
$신선 = $정보 >> [table:filter]{where: "upload_date >= 2026-03-11"} >> [table:sort]{by: "view_count", desc: true} >> [table:select]{columns: ["video_id", "title", "uploader", "view_count", "duration", "upload_date", "url"]}
$신선 >> [table:take]{n: 40}