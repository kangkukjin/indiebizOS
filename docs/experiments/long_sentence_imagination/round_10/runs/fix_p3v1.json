{
 "request": {
  "code": "#!ibl edition=2\n# 10회차 P3 v1 렌더·저장 (v0: 줄 첫 + 는 계속이 아님 SYNTAX → 연산자를 줄 끝으로) — inputs: 분석={$ref P2}, 달(문자열), 보고서(md 경로), 목록(json 경로)\n$단서문 = $분석.출결단서 == null ? \"\" : \"\\n> 주의: \" + $분석.출결단서 + \"\\n\"\n$보고 = \"# 학원 \" + $달 + \" 운영 점검 보고서\\n\\n\" +\n  \"- 재원 \" + text($분석.재원수) + \"명, 퇴원 \" + text($분석.퇴원수) + \"명, 출결 기록 \" + text($분석.출결행수) + \"건, 수납 합계 \" + text($분석.수납합계) + \"원\\n\" +\n  \"- 확인할 문제 \" + text(len($분석.문제)) + \"건\\n\" + $단서문 +\n  \"\\n## 읽은 파일\\n| 파일 | 상태 | 행수 | 비고 |\\n| --- | --- | --- | --- |\\n\" +\n  join(\"\\n\", $분석.파일상태 >> [table:each]{ return \"| \" + $it.파일 + \" | \" + $it.상태 + \" | \" + text($it.행수) + \" | \" + ($it.오류 == null ? \"\" : $it.오류) + \" |\" }) +\n  \"\\n\\n## 문제 요약\\n| 종류 | 건수 |\\n| --- | --- |\\n\" +\n  join(\"\\n\", $분석.종류별 >> [table:each]{ return \"| \" + $it.종류 + \" | \" + text($it.건수) + \" |\" }) +\n  \"\\n\\n## 반별 현황\\n| 반 | 학생 수 | 출석률 | 평균 점수 |\\n| --- | --- | --- | --- |\\n\" +\n  join(\"\\n\", $분석.반표 >> [table:each]{ return \"| \" + $it.반 + \" | \" + text($it.학생수) + \" | \" + text($it.출석률) + \"% | \" + ($it.평균점수 == null ? \"-\" : text($it.평균점수)) + \" |\" }) +\n  \"\\n\\n## 상담 메모 유형 (AI 가 나눔)\\n| 유형 | 건수 |\\n| --- | --- |\\n\" +\n  join(\"\\n\", $분석.유형별 >> [table:each]{ return \"| \" + $it.유형 + \" | \" + text($it.건수) + \" |\" }) +\n  \"\\n\\n조치 필요·확인 필요 메모:\\n\" +\n  join(\"\\n\", $분석.조치메모 >> [table:each]{ return \"- [\" + $it.유형 + \"] \" + $it.일자 + \" \" + $it.학번 + \": \" + $it.메모 }) +\n  \"\\n\\n## 문제 목록\\n\" +\n  join(\"\\n\", $분석.문제 >> [table:each]{ return \"- [\" + $it.종류 + \"] \" + $it.대상 + \" — \" + $it.근거 + (get($it,\"단서\") == null ? \"\" : \" (\" + get($it,\"단서\",\"\") + \")\") }) +\n  \"\\n\"\n$목록본 = json({달:$달,문제수:len($분석.문제),종류별:$분석.종류별,출결단서:$분석.출결단서,문제:$분석.문제,메모유형:$분석.유형표})\n$쓰기 = [self:write]{path:$보고서,content:$보고} & [self:write]{path:$목록,content:$목록본}\n$재읽기 = [self:read]{path:$보고서} & [self:read]{path:$목록}\nreturn {보고일치:$재읽기[0].text == $보고,목록일치:$재읽기[1].text == $목록본,보고글자:len($보고),문제수:len($분석.문제)}\n",
