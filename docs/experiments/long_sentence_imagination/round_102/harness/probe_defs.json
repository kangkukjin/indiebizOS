{
  "LS102ReportProbe": "[def:LS102ReportProbe]($lib,$lines,$cost,$ready,$receipt){\n  return {library:$lib.id,label:upper($lib.label),lines:$lines,total_cost:$cost,ready:$ready,receipt:$receipt}\n}",
  "LS102LibraryProbe": "[def:LS102LibraryProbe]($lib,$demand,$quotes,$asof,$policy,$ledger){\n  $rows=$demand >> [table:filter]{where:($r)=>$r.library==$lib.id}\n  $lines=$rows >> [table:each]{return [fn:LS102Choose]{line:$it,quotes:$quotes,asof:$asof,policy:$policy}}\n  $cost=sum(map($lines,($r)=>$r.cost))\n  $ready=len(filter($lines,($r)=>$r.status==\"hold\"))==0 and $cost<=$lib.budget\n  $receipt=null\n  [if:$ready]{$receipt=[self:script]{id:\"LS102Append\",args:{path:$ledger,request:{library:$lib.id,lines:$lines,total_cost:$cost}}}}\n  return [fn:LS102ReportProbe]{lib:$lib,lines:$lines,cost:$cost,ready:$ready,receipt:$receipt}\n}",
  "LS102PlanProbe": "[def:LS102PlanProbe]($root,$ledger){\n  $data=[fn:LS102Read]{root:$root}\n  $demand=[fn:LS102Demand]{data:$data}\n  $ordered=sorted($data.quotes,\"item\")\n  $groups=[table:groupby]{items:$ordered,by:\"item\",agg:{n:[\"count\"]}}\n  $index=reduce($groups.items,{offset:0,pairs:[]},($a,$g)=>{offset:$a.offset+$g.n,pairs:$a.pairs+[[$g.item,$ordered[$a.offset:$a.offset+$g.n]]]})\n  $quotes=from_entries($index.pairs)\n  $policy=($qs)=>($qs >> [table:sort]{by:[\"cost\",\"delivery\",\"vendor\"]})[0]\n  $results=$data.policy.libraries >> [table:each]{return [fn:LS102LibraryProbe]{lib:$it,demand:$demand,quotes:$quotes,asof:$data.policy.as_of,policy:$policy,ledger:$ledger}}\n  return {libraries:$results,total_cost:sum(map($results,($r)=>$r.total_cost)),hold_count:sum(map($results,($r)=>len(filter($r.lines,($l)=>$l.status==\"hold\")))),sources:$data.sources}\n}"
}