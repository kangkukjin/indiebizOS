#!ibl edition=2
[def:수집]($폴더){
# 10회차 P1 v1 수집 (변형 A2: 3주차의 다른 형식을 변환) ·정규화·메모 유형화 — inputs: 폴더. 요청 budget {steps:600000,rows:60000}
# 반환: 학생, 출결(학번·일자·상태), 성적, 수납(금액수), 메모(유형), 기준, 파일상태, 오류행

[def:파일읽기]($경로,$이름) {
  [try] { $문 = [self:read]{path:$경로}
    return {파일:$이름,상태:"읽음",자료:$문.data,오류:null} }
  [catch] { return {파일:$이름,상태:"실패",자료:null,오류:$error.message} }
}
# CSV 한 파일: 필요한 열이 다 있는지 확인하고 행을 돌려준다. 열이 다르면 읽지 못한 것으로 보고한다.
[def:표읽기]($경로,$이름,$열들) {
  $f = [fn:파일읽기]{경로:$경로,이름:$이름}
  [if:$f.상태 != "읽음"] { return {파일:$이름,상태:"실패",행:[],오류:$f.오류} }
  $행 = $f.자료.items
  [if:len($행) == 0] { return {파일:$이름,상태:"읽음",행:[],오류:null} }
  $없는열 = $열들 >> [table:each]{mode:"flat_map"} { return has($행[0],$it) ? [] : [$it] }
  [if:len($없는열) > 0] { return {파일:$이름,상태:"형식 다름",행:[],오류:"없는 열: " + join(", ",$없는열) + " / 있는 열: " + join(", ",keys($행[0]))} }
  return {파일:$이름,상태:"읽음",행:$행,오류:null}
}

$학생f = [fn:표읽기]{경로:$폴더 + "/students.csv",이름:"students.csv",열들:["학번","이름","반","수강료","상태"]}
$학생 = $학생f.행 >> [table:compute]{set:($r)=>{수강료수:number($r.수강료)}}

$출결파일 = [self:list]{path:$폴더 + "/attendance",pattern:"week*.csv"} >> [table:sort]{by:"name"}
# 주별 파일은 두 형식이 있다: (학번,일자,상태) 또는 (date,student_id,mark — O/L/X). 둘 다 아니면 형식 다름으로 남긴다.
$표기 = {O:"출석",L:"지각",X:"결석"}
$출결읽기 = $출결파일 >> [table:each]{parallel:4} {
  $a = [fn:표읽기]{경로:$it.path,이름:$it.name,열들:["학번","일자","상태"]}
  [if:$a.상태 != "형식 다름"] { return $a }
  $b = [fn:표읽기]{경로:$it.path,이름:$it.name,열들:["date","student_id","mark"]}
  [if:$b.상태 != "읽음"] { return $a }
  $모름 = $b.행 >> [table:filter]{where:($r)=>not has($표기,$r.mark)}
  [if:len($모름) > 0] { return {파일:$it.name,상태:"형식 다름",행:[],오류:"알 수 없는 출결 표기 " + text(len($모름)) + "건(예: " + $모름[0].mark + ")"} }
  return {파일:$it.name,상태:"읽음",행:$b.행 >> [table:each]{ return {학번:$it.student_id,일자:$it.date,상태:get($표기,$it.mark)} },오류:"다른 형식(date,student_id,mark)을 변환해 읽음"}
}
$출결 = $출결읽기 >> [table:each]{mode:"flat_map"} { return $it.행 }

$성적f = [fn:파일읽기]{경로:$폴더 + "/scores.json",이름:"scores.json"}
$성적 = $성적f.상태 == "읽음" ? $성적f.자료.scores : []

$수납f = [fn:표읽기]{경로:$폴더 + "/payments.csv",이름:"payments.csv",열들:["학번","납부일","금액"]}
$수납오류 = []
$수납 = []
[try] { $수납 = $수납f.행 >> [table:compute]{set:($r)=>{금액수:number($r.금액)}} }
[catch] {
  $느 = $수납f.행 >> [table:each] {
    [try] { return {**$it,금액수:number($it.금액),금액오류:null} }
    [catch] { return {**$it,금액수:null,금액오류:$error.message} }
  }
  $수납 = $느
  $수납오류 = $느 >> [table:filter]{where:($r)=>$r.금액오류 != null}
}

$메모f = [fn:표읽기]{경로:$폴더 + "/notes.csv",이름:"notes.csv",열들:["학번","일자","메모"]}
$문장 = ($메모f.행 >> [table:dedup]{by:"메모"}).items >> [table:select]{columns:["메모"]}
$판정 = $문장 >> [table:judge]{instruction:"학원 학부모 상담 메모를 가장 알맞은 유형 하나로 나눈다.",type:"choice",criteria:{"조치 필요":"불만·문제 제기·처리 요청처럼 학원이 확인하고 조치해야 하는 내용","문의":"일정·범위·비용 등 정보를 묻는 질문","감사·칭찬":"고마움이나 긍정적 평가","단순 전달":"결석·연락처 변경 같은 사실 통보"}}
$유형표 = $판정.items >> [table:each] { return {메모:$it.메모,유형:$it.judgment_result_value == null ? "확인 필요" : $it.judgment_result_value,확신:$it.judgment_result_confidence} }
$메모 = [table:join]{left:$메모f.행,right:$유형표,on:"메모",how:"left",defaults:{유형:"확인 필요",확신:null}}

$기준f = [fn:파일읽기]{경로:$폴더 + "/policy.json",이름:"policy.json"}
$출결상태 = $출결읽기 >> [table:each] { return {파일:$it.파일,상태:$it.상태,행수:len($it.행),오류:$it.오류} }
$파일상태 = [{파일:"students.csv",상태:$학생f.상태,행수:len($학생),오류:$학생f.오류}] + $출결상태 + [
  {파일:"scores.json",상태:$성적f.상태,행수:len($성적),오류:$성적f.오류},
  {파일:"payments.csv",상태:$수납f.상태,행수:len($수납),오류:$수납f.오류},
  {파일:"notes.csv",상태:$메모f.상태,행수:len($메모f.행),오류:$메모f.오류},
  {파일:"policy.json",상태:$기준f.상태,행수:0,오류:$기준f.오류}]
return {학생:$학생,출결:$출결,성적:$성적,수납:$수납,메모:$메모.items,유형표:$유형표,기준:$기준f.자료,파일상태:$파일상태,오류행:$수납오류}

}
[def:분석]($자료){
# 10회차 P2 v1 분석 (v0: sort by 목록 미지원 TYPE → 합성 키 / 하락 필터 뒤 cur 의 null 좁힘 없음 TYPE → prev-하락) — inputs: 자료={$ref P1}. 요청 budget {steps:900000,rows:90000}
$학생 = $자료.학생
$출결 = $자료.출결
$기준 = $자료.기준
$재원 = $학생 >> [table:filter]{where:($s)=>$s.상태 == "재원"}
$퇴원 = $학생 >> [table:filter]{where:($s)=>$s.상태 == "퇴원"}
$학생반 = $학생 >> [table:select]{columns:["학번","이름","반","수강료수","상태"]}

# 읽기 문제
$파일문제 = $자료.파일상태 >> [table:filter]{where:($f)=>$f.상태 != "읽음"} >> [table:each] { return {종류:"파일 읽지 못함",대상:$it.파일,근거:$it.상태 + " — " + get($it,"오류","")} }
$출결완전 = len($자료.파일상태 >> [table:filter]{where:($f)=>$f.상태 != "읽음" and contains($f.파일,"week")}) == 0
$출결단서 = $출결완전 ? null : "출결 파일 일부를 읽지 못해 출석률·연속 결석은 읽은 주만으로 계산"
$줄문제 = $자료.오류행 >> [table:each] { return {종류:"해석 못 한 줄",대상:$it.학번,근거:"금액 원문 '" + $it.금액 + "'"} }

# 출석률(지각은 출석) — 재원생
$출결수 = $출결 >> [table:compute]{set:($r)=>{온:$r.상태 == "결석" ? 0 : 1}}
$학생출결 = ($출결수 >> [table:groupby]{by:"학번",agg:{수업:["count"],출석:["sum","온"]}}).items
$재원출결 = ([table:join]{left:$학생출결,right:$학생반,on:"학번",how:"inner"}).items >> [table:filter]{where:($r)=>$r.상태 == "재원"}
$미달 = $재원출결 >> [table:filter]{where:($r)=>$r.출석 / $r.수업 < $기준.출석률_기준} >> [table:sort]{by:"학번"}
$미달이상 = $미달 >> [table:each] { return {종류:"출석률 미달",대상:$it.학번,반:$it.반,단서:$출결단서,근거:$it.이름 + " 출석 " + text($it.출석) + "/" + text($it.수업) + " (" + text(round(100 * $it.출석 / $it.수업, 1)) + "%)"} }

# 연속 결석 — 학번·일자 순으로 한 번 훑으며 학생별 연속 결석 길이를 센다
$순서 = $출결 >> [table:compute]{set:($r)=>{순서키:$r.학번 + "|" + $r.일자}} >> [table:sort]{by:"순서키"}
$n = $기준.연속결석_기준
$훑기 = reduce($순서, {cur:"",run:0,hit:[]}, ($a,$r)=>{
  cur:$r.학번,
  run:$r.상태 == "결석" ? ($r.학번 == $a.cur ? $a.run + 1 : 1) : 0,
  hit:($r.상태 == "결석" and ($r.학번 == $a.cur ? $a.run + 1 : 1) == $n) ? $a.hit + [$r.학번] : $a.hit})
$연속명단 = unique($훑기.hit)
$재원번호 = $재원 >> [table:each] { return $it.학번 }
$연속이상 = $연속명단 >> [table:each]{mode:"flat_map"} { return $it in $재원번호 ? [{종류:"연속 결석",대상:$it,단서:$출결단서,근거:text($n) + "회 이상 연속 결석"}] : [] }

# 퇴원생 출석
$퇴원출석 = ([table:join]{left:$학생출결,right:$퇴원 >> [table:select]{columns:["학번","이름","반"]},on:"학번",how:"inner"}).items >> [table:sort]{by:"학번"}
$퇴원이상 = $퇴원출석 >> [table:each] { return {종류:"퇴원생 출석",대상:$it.학번,반:$it.반,근거:$it.이름 + " 퇴원 상태인데 출결 기록 " + text($it.수업) + "건"} }

# 성적
$성적 = $자료.성적 >> [table:compute]{set:($e)=>{학번:$e.id,하락:$e.cur == null ? null : $e.prev - $e.cur}}
$하락 = $성적 >> [table:filter]{where:($e)=>$e.하락 != null and $e.하락 >= $기준.성적하락_기준} >> [table:sort]{by:"학번"}
$하락이상 = $하락 >> [table:each] { return {종류:"성적 하락",대상:$it.학번,근거:text($it.prev) + "점 → " + text($it.prev - $it.하락) + "점 (" + text($it.하락) + "점 하락)"} }
$미응시 = $성적 >> [table:filter]{where:($e)=>$e.cur == null} >> [table:sort]{by:"학번"}
$미응시이상 = $미응시 >> [table:each] { return {종류:"미응시",대상:$it.학번,근거:"이번 달 월말평가 점수 없음(지난달 " + text($it.prev) + "점)"} }

# 수납
$납부 = ($자료.수납 >> [table:groupby]{by:"학번",agg:{건수:["count"],합계:["sum","금액수"]}}).items
$미납 = ([table:join]{left:$재원,right:$납부,on:"학번",how:"anti"}).items >> [table:sort]{by:"학번"}
$미납이상 = $미납 >> [table:each] { return {종류:"미납",대상:$it.학번,반:$it.반,근거:$it.이름 + " 이번 달 납부 없음(수강료 " + text($it.수강료수) + "원)"} }
$납부학생 = ([table:join]{left:$납부,right:$학생반,on:"학번",how:"left",defaults:{이름:"(명단에 없음)",반:"",수강료수:null,상태:""}}).items >> [table:sort]{by:"학번"}
$중복이상 = $납부학생 >> [table:filter]{where:($p)=>$p.건수 > 1} >> [table:each] { return {종류:"중복 납부",대상:$it.학번,반:$it.반,근거:$it.이름 + " " + text($it.건수) + "회 납부 합계 " + text($it.합계) + "원"} }
$부족이상 = $납부학생 >> [table:filter]{where:($p)=>$p.건수 == 1 and $p.수강료수 != null and $p.합계 < $p.수강료수} >> [table:each] { return {종류:"금액 부족",대상:$it.학번,반:$it.반,근거:$it.이름 + " " + text($it.합계) + "원 납부(수강료 " + text($it.수강료수) + "원)"} }

# 반별 표
$반출결 = ($재원출결 >> [table:groupby]{by:"반",agg:{학생수:["count"],출석:["sum","출석"],수업:["sum","수업"]}}).items
$성적반 = ([table:join]{left:$성적,right:$학생반,on:"학번",how:"inner"}).items >> [table:filter]{where:($e)=>$e.상태 == "재원"}
$반성적 = ($성적반 >> [table:groupby]{by:"반",agg:{평균점수:["avg","cur"]}}).items
$반표 = ([table:join]{left:$반출결,right:$반성적,on:"반",how:"left",defaults:{평균점수:null}}).items >> [table:sort]{by:"반"} >> [table:each] { return {반:$it.반,학생수:$it.학생수,출석률:round(100 * $it.출석 / $it.수업, 1),평균점수:$it.평균점수 == null ? null : round($it.평균점수, 1)} }

# 메모
$유형별 = ($자료.메모 >> [table:groupby]{by:"유형",agg:{건수:["count"]}}).items >> [table:sort]{by:"건수",descending:true}
$조치 = $자료.메모 >> [table:filter]{where:($m)=>$m.유형 == "조치 필요" or $m.유형 == "확인 필요"} >> [table:sort]{by:"일자"}

$문제 = $파일문제 + $줄문제 + $미달이상 + $연속이상 + $하락이상 + $미응시이상 + $미납이상 + $중복이상 + $부족이상 + $퇴원이상
$종류별 = ($문제 >> [table:groupby]{by:"종류",agg:{건수:["count"]}}).items
return {문제:$문제,종류별:$종류별,반표:$반표,유형별:$유형별,조치메모:$조치,유형표:$자료.유형표,파일상태:$자료.파일상태,출결단서:$출결단서,
        재원수:len($재원),퇴원수:len($퇴원),출결행수:len($출결),수납합계:sum($납부 >> [table:each]{ return $it.합계 })}

}
$자료=[fn:수집]{폴더:$폴더}
$분석=[fn:분석]{자료:$자료}
[self:write]{path:"~turn/조판.py",content:$본문}
$조판=[self:script]{path:"~turn/조판.py",args:{분석:$분석,금액표시:format_number($분석.수납합계,",.0f"),태그:map(filter(split($태그,","),($t)=>len(strip($t))>0),($t)=>strip($t))}}
$문서=[self:write]{path:$출력+"/report.md",content:$조판.markdown}
$자료=[self:write]{path:$출력+"/issues.json",content:$조판.issues_json}
$문서확인=[self:read]{path:$문서.path,format:"text"}
$자료확인=[self:read]{path:$자료.path,format:"json"}
return {문서:$문서.path,자료:$자료.path,문서같음:$문서확인.text==$조판.markdown,자료같음:$자료확인.data==$분석,문제수:len($분석.문제),분류건수:sum(map($분석.유형별,($t)=>$t.건수))}
