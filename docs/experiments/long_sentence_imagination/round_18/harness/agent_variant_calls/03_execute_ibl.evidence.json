{"masked_paths": [], "text": "{\"code\": \"#!ibl edition=2\\n$excluded = map($prior.base.excluded,($r)=>$r.project)\\n$numeric = $prior.delays.items >> [table:compute]{set:($r)=>{extra_days:number($r.extra_days)}}\\n$totals = $numeric >> [table:groupby]{by:\\\"task\\\",agg:{extra_days:[\\\"sum\\\",\\\"extra_days\\\"]}}\\n$lookup = $context.prepared.tasks >> [table:compute]{set:($r)=>{task:$r.id}} >> [table:select]{columns:[\\\"task\\\",\\\"project\\\"]}\\n$joined = [table:join]{left:$totals.items,right:$lookup,on:\\\"task\\\",how:\\\"left\\\",defaults:{project:\\\"\\\"}}\\n$classified = $joined.items >> [table:compute]{set:($r)=>{reason:$r.project==\\\"\\\" ? \\\"unknown_task\\\" : $r.project in $excluded ? \\\"excluded_project\\\" : \\\"applied\\\"}}\\n$applied = $classified >> [table:filter]{where:($r)=>$r.reason==\\\"applied\\\"} >> [table:select]{columns:[\\\"task\\\",\\\"extra_days\\\",\\\"project\\\"]} >> [table:sort]{by:\\\"task\\\"}\\n$not = $classified >> [table:filter]{where:($r)=>$r.reason!=\\\"applied\\\"} >> [table:select]{columns:[\\\"task\\\",\\\"reason\\\"]} >> [table:sort]{by:\\\"task\\\"}\\n$all = $applied >> [table:compute]{set:($r)=>{id:$r.task}} >> [table:select]{columns:[\\\"id\\\",\\\"extra_days\\\"]}\\n$updated = [table:join]{left:$context.prepared.tasks,right:$all,on:\\\"id\\\",how:\\\"left\\\",defaults:{extra_days:0}}\\n$new = $updated.items >> [table:compute]{set:($r)=>{new_days:$r.project in $excluded ? $r.days : $r.days+$r.extra_days}}\\n$payload = {source:$context.prepared,base:$prior.base,tasks:$new,applied:$applied,not_applied:$not,delays:$prior.delays.items}\\n$file = [self:write]{path:$out+\\\"/prepared.json\\\",content:json($payload)}\\nreturn {file:$file,delay_rows:len($numeric),distinct_delayed:len($classified),applied_tasks:len($applied),not_applied:$not,baseline_tasks:len($prior.base.tasks),baseline_exclusions_match:$prior.base.excluded==$context.graph.excluded}\", \"inputs\": {\"out\": \"/Users/kangkukjin/Desktop/AI/indiebizOS/outputs/long_sentence_imagination/2026-10-05_18회차/agent/variant\", \"prior\": {\"$ref\": \"d1694b3ec09678206d3a840cffdca99a07b68db77c6eb1c4e72d429ad2aa9bf1\"}, \"context\": {\"$ref\": \"5ec559ce199e57b9ef5db5869eb002115c8273575263e9b152dad693c61cca0b\"}}, \"budget\": {\"steps\": 1000000, \"rows\": 100000}, \"check\": true}", "version": 1}