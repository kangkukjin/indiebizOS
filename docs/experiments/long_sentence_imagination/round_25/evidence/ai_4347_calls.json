      "code": "#!ibl edition=2\n$writes=[self:write]{path:f\"${out}/details.json\",content:json($result.details)} & [self:write]{path:f\"${out}/details.csv\",content:$result.details,format:\"csv\",columns:$result.columns} & [self:write]{path:f\"${out}/summary.json\",content:json($result.summary)};\n$back=[self:read]{path:f\"${out}/details.json\"} & [self:read]{path:f\"${out}/details.csv\"} & [self:read]{path:f\"${out}/summary.json\"};\nassert $back[0].data.items==$result.details,\"JSON 전건 불일치\";\nassert $back[2].data==$result.summary,\"요약 재읽기 불일치\";\nassert $back[1].data.table.columns==$result.columns,\"CSV 필드 순서 불일치\";\n$csv=map($back[1].data.items,($r)=>{order_id:$r.order_id,line_no:$r.line_no,region:$r.region,sku:$r.sku,qty:number($r.qty),returned_qty:number($r.returned_qty),unit_price:$r.unit_price==\"\" ? null : number($r.unit_price),net_qty:number($r.net_qty),amount:$r.amount==\"\" ? null : number($r.amount),status:$r.status,eligible:lower($r.eligible)==\"true\",note:$r.note,vendor_order_id:$r.vendor_order_id==\"\" ? null : $r.vendor_order_id});\nassert $csv==$result.details,\"CSV 전건 값·note 불일치\";\nassert all(map($back[1].data.items,($r)=>lower($r.eligible) in [\"true\",\"false\"])),\"CSV 불리언 불일치\";\nassert all(map($back[0].data.items,($r)=>keys($r)==$result.columns and $r.eligible==($r.status==\"ok\" and $r.amount>=50000))),\"정책 또는 JSON 필드 순서 불일치\";\n$regional_checks=$back[2].data.regions >> [table:each]{ $g=$it; $rows=filter($back[0].data.items,($r)=>$r.region==$g.region); $ok=filter($rows,($r)=>$r.status==\"ok\"); assert $g.lines==len($rows) and $g.amount==sum(map($ok,($r)=>$r.amount)) and $g.anomalies==len($rows)-len($ok) and $g.eligible==len(filter($rows,($r)=>$r.eligible)),\"재읽기 지역 집계 불일치\"; return true };\nassert $back[2].data.threshold==50000 and $back[2].data.count==len($csv) and $back[2].data.eligible==len(filter($csv,($r)=>$r.eligible)),\"재읽기 전체 집계 불일치\";\nreturn {verified:true,checked_rows:len($csv),checked_regions:len($regional_checks),max_normal_amount:max(map(filter($csv,($r)=>$r.status==\"ok\"),($r)=>$r.amount)),changes:$result.verified,summary:$back[2].data,files:$writes}",
