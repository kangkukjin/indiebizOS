      "code": "#!ibl edition=2\n$old=$current.details.items;\nassert $old==$previous.details and $current.summary==$previous.summary,\"main과 직전 검증 결과 불일치\";\n$columns=keys($old[0]);\n$new=$old >> [table:compute]{set:($r)=>{eligible:$r.status==\"ok\" and $r.amount>=50000}};\n$checks=enumerate($new) >> [table:each]{ $n=$it[0]; $r=$it[1]; assert {**$r,eligible:$old[$n].eligible}==$old[$n],\"eligible 외 필드 변경\"; assert keys($r)==$columns,\"필드 순서 변경\"; return true };\n$prepared=$new >> [table:compute]{set:($r)=>{anomaly_count:$r.status==\"ok\" ? 0 : 1,eligible_count:$r.eligible ? 1 : 0,normal_amount:$r.status==\"ok\" ? $r.amount : 0}};\n$groups=$prepared >> [table:groupby]{by:\"region\",agg:{lines:[\"count\"],amount:[\"sum\",\"normal_amount\"],anomalies:[\"sum\",\"anomaly_count\"],eligible:[\"sum\",\"eligible_count\"]}};\n$regions=$groups.items;\n$unchanged=$regions >> [table:select]{columns:[\"region\",\"lines\",\"amount\",\"anomalies\"]};\n$oldgroups=$current.summary.regions >> [table:select]{columns:[\"region\",\"lines\",\"amount\",\"anomalies\"]};\nassert $unchanged==$oldgroups,\"기존 지역 집계 불일치\";\n$summary={**$current.summary,regions:$regions,threshold:50000,eligible:sum(map($regions,($r)=>$r.eligible))};\nassert $summary.count==len($new) and $summary.total_amount==sum(map($regions,($r)=>$r.amount)) and $summary.anomalies==sum(map($regions,($r)=>$r.anomalies)),\"전체 집계 불일치\";\nreturn {details:$new,summary:$summary,columns:$columns,verified:{rows:len($checks),unchanged_except_eligible:true,notes_source_verified_by_prior_run:true,previous_eligible:$current.summary.eligible,changed_eligible:$current.summary.eligible-$summary.eligible}}",
