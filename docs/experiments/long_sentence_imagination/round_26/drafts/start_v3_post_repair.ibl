#!ibl edition=2
[def:묶음시작]($묶음) {
  $job = [self:script]{op:"run", id:"시험", args:{files:$묶음.files}, background:true}
  return {name:$묶음.name, files:$묶음.files, task_ref:$job.task_ref}
}
[def:묶음요약]($접수,$초) {
  [try] {
    $r = [self:task]{op:"wait", ref:$접수.task_ref, timeout:$초}
    [if:$r.timed_out] { return {name:$접수.name, 상태:"진행 중", task_ref:$접수.task_ref, files:$접수.files} }
    $행 = $r.result.items
    $통과 = sum($행 >> [table:each]{return $it.passed})
    $나쁨 = sum($행 >> [table:each]{return $it.failed + $it.errors})
    $이름 = $행 >> [table:each]{mode:"flat_map"} { return $it.failures }
    [if:$나쁨 > 0 or $통과 == 0] { return {name:$접수.name, 상태:"오류", passed:$통과, 나쁨:$나쁨, failures:$이름, 파일별:$행, task_ref:$접수.task_ref, files:$접수.files} }
    return {name:$접수.name, 상태:"통과", passed:$통과, 나쁨:0, failures:$이름, 파일별:$행, task_ref:$접수.task_ref, files:$접수.files}
  }
  [catch] { return {name:$접수.name, 상태:"오류", 사유:$error.details.failure, state:$error.details.state, task_ref:$접수.task_ref, files:$접수.files} }
}
$접수 = $bundles >> [table:each] { [fn:묶음시작]{묶음:$it} }
$묶음들 = $접수 >> [table:each] { [fn:묶음요약]{접수:$it, 초:$first_wait} }
$진행 = len($묶음들 >> [table:filter]{where:($b)=>$b.상태 == "진행 중"})
$오류 = len($묶음들 >> [table:filter]{where:($b)=>$b.상태 == "오류"})
$판정 = "합격"
[if:$오류 > 0] { $판정 = "불합격" }
[if:$진행 > 0] { $판정 = "미확정" }
$보고 = {단계:"1차", 판정:$판정, 진행중:$진행, 오류묶음:$오류, 묶음:$묶음들}
$저장 = [self:write]{path:$out, content:json($보고)}
$재독 = [self:read]{path:$out}
return {보고:$보고, 재독일치:json($재독.data) == json($보고), 경로:$out}
