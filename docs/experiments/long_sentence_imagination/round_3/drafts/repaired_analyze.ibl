#!ibl edition=2
# 3회차 수리: analyze — 앞 단계 성공값을 inputs.자료의 $ref로 전달
[def:미터로]($값,$단위) {
  [try] { $수 = number(replace($값,",","")) } [catch] { return null }
  $배 = $단위 == "km" ? 1000 : $단위 == "mi" ? 1609.344 : $단위 == "ft" ? 0.3048 : 1
  return $수 * $배
}

[def:값묶기]($주장들) {
  $정렬 = sorted($주장들,"미터")
  return reduce($정렬,[],($묶음,$r)=>len($묶음) > 0 and abs($r.미터 - $묶음[-1].대표) <= $묶음[-1].대표 * 0.0001 ? $묶음[:-1] + [{대표:$묶음[-1].대표,근거:$묶음[-1].근거 + [$r]}] : $묶음 + [{대표:$r.미터,근거:[$r]}])
}

[def:주제정리]($주제,$읽음목록,$주장목록,$논쟁목록) {
  $내논쟁 = $논쟁목록 >> [table:filter]{where:($r)=>$r.주제 == $주제.주제}
  $원천들 = $읽음목록 >> [table:filter]{where:($r)=>$r.주제 == $주제.주제}
  $내주장 = $주장목록 >> [table:filter]{where:($r)=>$r.주제 == $주제.주제}
  $환산 = $내주장 >> [table:each] { return {**$it,미터:[fn:미터로]{값:$it.값,단위:$it.단위}} }
  $수치 = $환산 >> [table:filter]{where:($r)=>$r.미터 != null}
  $해석불가 = $환산 >> [table:filter]{where:($r)=>$r.미터 == null}
  $묶음 = [fn:값묶기]{주장들:$수치}
  $읽은것 = $원천들 >> [table:filter]{where:($r)=>$r.ok}
  return {주제:$주제.주제,질문:$주제.질문,
          원천수:len($읽은것),원천전체:len($원천들),
          묶음:$묶음,상충후보:len($묶음) > 1,해석불가:$해석불가,논쟁:$내논쟁}
}

$읽음=$자료.읽음

$추출=$자료.추출

$추출실패 = $추출 >> [table:filter]{where:($r)=>has($r,"추출실패")}

$주장 = $추출 >> [table:each]{mode:"flat_map"} { return $it.주장 }

$버림 = $추출 >> [table:each]{mode:"flat_map"} { return $it.버림 }

$논쟁 = $추출 >> [table:each]{mode:"flat_map"} { return $it.논쟁 }

$정리 = $주제 >> [table:each] { [fn:주제정리]{주제:$it,읽음목록:$읽음,주장목록:$주장,논쟁목록:$논쟁} }

$해설입력 = $정리 >> [table:each] {
  $t = $it
  return {주제:$t.주제,질문:$t.질문,논쟁:$t.논쟁 >> [table:select]{columns:["언어","논쟁"]},값목록:$t.묶음 >> [table:each] { return {미터:round($it.대표),근거:$it.근거 >> [table:select]{columns:["언어","값","단위","대상","측정"]}} }}
}

$해설 = $해설입력 >> [table:ai]{
  instruction:"각 주제의 값목록(서로 다른 값 묶음)을 보고 판정하라. 값이 하나면 '일치'. 여럿이면 대상·측정 설명을 근거로 '정의 차이'(재는 대상·범위가 다름)/'측정 시기 차이'/'진짜 불일치'/'혼합' 중 하나. 논쟁 목록이 있으면 해설에 반영하라. 해설은 2~4문장, 주어진 값만 인용하고 새 수치를 만들지 마라.",
  schema:"판정(일치|정의 차이|측정 시기 차이|진짜 불일치|혼합), 해설(문자열)",
  preserve_rows:true
}

return {정리:$정리,해설:$해설.items,읽음:$읽음,버림:$버림,추출실패:$추출실패,주장수:len($주장)}
