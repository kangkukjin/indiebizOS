#!ibl edition=2
[def:시작]($kit,$source,$out,$present) {
  $missing = difference($kit.files,$present)
  [if:len($missing)>0] {
    return {id:$kit.id,status:"blocked",archive:null,files:$kit.files,missing:$missing,verified_count:0,ticket:null}
  }
  $archive = f"${out}/${kit.id}.zip"
  $paths = map($kit.files,($p)=>f"${source}/${p}")
  $ticket = [self:script]{id:"압축",args:{op:"pack",paths:$paths,base:$source,output:$archive},background:true}
  return {id:$kit.id,status:"pending",archive:$archive,files:$kit.files,missing:[],verified_count:0,ticket:$ticket.task_ref}
}
[def:검증완료]($kit,$source,$out) {
  [if:$kit.status=="blocked"] { return $kit }
  $done = [self:task]{op:"wait",ref:$kit.ticket,timeout:30}
  assert $done.state=="succeeded", "압축 작업이 아직 완료되지 않음", {id:$kit.id,task_ref:$kit.ticket,state:$done.state}
  $listed = [self:script]{id:"압축",args:{op:"list",path:$kit.archive}}
  $names = map($listed.items,($r)=>$r.name)
  assert sorted($names)==sorted($kit.files), "압축 내부의 경로가 필요 목록과 다름", {id:$kit.id}
  assert len(unique($names))==len($names), "압축 내부에 중복 경로", {id:$kit.id}
  $restored = f"${out}/verify/${kit.id}"
  [self:script]{id:"압축",args:{op:"unpack",path:$kit.archive,out_dir:$restored}}
  $cmp = [self:script]{id:"python_libraries",args:{op:"call",target:"filecmp:cmpfiles",args:[$source,$restored,$names],kwargs:{shallow:false}}}
  $checked = [self:script]{id:"python_libraries",args:{op:"export",receiver:$cmp,format:"list"}}
  assert len($checked[0])==len($names) and len($checked[1])==0 and len($checked[2])==0, "원자료와 압축 복원 바이트 불일치", {id:$kit.id,checks:$checked}
  return {**$kit,status:"ready",verified_count:len($checked[0])}
}
[def:인계]($kits,$title,$order,$out) {
  $ordered = $order >> [table:each] {
    $id=$it
    return filter($kits,($k)=>$k.id==$id)[0]
  }
  $lines = $ordered >> [table:each] {
    $path=$it.archive==null ? "없음" : $it.archive
    return f"|${it.id}|${it.status}|${len($it.files)}|${it.verified_count}|${join(', ',$it.missing)}|${path}|"
  }
  $result={title:$title,kits:$ordered}
  $report=f"# ${title}\n\n|반|상태|필요 수|검증 수|누락|ZIP 경로|\n|---|---|---:|---:|---|---|\n${join('\n',$lines)}\n"
  [self:write]{path:f"${out}/result.json",content:json($result)} & [self:write]{path:f"${out}/report.md",content:$report}
  $saved=[self:read]{path:f"${out}/result.json"} & [self:read]{path:f"${out}/report.md"}
  assert $saved[0].data==$result, "인계 데이터 재독 불일치"
  assert $saved[1].text==$report, "인계서 재독 불일치"
  return $result
}
$catalog=[self:read]{path:f"${source}/catalog.json"}
$present=[self:script]{id:"python_libraries",args:{op:"call",target:"glob:glob",args:["**/*.txt"],kwargs:{root_dir:$source,recursive:true}}}
$tickets=$catalog.data.kits >> [table:each]{parallel:3} { return [fn:시작]{kit:$it,source:$source,out:$out,present:$present} }
$kits=$tickets >> [table:each] { return [fn:검증완료]{kit:$it,source:$source,out:$out} }
return [fn:인계]{kits:$kits,title:$title,order:$order,out:$out}
