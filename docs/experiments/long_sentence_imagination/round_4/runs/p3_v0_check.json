 "request": {
  "code": "#!ibl edition=2\n# 4회차 P3 렌더 — P2 결과($ref)를 PEP 로 묶어 공부 노트를 쓴다 (최초 초안)\n# inputs: 추출 = {\"$ref\": P2 result_ref.id}, 출력\n# 모델 호출 없음 — 계산·표현만\n\n$분류목록 = [\"언어 문법\",\"인터프리터·성능\",\"표준 라이브러리\",\"제거·비권장\"]\n\n# 한 버전의 추출 행을 PEP 하나당 한 항목으로 묶는다. 모델 분류·상태가 행마다 다르면 표시한다.\n[def:PEP묶기]($행) {\n  $번호들 = unique($행 >> [table:each] { return $it.pep })\n  $번호들 >> [table:each] {\n    $n = $it\n    $같은 = $행 >> [table:filter]{where:($r)=>$r.pep == $n}\n    $분류들 = unique($같은 >> [table:each] { return $it.분류 })\n    $상태들 = unique($같은 >> [table:each] { return $it.상태 })\n    return {pep:$n,제목:$같은[0].제목,분류:$같은[0].분류,상태:$같은[0].상태,\n            문단:unique($같은 >> [table:each] { return $it.문단 }),\n            분류불일치:len($분류들) > 1,상태불일치:len($상태들) > 1,분류들:$분류들,상태들:$상태들}\n  }\n}\n\n[def:항목줄]($h,$버전) {\n  $근거 = join(\", \",$h.문단 >> [table:each] { return f\"¶${$it}\" })\n  $주의 = ($h.분류불일치 or $h.상태불일치) ? f\" ⚠ 문단별 모델 판단이 다름(분류 ${join('/',$h.분류들)}, 상태 ${join('/',$h.상태들)})\" : \"\"\n  return f\"| ${$h.pep} | ${$h.제목} | ${$h.상태} | ${$버전} ${$근거} |${$주의}\"\n}\n\n[def:버전절]($버전,$항목) {\n  $절 = $분류목록 >> [table:each] {\n    $c = $it\n    $속한 = $항목 >> [table:filter]{where:($h)=>$h.분류 == $c}\n    [if:len($속한) == 0] { return f\"### ${$c}\\n- (해당 PEP 없음)\\n\" }\n    $줄 = $속한 >> [table:each] { [fn:항목줄]{h:$it,버전:$버전} }\n    return f\"### ${$c}\\n| PEP | 제목 | 상태 | 근거 |\\n| --- | --- | --- | --- |\\n${join('\\n',$줄)}\\n\"\n  }\n  return f\"## Python ${$버전} (PEP ${len($항목)}개)\\n\\n${join('\\n',$절)}\"\n}\n\n# ── 최상위 ──\n$버전별 = $추출.추출 >> [table:each] { return {버전:$it.버전,항목:[fn:PEP묶기]{행:$it.변경}} }\n$본절 = $버전별 >> [table:each] { [fn:버전절]{버전:$it.버전,항목:$it.항목} }\n\n# 두 버전에 걸친 PEP (앞 버전 → 뒤 버전 순서, 입력 버전 순)\n$걸침 = []\n[if:len($버전별) >= 2] {\n  $앞 = $버전별[0]\n  $뒤 = $버전별[1]\n  $앞번호 = $앞.항목 >> [table:each] { return $it.pep }\n  $뒤번호 = $뒤.항목 >> [table:each] { return $it.pep }\n  $공통 = intersection($앞번호,$뒤번호)\n  $걸침 = $공통 >> [table:each] {\n    $n = $it\n    $a = ($앞.항목 >> [table:filter]{where:($h)=>$h.pep == $n})[0]\n    $b = ($뒤.항목 >> [table:filter]{where:($h)=>$h.pep == $n})[0]\n    return f\"- **${$n}** ${$a.제목}: ${$앞.버전} ${$a.상태} → ${$뒤.버전} ${$b.상태} (근거 ${$앞.버전} ¶${join(',',$a.문단)} / ${$뒤.버전} ¶${join(',',$b.문단)})\"\n  }\n}\n\n$m1 = $추출.원천 >> [table:each]{mode:\"flat_map\"} {\n  [if:not $it.ok] { return [f\"- 찾지 못함/읽지 못함: Python ${$it.버전} — ${$it.이유}\"] }\n  [if:$it.생략 > 0] { return [f\"- 문단 생략: Python ${$it.버전} PEP 문단 ${$it.적중}개 중 ${$it.생략}개 생략\"] }\n  return []\n}\n$m2 = $추출.추출 >> [table:each]{mode:\"flat_map\"} {\n  $e = $it\n  $f = $e.실패 >> [table:each] { return f\"- 모델 추출 실패: Python ${$e.버전} 덩이 ${$it.덩이} — ${$it.이유}\" }\n  $b = $e.버림 >> [table:each] { return f\"- 원문에 없는 PEP 라서 버림: Python ${$e.버전} ¶${$it.문단} ${$it.pep}\" }\n  return $f + $b\n}\n$미확인 = $m1 + $m2 + [\"- PEP 번호가 없는 변경(예: 새 대화형 인터프리터)은 이 노트의 추출 대상이 아님\"]\n$원천줄 = $추출.원천 >> [table:each] { return f\"- Python ${$it.버전}: ${$it.ok ? $it.url : '없음'} (${$it.찾은경로 == null ? '검색 실패' : $it.찾은경로}, PEP 문단 ${$it.문단수}개)\" }\n\n$본문 = f\"# Python ${join(' · ',$버전별 >> [table:each] { return $it.버전 })} 변경점 공부 노트\\n\\n${join('\\n',$본절)}\\n## 두 버전에 걸친 변화\\n${len($걸침) == 0 ? '- 없음' : join('\\n',$걸침)}\\n\\n## 확인 못 한 부분\\n${join('\\n',$미확인)}\\n\\n## 원천\\n검색어: ${join(' / ',$추출.검색어)}\\n${join('\\n',$원천줄)}\\n\"\n$저장 = [self:write]{path:$출력,content:$본문}\n$확인 = [self:read]{path:$출력}\nreturn {저장일치:$확인.text == $본문,버전:$버전별 >> [table:each] { return {버전:$it.버전,pep수:len($it.항목)} },걸침:$걸침}\n",
  "edition": 2,
  "project_id": "컨텐츠",
