#!ibl edition=2
# 40회차 최초 초안 — 월말 경영 점검. inputs: src(자료 폴더), out(출력 폴더), asof("2026-09-30"), min_cash(선택, null=targets), drop_contract({id,from} 또는 null)

# ---- 순수 계산 ----
[def:버킷]($days) {
  return $days <= 0 ? "기한내" : $days <= 30 ? "1-30" : $days <= 60 ? "31-60" : $days <= 90 ? "61-90" : "90+"
}
[def:거래처찾기]($name,$clients) {
  $hit = filter($clients,($c)=>$name in $c.bank_names)
  return len($hit) == 0 ? null : $hit[0].id
}
# 입금 하나를 미결 청구에 충당: 상태 {balance:{청구id:잔액}, matches:[], unmatched:[], advances:{cid:금액}}
[def:입금충당]($st,$dep,$clients,$invoices) {
  $cid = [fn:거래처찾기]{name:$dep.counterparty,clients:$clients}
  [if:$cid == null] {
    return {**$st,unmatched:$st.unmatched + [{date:$dep.date,amount:$dep.amount,counterparty:$dep.counterparty}]}
  }
  $opens = sorted(filter($invoices,($r)=>$r.client_id == $cid and get($st.balance,$r.id,0) > 0 and $r.issued <= $dep.date),($r)=>f"${r.due}|${r.id}")
  $exact = filter($opens,($r)=>get($st.balance,$r.id,0) == $dep.amount)
  [if:len($exact) > 0] {
    $id = $exact[0].id
    return {**$st,balance:[fn:잔액갱신]{bal:$st.balance,id:$id,new:0},matches:$st.matches + [{deposit_date:$dep.date,invoice:$id,applied:$dep.amount}]}
  }
  return [fn:차례충당]{st:$st,opens:$opens,remaining:$dep.amount,cid:$cid,date:$dep.date}
}
[def:차례충당]($st,$opens,$remaining,$cid,$date) {
  $r = reduce($opens,{balance:$st.balance,remaining:$remaining,matches:$st.matches},($acc,$inv)=>
    $acc.remaining <= 0 ? $acc
    : {balance:[fn:잔액갱신]{bal:$acc.balance,id:$inv.id,new:get($acc.balance,$inv.id,0) - min($acc.remaining,get($acc.balance,$inv.id,0))},
       remaining:$acc.remaining - min($acc.remaining,get($acc.balance,$inv.id,0)),
       matches:$acc.matches + [{deposit_date:$date,invoice:$inv.id,applied:min($acc.remaining,get($acc.balance,$inv.id,0))}]})
  $adv = $r.remaining > 0 ? [fn:더하기]{rec:$st.advances,key:$cid,amt:$r.remaining} : $st.advances
  return {**$st,balance:$r.balance,matches:$r.matches,advances:$adv}
}
[def:잔액갱신]($bal,$id,$new) {
  return from_entries(map(entries($bal),($e)=>[$e[0],$e[0] == $id ? $new : $e[1]]))
}
[def:더하기]($rec,$key,$amt) {
  [if:has($rec,$key)] { return from_entries(map(entries($rec),($e)=>[$e[0],$e[0] == $key ? $e[1] + $amt : $e[1]])) }
  return from_entries(entries($rec) + [[$key,$amt]])
}
[def:계약기한]($c,$asof) {
  $notice = number($c.notice_days)
  $deadline = date_add($c.renewal_date,0 - $notice)
  return {**$c,monthly_fee:number($c.monthly_fee),effective_fee_sep:number($c.effective_fee_sep),term_months:number($c.term_months),notice_days:$notice,
    notice_deadline:$deadline,action_within_30d:date_diff($c.renewal_date,$asof) <= 30,notice_deadline_passed:date_diff($deadline,$asof) < 0}
}

# ---- 읽기 ----
$bank = [self:read]{path:f"${src}/bank_2026-09.csv"}
$summary = [self:read]{path:f"${src}/bank_summary.json"}
$invoices_doc = [self:read]{path:f"${src}/invoices.json"}
$purchases_doc = [self:read]{path:f"${src}/purchases.json"}
$clients_doc = [self:read]{path:f"${src}/clients.json"}
$vendors_doc = [self:read]{path:f"${src}/vendors.json"}
$targets_doc = [self:read]{path:f"${src}/targets.json"}
$payroll = [self:read]{path:f"${src}/payroll_2026-09.xlsx",sheet:"급여"}
$insurance_doc = [self:read]{path:f"${src}/payroll_2026-09.xlsx",sheet:"4대보험"}
$memo_prev = [self:read]{path:f"${src}/memo_2026-08.md",format:"text"}
$contract_files = sorted([self:list]{path:f"${src}/contracts",pattern:"*.md"},"name")
$contract_docs = $contract_files >> [table:each] { $d = [self:read]{path:$it.path,format:"text"}; return {file:$it.name,text:$d.text} }

$rows = $bank.data.items >> [table:each] { return {date:$it.date,type:$it.type,amount:number($it.amount),counterparty:$it.counterparty,memo:$it.memo,balance:number($it.balance)} }
$invoices = $invoices_doc.data.items
$purchases = $purchases_doc.data.items
$clients = $clients_doc.data.items
$vendors = $vendors_doc.data.items
$targets = $targets_doc.data
$summ = $summary.data
$min_cash_eff = $min_cash == null ? $targets.min_cash_balance : $min_cash

# ---- (1) 입금 대사·aging ----
$deposits = sorted(filter($rows,($t)=>$t.type == "입금"),($t)=>f"${t.date}|${t.amount}")
$init_balance = from_entries(map($invoices,($r)=>[$r.id,$r.amount]))
$st0 = {balance:$init_balance,matches:[],unmatched:[],advances:{}}
$st = reduce($deposits,$st0,($acc,$dep)=>[fn:입금충당]{st:$acc,dep:$dep,clients:$clients,invoices:$invoices})
$open_rows = filter(map($invoices,($r)=>{invoice:$r.id,client_id:$r.client_id,due:$r.due,balance:get($st.balance,$r.id,0),bucket:[fn:버킷]{days:date_diff($asof,$r.due)}}),($r)=>$r.balance > 0)
$aging = $open_rows >> [table:groupby]{by:"bucket",agg:{total:["sum","balance"]}}
$per_client = ($open_rows >> [table:groupby]{by:"client_id",agg:{balance:["sum","balance"]}}).items >> [table:sort]{by:"balance",descending:true} >> [table:take]{n:5}
$open_total = sum(map($open_rows,($r)=>$r.balance))

# ---- (2) 출금 대사 ----
$payroll_rows = filter($payroll.data.table.rows,($r)=>$r[0] != "이름" and $r[0] != "합계")
$payroll_net = sum(map($payroll_rows,($r)=>number($r[5])))
$ins_rows = filter($insurance_doc.data.table.rows,($r)=>$r[0] != "이름" and $r[0] != "합계")
$insurance = sum(map($ins_rows,($r)=>number($r[5])))

# ---- (4) 계약 추출(AI) — 조건 변경 때 재사용 대상 ----
$extracted = $contract_docs >> [table:ai]{instruction:"각 계약서 원문에서 필드를 추출한다. 요금은 숫자(원, 쉼표 없이). 각주·인상 조항이 있으면 fee_change_note 에 원문을 옮기고 effective_fee_sep 에 2026년 9월에 실제 적용되는 월 요금을 계산해 적는다(조항이 없으면 monthly_fee 와 같음). 날짜는 YYYY-MM-DD.",
  schema:"id(계약 번호 예 K01), supplier(공급자), service(서비스), monthly_fee(숫자), effective_fee_sep(숫자), start(YYYY-MM-DD), term_months(숫자), auto_renew(불리언), notice_days(숫자), renewal_date(YYYY-MM-DD, 기간 만료일), fee_change_note(문자열 또는 null)",
  preserve_rows:true,fields:["file","id","supplier","service","monthly_fee","effective_fee_sep","start","term_months","auto_renew","notice_days","renewal_date","fee_change_note"]}
$contracts = $extracted.items >> [table:each] { return [fn:계약기한]{c:$it,asof:$asof} }
$fee_by_supplier = from_entries(map($contracts,($c)=>[$c.supplier,$c.effective_fee_sep]))

$withdrawals = filter($rows,($t)=>$t.type == "출금")
$vendor_names = from_entries(map($vendors,($v)=>[$v.name,$v.id]))
$sep_purchases = filter($purchases,($p)=>$p.date[:7] == "2026-09")
$wd_st = reduce($withdrawals,{used:[],explained:[],unexplained:[]},($acc,$t)=>
  [fn:출금분류]{acc:$acc,t:$t,sep_purchases:$sep_purchases,vendor_names:$vendor_names,payroll_net:$payroll_net,insurance:$insurance,fees:$fee_by_supplier})
[def:출금분류]($acc,$t,$sep_purchases,$vendor_names,$payroll_net,$insurance,$fees) {
  $cand = filter($sep_purchases,($p)=>$p.vendor == $t.counterparty and $p.amount == $t.amount and not ($p.id in $acc.used))
  [if:len($cand) > 0] { return {**$acc,used:$acc.used + [$cand[0].id],explained:$acc.explained + [{date:$t.date,amount:$t.amount,kind:"purchase",ref:$cand[0].id}]} }
  [if:$t.amount == $payroll_net and contains($t.memo,"급여")] { return {**$acc,explained:$acc.explained + [{date:$t.date,amount:$t.amount,kind:"payroll",ref:"급여"}]} }
  [if:$t.amount == $insurance] { return {**$acc,explained:$acc.explained + [{date:$t.date,amount:$t.amount,kind:"insurance",ref:"4대보험"}]} }
  [if:has($fees,$t.counterparty)] {
    $fee = get($fees,$t.counterparty)
    return {**$acc,explained:$acc.explained + [{date:$t.date,amount:$t.amount,kind:"contract",ref:$t.counterparty,contract_fee:$fee,mismatch:$t.amount != $fee}]}
  }
  return {**$acc,unexplained:$acc.unexplained + [{date:$t.date,amount:$t.amount,counterparty:$t.counterparty,memo:$t.memo}]}
}

# ---- (3) 잔고 검증·전망 ----
$dep_total = sum(map($deposits,($t)=>$t.amount))
$wd_total = sum(map($withdrawals,($t)=>$t.amount))
$csv_closing = $rows[-1].balance
$balance_check = {opening:$summ.opening_balance,csv_closing:$csv_closing,summary_closing:$summ.closing_balance,
  csv_deposit_count:len($deposits),summary_deposit_count:$summ.deposit_count,
  internal_ok:$summ.opening_balance + $dep_total - $wd_total == $csv_closing,
  matches_summary:$csv_closing == $summ.closing_balance and len($deposits) == $summ.deposit_count}
$sep_rev = sum(map(filter($invoices,($r)=>$r.issued[:7] == "2026-09"),($r)=>$r.amount))
$sep_pur = sum(map($sep_purchases,($p)=>$p.amount))
$performance = {revenue:$sep_rev,revenue_target:$targets.revenue_target,revenue_hit:$sep_rev >= $targets.revenue_target,purchases:$sep_pur,
  gross_margin:round(($sep_rev - $sep_pur) / $sep_rev,4),gross_margin_target:$targets.gross_margin_target}
$months = ["2026-10","2026-11","2026-12"]
$drop_id = $drop_contract == null ? "" : $drop_contract.id
$drop_from = $drop_contract == null ? "9999-99" : $drop_contract.from
$inflow = from_entries(map($months,($m)=>[$m,sum(map(filter($open_rows,($r)=>($r.due[:7] <= "2026-10" ? "2026-10" : $r.due[:7]) == $m),($r)=>$r.balance))]))
[def:월유출]($m,$contracts,$drop_id,$drop_from,$fixed) {
  $active = filter($contracts,($c)=>not ($c.id == $drop_id and $m >= $drop_from))
  return sum(map($active,($c)=>$c.effective_fee_sep)) + $fixed
}
$fixed = $payroll_net + $insurance + $sep_pur
$fc = reduce($months,{bal:$csv_closing,rows:[]},($acc,$m)=>
  {bal:$acc.bal + get($inflow,$m) - [fn:월유출]{m:$m,contracts:$contracts,drop_id:$drop_id,drop_from:$drop_from,fixed:$fixed},
   rows:$acc.rows + [{month:$m,inflow:get($inflow,$m),outflow:[fn:월유출]{m:$m,contracts:$contracts,drop_id:$drop_id,drop_from:$drop_from,fixed:$fixed},
     closing:$acc.bal + get($inflow,$m) - [fn:월유출]{m:$m,contracts:$contracts,drop_id:$drop_id,drop_from:$drop_from,fixed:$fixed},
     below_min:($acc.bal + get($inflow,$m) - [fn:월유출]{m:$m,contracts:$contracts,drop_id:$drop_id,drop_from:$drop_from,fixed:$fixed}) < $min_cash_eff}]})
$forecast = $fc.rows

# ---- (5) 메모 ----
$contract_actions = filter($contracts,($c)=>$c.action_within_30d or $c.notice_deadline_passed)
$fee_mismatch = filter($wd_st.explained,($e)=>$e.kind == "contract" and $e.mismatch)
$overdue_clients = filter($per_client,($c)=>$c.balance > 0)
$below = filter($forecast,($r)=>$r.below_min)
$c07 = filter($open_rows,($r)=>$r.client_id == "C07")
$c07_balance = sum(map($c07,($r)=>$r.balance))
$k04 = filter($fee_mismatch,($e)=>$e.ref == "오피스렌탈")
$top_text = join("\n",map($per_client,($c)=>f"- ${c.client_id}: ${c.balance}원"))
$unexpl_text = join("\n",map($wd_st.unexplained,($u)=>f"- ${u.date} ${u.counterparty} ${u.amount}원 (${u.memo})"))
$fc_flag = map($forecast,($r)=>{**$r,flag:$r.below_min ? " ⚠ 최소 잔고 미달" : ""})
$fc_text = join("\n",map($fc_flag,($r)=>f"- ${r.month}: 유입 ${r.inflow} / 유출 ${r.outflow} / 기말 ${r.closing}${r.flag}"))
$ct_flag = map($contract_actions,($c)=>{**$c,flag:$c.notice_deadline_passed ? " — 기한 지남(자동 갱신됨)" : " — 조치 필요"})
$ct_text = join("\n",map($ct_flag,($c)=>f"- ${c.id} ${c.supplier}(${c.service}): 만료 ${c.renewal_date}, 통보 기한 ${c.notice_deadline}${c.flag}"))
$mm_text = join("\n",map($fee_mismatch,($e)=>f"- ${e.ref}: 계약 ${e.contract_fee}원 vs 실제 청구 ${e.amount}원"))
$aging_text = join("\n",map($aging.items,($a)=>f"- ${a.bucket}: ${a.total}원"))
$unmatched_text = join("\n",map($st.unmatched,($u)=>f"- ${u.date} ${u.counterparty} ${u.amount}원"))
$adv_text = join("\n",map(entries($st.advances),($e)=>f"- ${e[0]}: ${e[1]}원"))
$rev = $performance.revenue
$rev_t = $performance.revenue_target
$gm = $performance.gross_margin
$gm_t = $performance.gross_margin_target
$closing = $balance_check.csv_closing
$bc_ok = $balance_check.matches_summary
$memo = f"""# 2026년 9월 경영 메모 (기준일 ${asof})

## 1. 목표 대비 실적
- 매출 ${rev}원 / 목표 ${rev_t}원 → ${performance.revenue_hit ? "달성" : "미달"}
- 매출총이익률 ${gm} / 목표 ${gm_t}
- 9월 말 잔고 ${closing}원 (은행 요약과 ${bc_ok ? "일치" : "불일치 — 원천 확인 필요"})

## 2. 미수금 (총 ${open_total}원)
${aging_text}
상위 거래처:
${top_text}
미확인 입금:
${unmatched_text}
선입금:
${adv_text}

## 3. 설명 안 되는 출금
${unexpl_text}

## 4. 현금 전망 (최소 잔고 ${min_cash_eff}원)
${fc_text}

## 5. 계약
조치 대상:
${ct_text}
단가 불일치:
${mm_text}

## 6. 지난달 결정의 이번 달 상태
- 동해수산(C07) 독촉: 9월 말 미수 잔액 ${c07_balance}원 ${c07_balance == 0 ? "— 전액 입금, 종결" : "— 미입금 지속, 거래 중단 검토 단계"}
- 복합기 임대(K04) 해지 검토: ${len(k04) > 0 ? "계약 단가와 실제 청구가 다름 — 재협상 또는 해지 진행" : "단가 불일치 없음 — 대안 견적 결과로 판단"}

## 7. 리스크 상위 3과 추천 조치
1. 현금: ${len(below) > 0 ? f"최소 잔고 미달 예상 월 ${len(below)}개 — 수금 독촉·지출 이연" : "3개월 내 최소 잔고 미달 없음"}
2. 미수: 상위 거래처 독촉(위 목록 순)
3. 계약: 통보 기한 지난 계약은 다음 만료 60일 전 알림 등록, 단가 불일치는 공급자에 소명 요청

## 8. 미확인·질문
- 미확인 입금 ${len(st.unmatched)}건의 송금인 확인
- 설명 안 되는 출금 ${len(wd_st.unexplained)}건의 증빙
- 계약 추출은 AI 가 읽은 값이므로 원문 대조 필요: ${len(contracts)}건
"""
[self:write]{path:f"${out}/reconciliation.json",content:json({aging:$aging.items,open_total:$open_total,top_clients:$per_client,unmatched_deposits:$st.unmatched,advances:$st.advances,open_invoices:$open_rows,applied_count:len($st.matches),explained:$wd_st.explained,unexplained:$wd_st.unexplained,balance_check:$balance_check,performance:$performance,payroll_net:$payroll_net,insurance:$insurance})}
[self:write]{path:f"${out}/forecast.json",content:json({min_cash:$min_cash_eff,drop_contract:$drop_contract,forecast:$forecast})}
[self:write]{path:f"${out}/contracts.json",content:json($contracts)}
[self:write]{path:f"${out}/memo.md",content:$memo}
return {balance_ok:$bc_ok,open_total:$open_total,unmatched:len($st.unmatched),unexplained:len($wd_st.unexplained),below_min_months:len($below),contract_actions:len($contract_actions),fee_mismatch:len($fee_mismatch),revenue_hit:$performance.revenue_hit}
