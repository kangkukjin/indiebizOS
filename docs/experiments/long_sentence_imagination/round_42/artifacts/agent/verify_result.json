  "cues": [
    {
      "n": 1,
      "start": 0.0,
      "end": 3.07,
      "text": "버리기 전에, 함께 고쳐요."
    },
    {
      "n": 2,
      "start": 2.87,
      "end": 6.77,
      "text": "동네 수리교실에서 작은 수선을 시작합니다."
    },
    {
      "n": 3,
      "start": 6.77,
      "end": 11.4,
      "text": "떨어진 단추를 달고, 작은 구멍을 꿰매 봅니다."
    },
    {
      "n": 4,
      "start": 11.2,
      "end": 13.63,
      "text": "처음이어도 괜찮아요."
    },
    {
      "n": 5,
      "start": 13.63,
      "end": 18.25,
      "text": "깨끗한 옷 한 벌, 바느질 도구, 그리고 배우고 싶은 마음을"
    },
    {
      "n": 6,
      "start": 18.05,
      "end": 19.58,
      "text": "가져오세요."
    },
    {
      "n": 7,
      "start": 19.58,
      "end": 24.29,
      "text": "토요일 오후 두 시, 가상 마을회관에서 만나요."
    },
    {
      "n": 8,
      "start": 24.09,
      "end": 27.84,
      "text": "이 영상은 훈련용 가상 행사 안내입니다."
    }
  ],
