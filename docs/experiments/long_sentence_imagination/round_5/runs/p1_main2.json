  "code": "#!ibl edition=2\n# 5회차 P1 추출 — 영수증 PDF 전부 읽고 글자 있는 것만 모델로 구조화 (v1: 스캔본은 페이지 표지만·손상본은 빈 성공 → 표지 줄 제외·페이지 0 검사)\n# inputs: 폴더(receipts 폴더 절대경로)\n# 반환: {영수증:[{id,파일,상태,이유}], 추출:[{id,가맹점,날짜,합계,합계표기,원문확인,원문}]}\n\n[def:영수증읽기]($파일) {\n  $id = replace($파일.name,\".pdf\",\"\")\n  [try] {\n    $d = [self:read]{path:$파일.path}\n    [if:$d.data.total_pages == 0] { return {id:$id,파일:$파일.path,상태:\"읽기 실패\",이유:\"PDF 페이지 0 — 손상 추정(읽기 도구는 오류 없이 빈 본문 반환)\",원문:\"\"} }\n    $줄 = split($d.text,\"\\n\") >> [table:each]{mode:\"flat_map\"} {\n      [if:len(strip($it)) == 0 or contains($it,\"--- Page \")] { return [] }\n      return [$it]\n    }\n    [if:len($줄) == 0] { return {id:$id,파일:$파일.path,상태:\"글자 없음\",이유:\"PDF 에 글자 층이 없음(스캔 추정, 페이지 표지만 반환)\",원문:\"\"} }\n    return {id:$id,파일:$파일.path,상태:\"읽음\",이유:null,원문:$d.text}\n  } [catch] {\n    return {id:$id,파일:$파일.path,상태:\"읽기 실패\",이유:f\"${$error.code}: ${$error.message}\",원문:\"\"}\n  }\n}\n\n[def:금액]($표기) {\n  [try] { return number(replace(replace($표기,\",\",\"\"),\"원\",\"\")) } [catch] { return null }\n}\n\n# ── 최상위 ──\n$파일 = [self:list]{path:$폴더,pattern:\"*.pdf\"}\n$읽기 = $파일 >> [table:each]{parallel:6} { [fn:영수증읽기]{파일:$it} }\n$영수증 = sorted($읽기,\"id\")\n$읽음 = $영수증 >> [table:filter]{where:($r)=>$r.상태 == \"읽음\"}\n$추출 = $읽음 >> [table:ai]{\n  instruction:\"각 행의 원문은 영수증 한 장이다. 가맹점명(원문 첫 줄 표기 그대로), 거래 날짜(YYYY-MM-DD), 최종 합계 금액(원문 표기 그대로, 예 '24,500')을 적어라. 원문에 없으면 null.\",\n  schema:\"가맹점(문자열), 날짜(문자열), 합계(문자열)\",\n  input_fields:[\"id\",\"원문\"],\n  preserve_rows:true\n}\n$행 = $추출.items >> [table:each] {\n  $표기 = $it.합계 == null ? \"\" : $it.합계\n  $날 = $it.날짜 == null ? \"\" : $it.날짜\n  return {id:$it.id,가맹점:$it.가맹점,날짜:$it.날짜,합계:[fn:금액]{표기:$표기},합계표기:$it.합계,\n          원문확인:len($표기) > 0 and contains($it.원문,$표기) and len($날) > 0 and contains($it.원문,$날),원문:$it.원문}\n}\nreturn {영수증:$영수증 >> [table:select]{columns:[\"id\",\"파일\",\"상태\",\"이유\"]},추출:$행}\n",
