#!ibl edition=2
# 55회차 v3(수리 뒤 확인용: PubMed 를 다시 셋씩 함께 — 그 밖은 v2 와 같다) / v2(PubMed 를 한 번에 하나씩 — 셋을 함께 부르니 429 Too Many Requests 로 10건 중 7건 실패) / v1(검사 거절 수정: flat_map 은 내장 함수가 아니라 table:each 의 mode — 순수식에서는 reduce 로 이어 붙임) / v0 — 진료 전 준비철: 접수지 → 경과·약 목록(모델) → 측정 통계(코드) → 약 성분·주의 원문(의약품안전나라 e약은요) → 병원 갈 신호(건강정보포털) → 논문(PubMed) → 건별 메모·급한 순 요약
# inputs: src(자료 폴더: job.json, intake/*.md, measurements.csv), out(출력 폴더)

# ---- 부품: 측정 ----
# 측정 한 줄 → 수치(환산)·날짜·기준 초과. 숫자가 아니면 ok:false (지어내지 않는다)
[def:측정풀기]($r,$th,$consult) {
  $day = text($r.measured_at)[:10]
  $bad = {case_id:$r.case_id,kind:$r.kind,day:$day,a:0,b:0,ok:false,over:0,zone:""}
  [try] {
    $dd = date_diff($day,$consult)
    $zone = $dd >= 0 ? "after" : $dd >= -7 ? "recent" : "prior"
    $raw = strip(text($r.value))
    [if:$r.kind == "혈압"] {
      $p = split($raw,"/")
      [if:len($p) != 2] { return $bad }
      $s = number(strip($p[0]))
      $d = number(strip($p[1]))
      return {case_id:$r.case_id,kind:$r.kind,day:$day,a:$s,b:$d,ok:true,over:($s >= $th.혈압.sys or $d >= $th.혈압.dia) ? 1 : 0,zone:$zone}
    }
    $v0 = number($raw)
    $v = $r.unit == "mmol/L" ? $v0 * 18 : $r.unit == "℉" ? ($v0 - 32) * 5 / 9 : $v0
    $limit = get($th,$r.kind)
    return {case_id:$r.case_id,kind:$r.kind,day:$day,a:$v,b:0,ok:true,over:$v >= $limit ? 1 : 0,zone:$zone}
  } [catch] { return $bad }
}
[def:묶어평균]($rows) {
  [if:len($rows) == 0] { return [] }
  $g = $rows >> [table:groupby]{by:["case_id","kind"],agg:{n:["count","a"],ma:["avg","a"],mb:["avg","b"]}}
  return $g.items
}
[def:한건통계]($id,$all,$rec,$pri,$inv,$days) {
  $kinds = unique(map(filter($all,($g)=>$g.case_id == $id),($g)=>$g.kind) + map(filter($inv,($g)=>$g.case_id == $id),($g)=>$g.kind))
  $pairs = map($kinds,($k)=>[$k,[fn:종류통계]{id:$id,k:$k,all:$all,rec:$rec,pri:$pri,inv:$inv,days:$days}])
  return from_entries($pairs)
}
[def:종류통계]($id,$k,$all,$rec,$pri,$inv,$days) {
  $a = filter($all,($g)=>$g.case_id == $id and $g.kind == $k)
  $r = filter($rec,($g)=>$g.case_id == $id and $g.kind == $k)
  $p = filter($pri,($g)=>$g.case_id == $id and $g.kind == $k)
  $v = filter($inv,($g)=>$g.case_id == $id and $g.kind == $k)
  $o = filter($days,($g)=>$g.case_id == $id and $g.kind == $k and $g.o >= 1)
  $nbad = len($v) > 0 ? $v[0].n : 0
  [if:len($a) == 0] { return {n:0,invalid:$nbad} }
  $r7 = len($r) > 0 ? round($r[0].ma,1) : null
  $pr = len($p) > 0 ? round($p[0].ma,1) : null
  [if:$k == "혈압"] { return {n:$a[0].n,invalid:$nbad,mean_sys:round($a[0].ma,1),mean_dia:round($a[0].mb,1),recent7:$r7,prior:$pr,over_days:len($o)} }
  return {n:$a[0].n,invalid:$nbad,mean:round($a[0].ma,1),recent7:$r7,prior:$pr,over_days:len($o)}
}

# ---- 부품: 원천 ----
[def:접수지읽기]($f) {
  [try]{ $d = [self:read]{path:$f.path,format:"text"}; return {id:replace($f.name,".md",""),text:$d.text,read_ok:true} }
  [catch]{ return {id:replace($f.name,".md",""),text:"",read_ok:false} }
}
[def:성분정리]($s) {
  $a = strip(split($s,"(")[0])
  return strip(replace($a,"과립",""))
}
# 약 이름 하나 → e약은요 검색(제품명이 그 이름으로 시작하는 첫 품목) → 주성분 + 상세의 '사용 전에 반드시 알아야 할 내용' 원문
[def:약찾기]($name) {
  $none = {name:$name,found:false,product:"",item_seq:"",ingredients:[],warn:[],warn_from:"",url:"",reason:""}
  [try] {
    $u = f"https://nedrug.mfds.go.kr/searchEasyDrug?itemName=${name}"
    $c = [sense:crawl]{url:$u,max_length:200000}
    $n = len($name)
    $prod = filter($c.items,($x)=>$x.text[:4] == "제품명 " and strip($x.text[4:])[:$n] == $name)
    [if:len($prod) == 0] { return {**$none,reason:"e약은요 검색에 그 이름으로 시작하는 제품이 없음(일반의약품 개요 정보만 있는 원천 — 처방약이거나 없는 이름일 수 있음)"} }
    $product = strip($prod[0].text[4:])
    $after = filter($c.items,($x)=>$x.paragraph_index > $prod[0].paragraph_index and $x.text[:3] == "주성분")
    $ings = len($after) == 0 ? [] : map(filter(split($after[0].text[3:],","),($g)=>len(strip($g)) > 0),($g)=>[fn:성분정리]{s:$g})
    $l = [sense:crawl]{url:$u,op:"links"}
    $hit = filter($l.items,($x)=>strip($x.text) == $product and contains($x.href,"getItemDetail?itemSeq="))
    [if:len($hit) == 0] { return {**$none,found:true,product:$product,ingredients:$ings,reason:"상세 주소를 찾지 못함"} }
    $seq = split($hit[0].href,"itemSeq=")[1]
    $d = [sense:crawl]{url:$hit[0].url,max_length:200000}
    $s = filter($d.items,($x)=>contains($x.text,"반드시 알아야 할 내용은 무엇입니까"))
    $e = filter($d.items,($x)=>contains($x.text,"사용상 주의사항은 무엇입니까"))
    $e2 = filter($d.items,($x)=>contains($x.text,"주의해야 할 약 또는 음식은 무엇입니까"))
    $w1 = len($s) > 0 and len($e) > 0 ? map(filter($d.items,($x)=>$x.paragraph_index > $s[0].paragraph_index and $x.paragraph_index < $e[0].paragraph_index),($x)=>$x.text) : []
    $w2 = len($w1) == 0 and len($e) > 0 and len($e2) > 0 ? map(filter($d.items,($x)=>$x.paragraph_index > $e[0].paragraph_index and $x.paragraph_index < $e2[0].paragraph_index),($x)=>$x.text) : []
    return {name:$name,found:true,product:$product,item_seq:$seq,ingredients:$ings,warn:len($w1) > 0 ? $w1 : $w2,warn_from:len($w1) > 0 ? "사용 전에 반드시 알아야 할 내용" : len($w2) > 0 ? "사용상 주의사항" : "",url:$hit[0].url,reason:""}
  } [catch] { return {**$none,reason:f"조회 실패: ${error.message}"} }
}
# 증상 낱말 → 국가건강정보포털 문서 주소 → 본문. 본문이 오지 않으면 unverified
[def:포털찾기]($word) {
  [try] {
    $s = [sense:search]{query:f"국가건강정보포털 ${word}",source:"naver",limit:8}
    $hit = filter($s.items,($x)=>contains($x.url,"health.kdca.go.kr") and contains($x.url,"cntnts_sn="))
    [if:len($hit) == 0] { return {word:$word,status:"unverified",url:"",title:"",quotes:[],reason:"포털 문서 주소를 검색에서 찾지 못함"} }
    $c = [sense:crawl]{url:$hit[0].url,max_length:200000}
    $q = filter($c.items,($x)=>len($x.text) > 30 and (contains($x.text,"응급실") or contains($x.text,"119") or contains($x.text,"즉시 병원") or contains($x.text,"바로 병원")))
    [if:has($c,"reason") or len($c.text) < 500] { return {word:$word,status:"unverified",url:$hit[0].url,title:$hit[0].title,quotes:[],reason:f"본문을 읽지 못함(받은 글 ${len($c.text)}자 — 메뉴뿐)"} }
    [if:len($q) == 0] { return {word:$word,status:"unverified",url:$hit[0].url,title:$hit[0].title,quotes:[],reason:"본문은 읽었으나 병원에 가야 하는 때를 적은 대목을 찾지 못함"} }
    return {word:$word,status:"quoted",url:$hit[0].url,title:$hit[0].title,quotes:map($q[:2],($x)=>$x.text),reason:""}
  } [catch] { return {word:$word,status:"unverified",url:"",title:"",quotes:[],reason:f"조회 실패: ${error.message}"} }
}
[def:논문찾기]($q) {
  [if:len($q) == 0] { return {q:$q,papers:[],reason:"검색어 없음"} }
  [try] {
    $s = [sense:paper]{op:"search",query:$q,source:"pubmed",limit:2}
    return {q:$q,papers:map($s.items[:2],($x)=>{title:$x.title,pmid:split($x.url,"/")[-2],url:$x.url}),reason:len($s.items) == 0 ? "검색 결과 0건" : ""}
  } [catch] { return {q:$q,papers:[],reason:f"조회 실패: ${error.message}"} }
}
# 모델이 쓴 약 한 줄 "이름|본인|current|용량" → 레코드
[def:약줄풀기]($line) {
  $p = map(split($line,"|"),($x)=>strip($x))
  $dose = len($p) > 3 and $p[3] != "없음" and len($p[3]) > 0 ? $p[3] : null
  return {name:$p[0],whose:len($p) > 1 and $p[1] == "타인" ? "타인" : "본인",status:len($p) > 2 and $p[2] == "stopped" ? "stopped" : "current",dose:$dose}
}

# ---- (1) 자료 읽기 ----
$jobdoc = [self:read]{path:f"${src}/job.json"}
$job = $jobdoc.data
$files = [self:list]{path:f"${src}/intake",pattern:"*.md"}
$intake = sorted($files,"name") >> [table:each] { [fn:접수지읽기]{f:$it} }
$filled = filter($intake,($r)=>len(strip($r.text)) > 0)
[if:len($filled) == 0] {
  [self:write]{path:f"${out}/index.json",content:"[]"}
  [self:write]{path:f"${out}/summary.md",content:f"# ${job.office} — ${job.consult_date} 진료 전 준비 요약\n\n접수 없음 — 읽을 접수지가 없어 메모를 만들지 않았다(파일 ${len($files)}개).\n"}
  return {cases:0,files:len($files),note:"접수 없음"}
}

# ---- (2) 측정 통계(코드) ----
$csv = [self:read]{path:f"${src}/measurements.csv"}
$meas = $csv.data.items >> [table:each] { [fn:측정풀기]{r:$it,th:$job.thresholds,consult:$job.consult_date} }
$valid = filter($meas,($m)=>$m.ok)
$invalid = filter($meas,($m)=>not $m.ok)
$g_all = [fn:묶어평균]{rows:$valid}
$g_rec = [fn:묶어평균]{rows:filter($valid,($m)=>$m.zone == "recent")}
$g_pri = [fn:묶어평균]{rows:filter($valid,($m)=>$m.zone == "prior")}
$g_inv = [fn:묶어평균]{rows:$invalid}
$g_days = []
[if:len($valid) > 0] {
  $gd = $valid >> [table:groupby]{by:["case_id","kind","day"],agg:{o:["max","over"]}}
  $g_days = $gd.items
}

# ---- (3) 접수지 정리(모델 1회) — 약 이름은 제안일 뿐이고 아래에서 원천으로 확인한다 ----
$ask = """각 행은 마을 건강상담 창구의 접수지(text)다. 진단을 내리지 말고, 약 용량을 바꾸라는 말도 하지 말 것. 행마다 다음 칸을 채워라.
- timeline: 증상 경과를 날짜순으로, 한 줄에 하나씩 'YYYY-MM-DD 무슨 일' 꼴로. '지난주 화요일'·'나흘 전' 같은 표현은 접수일을 기준으로 날짜로 바꾼다. 날짜를 알 수 없는 것은 '날짜 미상' 으로 시작.
- urgent: 가슴 통증·호흡곤란·한쪽 마비·말이 어눌함·의식 변화처럼 지체하면 위험할 수 있는 신호가 접수지에 적혀 있으면 true. 수치가 높다·감기·근육통·두통만으로는 false.
- urgent_reason: urgent 가 true 면 접수지의 그 대목을 글자 그대로 옮긴다. 아니면 빈 글.
- drugs: 접수지에 적힌 약을 ' ; ' 로 이어서, 약마다 '제품명|본인 또는 타인|current 또는 stopped|용량'. 제품명은 접수지에 적힌 글자 그대로(괄호·설명 없이). 신청인이 아닌 사람이 먹는 약은 타인, 끊은 약은 stopped. 용량(1회 몇 정·하루 몇 번)이 접수지에 없으면 '없음'. 약이 없으면 빈 글.
- symptom: 이 건의 주된 증상을 우리말 낱말 하나로(예: 흉통, 발열, 두통, 고혈압).
- pubmed_query: 이 건의 증상·약과 관련된 논문을 PubMed 에서 찾을 영어 검색어(낱말 3~5개).
- tell_doctor: 의사에게 말할 것 2~4개를 ' / ' 로. ask_doctor: 의사에게 물어볼 것 2~3개를 ' / ' 로. bring: 가져갈 것을 ' / ' 로."""
$a1 = $filled >> [table:ai]{instruction:$ask,schema:"timeline(문자열), urgent(불리언), urgent_reason(문자열), drugs(문자열), symptom(문자열), pubmed_query(문자열), tell_doctor(문자열), ask_doctor(문자열), bring(문자열)",input_fields:["id","text"],preserve_rows:true}
$rows = $a1.items >> [table:each] { return {id:$filled[$i].id,text:$filled[$i].text,timeline:$it.timeline == null ? "" : $it.timeline,urgent:$it.urgent == true,urgent_reason:$it.urgent_reason == null ? "" : $it.urgent_reason,
  drugs:$it.drugs == null ? "" : $it.drugs,symptom:$it.symptom == null ? "" : strip($it.symptom),pubmed_query:$it.pubmed_query == null ? "" : strip($it.pubmed_query),
  tell_doctor:$it.tell_doctor == null ? "" : $it.tell_doctor,ask_doctor:$it.ask_doctor == null ? "" : $it.ask_doctor,bring:$it.bring == null ? "" : $it.bring} }

# ---- (4) 원천 조회: 약(이름마다 한 번)·포털(증상마다 한 번)·논문(건마다) ----
$withdrugs = map($rows,($r)=>{**$r,druglist:map(filter(split($r.drugs,";"),($x)=>len(strip($x)) > 0),($x)=>[fn:약줄풀기]{line:$x})})
$names = unique(reduce($withdrugs,[],($acc,$r)=>$acc + map($r.druglist,($d)=>$d.name)))
$druginfo = $names >> [table:each]{parallel:3} { [fn:약찾기]{name:$it} }
$words = unique(filter(map($rows,($r)=>$r.symptom),($w)=>len($w) > 0))
$portal = $words >> [table:each]{parallel:2} { [fn:포털찾기]{word:$it} }
$papers = $rows >> [table:each]{parallel:3} { [fn:논문찾기]{q:$it.pubmed_query} }

# ---- (5) 건마다 조립 ----
[def:건조립]($r,$paper,$druginfo,$portal,$g_all,$g_rec,$g_pri,$g_inv,$g_days) {
  $drugs = map($r.druglist,($d)=>{**$d,info:filter($druginfo,($x)=>$x.name == $d.name)[0]})
  $mine = filter($drugs,($d)=>$d.whose == "본인" and $d.status == "current" and $d.info.found)
  $ings = reduce($mine,[],($acc,$d)=>$acc + unique($d.info.ingredients))
  $dup = unique(filter($ings,($g)=>len(filter($ings,($h)=>$h == $g)) > 1))
  $stats = [fn:한건통계]{id:$r.id,all:$g_all,rec:$g_rec,pri:$g_pri,inv:$g_inv,days:$g_days}
  $over = sum(map(values($stats),($s)=>has($s,"over_days") ? $s.over_days : 0))
  $pt = filter($portal,($p)=>$p.word == $r.symptom)
  $none = {word:$r.symptom,status:"unverified",url:"",title:"",quotes:[],reason:"증상 낱말 없음"}
  return {**$r,drugs2:$drugs,dup:$dup,stats:$stats,over_total:$over,portal:len($pt) > 0 ? $pt[0] : $none,paper:$paper}
}
$cases = $withdrugs >> [table:each] { [fn:건조립]{r:$it,paper:$papers[$i],druginfo:$druginfo,portal:$portal,g_all:$g_all,g_rec:$g_rec,g_pri:$g_pri,g_inv:$g_inv,g_days:$g_days} }
$ordered = sorted(sorted($cases,"id"),($c)=>$c.urgent ? -1000000 : 0 - $c.over_total)

# ---- (6) 글 ----
[def:값글]($v) { return $v == null ? "기록 없음" : text($v) }
[def:통계줄]($k,$s) {
  [if:$s.n == 0] { return f"- ${k}: 쓸 수 있는 측정 0건(못 쓰는 줄 ${s.invalid}건) — 평균을 내지 않음" }
  $r7 = [fn:값글]{v:$s.recent7}
  $pr = [fn:값글]{v:$s.prior}
  [if:$k == "혈압"] { return f"- 혈압: 측정 ${s.n}건(못 쓰는 줄 ${s.invalid}건), 평균 ${s.mean_sys}/${s.mean_dia} mmHg, 상담일 전 7일 수축기 평균 ${r7} · 그 전 ${pr}, 창구 기준을 넘은 날 ${s.over_days}일" }
  return f"- ${k}: 측정 ${s.n}건(못 쓰는 줄 ${s.invalid}건), 평균 ${s.mean}, 상담일 전 7일 평균 ${r7} · 그 전 ${pr}, 창구 기준을 넘은 날 ${s.over_days}일"
}
[def:약글]($d) {
  $who = $d.whose == "타인" ? " — 다른 사람의 약(본인 약 아님)" : ""
  $st = $d.status == "stopped" ? " — 끊은 약" : ""
  $dose = $d.dose == null ? "용량 확인 필요(접수지에 없음)" : $d.dose
  [if:not $d.info.found] { return f"### ${d.name}${who}${st}\n- 접수지의 용량: ${dose}\n- 확인하지 못함 — ${d.info.reason}. 성분·주의사항을 적지 않는다." }
  $ing = join(", ",$d.info.ingredients)
  $body = len($d.info.warn) == 0 ? "(상세 페이지에서 해당 대목을 찾지 못함)" : join("\n",map($d.info.warn,($w)=>f"> ${w}"))
  return f"### ${d.name}${who}${st}\n- 접수지의 용량: ${dose}\n- e약은요 제품명: ${d.info.product} (품목기준코드 ${d.info.item_seq})\n- 주성분: ${ing}\n- 원문(${d.info.warn_from}), 출처 ${d.info.url}\n\n${body}"
}
[def:메모글]($c,$job) {
  $statlines = len(keys($c.stats)) == 0 ? "측정 기록 없음" : join("\n",map(entries($c.stats),($e)=>[fn:통계줄]{k:$e[0],s:$e[1]}))
  $druglines = len($c.drugs2) == 0 ? "접수지에 적힌 약 없음" : join("\n\n",map($c.drugs2,($d)=>[fn:약글]{d:$d}))
  $dupjoin = join(", ",$c.dup)
  $dupline = len($c.dup) == 0 ? "지금 본인이 먹는 약들 사이에 같은 주성분이 겹치는 것은 확인되지 않음(원천에서 찾은 약만 비교)." : f"**같은 주성분이 겹침: ${dupjoin}** — 지금 본인이 먹는 약 둘 이상에 들어 있다. 의사·약사에게 그대로 알릴 것."
  $urgentline = $c.urgent ? f"**지체 없이 진료·응급 확인이 필요해 보이는 대목이 접수지에 있음:** ${c.urgent_reason}\n\n상담일을 기다리지 말고 바로 의료기관·119 에 문의하도록 안내할 것.\n\n" : ""
  $pq = join("\n",map($c.portal.quotes,($q)=>f"> ${q}"))
  $portalline = $c.portal.status == "quoted" ? f"국가건강정보포털 「${c.portal.title}」 ${c.portal.url}\n\n${pq}" : f"읽지 못함 — ${c.portal.reason}. 시도한 주소: ${c.portal.url}"
  $paperline = len($c.paper.papers) == 0 ? f"못 찾음 — ${c.paper.reason} (검색어: ${c.paper.q})" : join("\n",map($c.paper.papers,($p)=>f"- ${p.title} (PMID ${p.pmid}) ${p.url}"))
  return f"""# 진료 전 준비 메모 ${c.id}

> ${job.note}. ${job.office} · 상담일 ${job.consult_date}. 측정 숫자는 기록을 계산한 값이고, 약 성분·주의는 의약품안전나라에서 가져온 원문이며, 경과·말할 것·물어볼 것은 모델이 접수지를 읽고 쓴 것이다. 의료 자문이 아님.

${urgentline}## 경과
${c.timeline}

## 측정 요약
${statlines}

## 약
${druglines}

${dupline}

## 병원에 바로 가야 하는 신호(${c.symptom})
${portalline}

## 관련 논문
${paperline}

## 의사에게 말할 것
${c.tell_doctor}

## 의사에게 물어볼 것
${c.ask_doctor}

## 가져갈 것
${c.bring}
"""
}
[def:표줄]($c) {
  $u = $c.urgent ? "바로 확인" : "-"
  $dupjoin = len($c.dup) == 0 ? "-" : join(", ",$c.dup)
  $unv = join(", ",map(filter($c.drugs2,($d)=>not $d.info.found),($d)=>$d.name))
  $unv2 = len($unv) == 0 ? "-" : $unv
  return f"| ${c.id} | ${u} | ${c.over_total} | ${dupjoin} | ${unv2} | ${c.symptom} |"
}
[self:mkdir]{path:f"${out}/cases"}
$written = $ordered >> [table:each] { $w = [self:write]{path:f"${out}/cases/${it.id}.md",content:[fn:메모글]{c:$it,job:$job}}; return $it.id }
$index = map($ordered,($c)=>{id:$c.id,urgent:$c.urgent,stats:$c.stats,
  drugs:map($c.drugs2,($d)=>{name:$d.name,whose:$d.whose,status:$d.status,dose:$d.dose,found:$d.info.found,item_seq:$d.info.found ? $d.info.item_seq : null,ingredients:$d.info.ingredients}),
  duplicate_ingredients:$c.dup,pmids:map($c.paper.papers,($p)=>$p.pmid),portal:{status:$c.portal.status,url:$c.portal.url},file:f"cases/${c.id}.md"})
[self:write]{path:f"${out}/index.json",content:json($index)}
$tbl = join("\n",map($ordered,($c)=>[fn:표줄]{c:$c}))
$u1 = json(map(filter($druginfo,($d)=>not $d.found),($d)=>{name:$d.name,reason:$d.reason}))
$u2 = json(map(filter($portal,($p)=>$p.status != "quoted"),($p)=>{word:$p.word,url:$p.url,reason:$p.reason}))
$u3 = json(map(filter($cases,($c)=>len($c.paper.papers) == 0),($c)=>$c.id))
$summary = f"""# ${job.office} — ${job.consult_date} 진료 전 준비 요약

> ${job.note}. 접수 ${len($intake)}건, 측정 ${len($meas)}줄(쓸 수 있는 줄 ${len($valid)} · 못 쓰는 줄 ${len($invalid)}).

## 급한 순
| 접수 | 응급 신호 | 기준 넘은 날 합 | 겹치는 성분 | 확인 못 한 약 | 주된 증상 |
| --- | --- | --- | --- | --- | --- |
${tbl}

## 확인하지 못한 것
- 원천에서 찾지 못한 약: ${u1}
- 병원에 갈 신호 원문을 읽지 못한 증상: ${u2}
- 논문을 못 붙인 건: ${u3}
- 응급 신호 표시는 모델이 접수지 글을 읽고 붙인 것이다. 표시가 없다고 안전하다는 뜻이 아니다.
"""
[self:write]{path:f"${out}/summary.md",content:$summary}
$back = [self:read]{path:f"${out}/summary.md",format:"text"}
return {cases:len($cases),meas:len($meas),valid:len($valid),invalid:len($invalid),order:map($ordered,($c)=>{id:$c.id,urgent:$c.urgent,over:$c.over_total,dup:$c.dup,symptom:$c.symptom,portal:$c.portal.status,pmids:map($c.paper.papers,($p)=>$p.pmid)}),
  drugs:map($druginfo,($d)=>{name:$d.name,found:$d.found,seq:$d.item_seq,ings:$d.ingredients,warn:len($d.warn),from:$d.warn_from}),written:len($written),summary_reread:contains($back.text,"급한 순")}
