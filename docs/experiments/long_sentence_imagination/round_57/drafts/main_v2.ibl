#!ibl edition=2
[def:수집]($id,$크기) {
  $page = [self:body]{op:"trajectory",view:"trace",episode_id:$id,limit:$크기}
  $events = $page.items
  $evidence = $page.links.evidence
  $pages = 1
  [repeat:while get($page,"next_cursor",null) != null and $i < 200] {
    $page = [self:body]{op:"trajectory",view:"trace",episode_id:$id,limit:$크기,cursor:$page.next_cursor}
    $events = $events + $page.items
    $evidence = $evidence + $page.links.evidence
    $pages = $pages + 1
  }
  assert get($page,"next_cursor",null) == null, "페이지 상한 초과", {episode_id:$id}
  $counts = $events >> [table:groupby]{by:"kind",agg:{count:["count"]}}
  $ids = map($events,($e)=>$e.source_record_id)
  assert len(unique($ids)) == len($ids), "중복 사건", {episode_id:$id}
  $failures = $events >> [table:filter]{where:($e)=>$e.source == "trajectory" and get($e.summary,"is_error",false) == true}
  $log = ""
  [if:len($failures) > 0] {
    $logs = $page.links.documents >> [table:filter]{where:($d)=>$d.label == f"episode ${$id} log"}
    assert len($logs) == 1, "실패 근거 로그 누락"
    $doc = [self:body]{op:"trajectory",view:"document",episode_id:$id,source_ref:$logs[0].source_ref,limit:12000}
    $log = $doc.text
    [repeat:while get($doc,"next_offset",null) != null and $i < 100] {
      $doc = [self:body]{op:"trajectory",view:"document",episode_id:$id,source_ref:$logs[0].source_ref,offset:$doc.next_offset,cursor:$doc.next_cursor,limit:12000}
      $log = $log + $doc.text
    }
    assert get($doc,"next_offset",null) == null, "근거 로그 상한 초과"
  }
  $candidates = []
  [if:contains($log,"승인된 수리 실행자만")] {
    $candidates = $candidates + [{priority:1,observation:"수리 전용 명령이 권한 거절됨",interpretation:"허용되지 않은 역할의 도구 노출을 확인할 필요",proposal:"실행자 역할과 수리 권한에 맞춰 도구 목록을 제한"}]
  }
  [if:contains($log,"gocache") or contains($log,"go-build")] {
    $candidates = $candidates + [{priority:2,observation:"Go 캐시 경로 관련 로그 존재",interpretation:"격리된 쓰기 경로와 캐시 경로의 불일치 여부 확인",proposal:"캐시·임시 경로를 허용된 작업 런타임 안으로 설정"}]
  }
  return {failures:$failures,candidates:$candidates,log:$log,episode_id:$id,pages:$pages,event_count:len($events),events:$events,counts:$counts.items,usage:$page.usage,state:$page.state,diagnostics:$page.diagnostics,sources:$page.sources,partial:$page.partial,links:$page.links,evidence:$evidence}
}
$rows = $ids >> [table:each]{parallel:3} { [fn:수집]{id:$it,크기:$size} }
$lines = $rows >> [table:each] {
  return f"실행 ${$it.episode_id}: 사건 ${$it.event_count}개 / ${$it.pages}페이지. 런타임 관측 ${$it.state.assessment}, 목표 평가 ${json($it.state.goal_evaluations)}, 부분성 ${$it.partial}.\n관측 사용량: ${json($it.usage)}\n진단: ${json($it.diagnostics)}\n종류별 사건: ${json($it.counts)}\n실패 관측: ${len($it.failures)}건. 개선 후보(관찰/해석/제안): ${json($it.candidates)}. 종료·시간만으로 성공이나 낭비를 단정하지 않음."
}
$report = "# 시스템 자기개선 — 실행 근거 감사\n\n" + join("\n\n",$lines)
[self:write]{path:$out + "/result.json",content:json($rows)}
[self:write]{path:$out + "/report.md",content:$report}
$check = [self:read]{path:$out + "/result.json"}
$text = [self:read]{path:$out + "/report.md"}
assert $check.data.items == $rows, "JSON 재독 불일치"
assert $text.text == $report, "보고서 재독 불일치"
return map($rows,($r)=>{episode_id:$r.episode_id,pages:$r.pages,event_count:$r.event_count,usage:$r.usage,assessment:$r.state.assessment,partial:$r.partial})
