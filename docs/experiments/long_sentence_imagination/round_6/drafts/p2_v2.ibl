#!ibl edition=2
# 6회차 P2 v2 분석·판정 (v0: 63행 SYNTAX / v1: 49행 filter 가 List<Text> 거절 → each flat_map, 73행 오류(전부 null 인스턴스) 보간 FORMAT_TYPE → null 분기) — inputs: 자료={$ref P1}, 고정(fixed.json 경로). 렌더·저장은 P3.

# 한 분류의 월별 합계에서 "다른 달 평균의 2배 이상"인 달
[def:튄달]($분류,$월합) {
  $내 = $월합 >> [table:filter]{where:($m)=>$m.분류 == $분류}
  $내 >> [table:each]{mode:"flat_map"} {
    $me = $it
    $다른 = $내 >> [table:filter]{where:($m)=>$m.월 != $me.월}
    [if:len($다른) == 0] { return [] }
    $다른합 = $다른 >> [table:each] { return $it.합계 }
    $평균 = sum($다른합) / len($다른)
    [if:$me.합계 >= 2 * $평균] { return [{종류:"지출 급증",분류:$분류,월:$me.월,금액:$me.합계,다른달평균:round($평균),설명문:f"${$분류} ${$me.월}월 ${$me.합계}원 — 다른 달 평균 ${round($평균)}원의 2배 이상"}] }
    return []
  }
}

# ── 최상위 ──
$고정문 = [self:read]{path:$고정}
$고정들 = $고정문.data.items
$행 = $자료.행
$지출 = $행 >> [table:filter]{where:($r)=>$r.금액수 != null and $r.금액수 >= 0}
$환불 = $행 >> [table:filter]{where:($r)=>$r.금액수 != null and $r.금액수 < 0}
$월별 = $지출 >> [table:groupby]{by:"월",agg:{합계:["sum","금액수"],건수:["count"]}}
$월별행 = $월별.items >> [table:sort]{by:"월"}
$월합들 = $월별행 >> [table:each] { return $it.합계 }
$총지출 = sum($월합들)
$환불월 = $환불 >> [table:groupby]{by:"월",agg:{합계:["sum","금액수"]}}
$환불합들 = $환불월.items >> [table:each] { return $it.합계 }
$환불합 = sum($환불합들)
$월분류 = $지출 >> [table:groupby]{by:["월","분류"],agg:{합계:["sum","금액수"],건수:["count"]}}
$월분류행 = $월분류.items >> [table:sort]{by:"월"}
$분류합 = $지출 >> [table:groupby]{by:"분류",agg:{합계:["sum","금액수"],건수:["count"]}}
$분류행 = $분류합.items >> [table:sort]{by:"합계",descending:true}

# 중복 결제 의심: 같은 날·가게·금액 2회 이상
$중복군 = $지출 >> [table:groupby]{by:["일자","설명","금액"],agg:{건수:["count"]}}
$중복 = $중복군.items >> [table:filter]{where:($g)=>$g.건수 > 1} >> [table:sort]{by:"일자"} >> [table:each] { return {종류:"중복 결제 의심",일자:$it.일자,설명:$it.설명,금액:$it.금액,건수:$it.건수,설명문:f"${$it.일자} ${$it.설명} ${$it.금액}원 ${$it.건수}회"} }

# 고정지출: 키워드별 월 합계 → 빠진 달·금액 다른 달
$파일월 = $자료.파일상태 >> [table:filter]{where:($f)=>$f.상태 == "읽음"} >> [table:each] { return split(split($it.파일,"-")[1],".")[0] }
$가게월 = $지출 >> [table:groupby]{by:["설명","월"],agg:{합계:["sum","금액수"],건수:["count"]}}
$고정키 = $고정들 >> [table:each] { return $it.키워드 }
$고정가게월 = $가게월.items >> [table:filter]{where:($m)=>$m.설명 in $고정키}
$고정이상 = $고정들 >> [table:each]{mode:"flat_map"} {
  $g = $it
  $내달 = $고정가게월 >> [table:filter]{where:($m)=>$m.설명 == $g.키워드}
  $있는월 = $내달 >> [table:each] { return $it.월 }
  $빠짐 = $파일월 >> [table:each]{mode:"flat_map"} {
    [if:$it in $있는월] { return [] }
    return [{종류:"고정지출 빠짐",이름:$g.이름,월:$it,기대금액:$g.금액,설명문:f"${$g.이름} ${$it}월 결제 없음(기대 ${$g.금액}원)"}]
  }
  $다름 = $내달 >> [table:filter]{where:($m)=>$m.합계 != $g.금액} >> [table:each] { return {종류:"고정지출 금액 다름",이름:$g.이름,월:$it.월,금액:$it.합계,기대금액:$g.금액,설명문:f"${$g.이름} ${$it.월}월 ${$it.합계}원(기대 ${$g.금액}원, ${$it.건수}건)"} }
  return $빠짐 + $다름
}

# 튄 달
$분류이름들 = $분류행 >> [table:each] { return $it.분류 }
$급증 = $분류이름들 >> [table:each]{mode:"flat_map"} { [fn:튄달]{분류:$it,월합:$월분류행} }

# 구독 겹침: 구독 가게 쌍 판정(미결정 null 은 따로)
$구독이름 = $자료.가게분류 >> [table:filter]{where:($g)=>$g.분류 == "구독"} >> [table:each] { return $it.설명 }
$쌍 = $구독이름 >> [table:each]{mode:"flat_map"} {
  $a = $i
  $A = $it
  $구독이름 >> [table:each]{mode:"flat_map"} {
    [if:$i > $a] { return [{서비스1:$A,서비스2:$it}] }
    return []
  }
}
$판정 = $쌍 >> [table:judge]{instruction:"서비스1과 서비스2는 같은 종류의 구독 서비스(예: 음악 스트리밍 둘, 영상 스트리밍 둘)라서 한쪽을 해지해도 되는 겹치는 구독인가?",type:"boolean"}
$겹침 = $판정.items >> [table:filter]{where:($p)=>$p.judgment_result_value == true} >> [table:each] { return {종류:"구독 겹침",서비스1:$it.서비스1,서비스2:$it.서비스2,확률:$it.judgment_result_probability,설명문:f"${$it.서비스1} ↔ ${$it.서비스2} 같은 종류(확률 ${$it.judgment_result_probability})"} }
$미결정 = $판정.items >> [table:filter]{where:($p)=>$p.judgment_result_status != "decided"} >> [table:each] { return {종류:"구독 겹침 확인 필요",서비스1:$it.서비스1,서비스2:$it.서비스2,확률:$it.judgment_result_probability,설명문:f"${$it.서비스1} ↔ ${$it.서비스2} 판정 미결정(확률 ${$it.judgment_result_probability})"} }

# 읽기·금액 문제
$파일문제 = $자료.파일상태 >> [table:filter]{where:($f)=>$f.상태 != "읽음"} >> [table:each] { return {종류:"파일 읽지 못함",파일:$it.파일,설명문:f"${$it.파일}: ${$it.오류 == null ? '사유 없음' : $it.오류}"} }
$금액문제 = $자료.금액오류행 >> [table:each] { return {종류:"금액 읽지 못함",일자:$it.일자,설명:$it.설명,금액원문:$it.금액,설명문:f"${$it.일자} ${$it.설명} 금액 '${$it.금액}' 해석 불가 — 합계에서 제외"} }

$이상 = $중복 + $고정이상 + $급증 + $겹침 + $미결정 + $파일문제 + $금액문제
$종류별 = $이상 >> [table:groupby]{by:"종류",agg:{건수:["count"]}}
return {총지출:$총지출,환불합:$환불합,지출건수:len($지출),환불건수:len($환불),월별:$월별행,월분류:$월분류행,분류합:$분류행,
        이상:$이상,종류별:$종류별.items,판정원본:$판정.items,쌍수:len($쌍)}
