#!ibl edition=2
# 6회차 P1 v2 — v1 은 (a) 단계 89,750/100,000 로 아슬(compute 4필드 ≈ 30단계/행) (b) table:ai schema 필드 "분류" 가 input_fields 밖의 기존 열과 충돌해 실행 뒤 TOOL 실패.
# v2: compute 2필드(월·금액수)만, 오류행은 느린 경로 파일에서만 수집, ai 앞에 select 로 설명만 남김. inputs: 폴더, 규칙

[def:빠른정규화]($행들) {
  $행들 >> [table:compute]{set:($r)=>{월:split($r.일자,"-")[1],금액수:number($r.금액)}}
}
[def:느린정규화]($행들) {
  $행들 >> [table:each] {
    [try] { $금 = number($it.금액)
      return {**$it,월:split($it.일자,"-")[1],금액수:$금,금액오류:null} }
    [catch] { return {**$it,월:split($it.일자,"-")[1],금액수:null,금액오류:$error.message} }
  }
}
[def:파일정규화]($행들) {
  [try] { return {행:[fn:빠른정규화]{행들:$행들},오류행:[],경로:"빠름"} }
  [catch] {
    $느 = [fn:느린정규화]{행들:$행들}
    $오 = $느 >> [table:filter]{where:($r)=>$r.금액오류 != null}
    return {행:$느,오류행:$오,경로:"느림"}
  }
}
[def:규칙분류]($설명,$규칙들) {
  $맞음 = $규칙들 >> [table:filter]{where:($r)=>contains($설명,$r.키워드)}
  return len($맞음) > 0 ? $맞음[0].분류 : null
}

# ── 최상위 ──
$파일들 = [self:list]{path:$폴더,pattern:"tx_2025-0[1-3].csv"} >> [table:sort]{by:"name"}
$읽기 = $파일들 >> [table:each]{parallel:4,on_error:"collect"} {
  $문 = [self:read]{path:$it.path}
  $정 = [fn:파일정규화]{행들:$문.data.items}
  return {파일:$it.name,행:$정.행,오류행:$정.오류행,경로:$정.경로}
}
$파일상태 = $파일들 >> [table:each] {
  [if:is_ok($읽기[$i])] { $f = unwrap($읽기[$i]); return {파일:$it.name,상태:"읽음",행수:len($f.행),경로:$f.경로,오류:null} }
  [else] { return {파일:$it.name,상태:"실패",행수:0,경로:null,오류:error_of($읽기[$i]).message} }
}
$정규 = $읽기 >> [table:each]{mode:"flat_map"} { [if:is_ok($it)] { return unwrap($it).행 } [else] { return [] } }
$금액오류행 = $읽기 >> [table:each]{mode:"flat_map"} { [if:is_ok($it)] { return unwrap($it).오류행 } [else] { return [] } }
return {파일상태:$파일상태,행수:len($정규),오류:len($금액오류행)}
