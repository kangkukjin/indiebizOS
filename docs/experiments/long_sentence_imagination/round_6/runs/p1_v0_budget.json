 "request": {
  "code": "#!ibl edition=2\n# 6회차 P1 수집·정규화·분류 — inputs: 폴더(ledger 경로), 규칙(rules.json 경로)\n\n# 1) 한 줄 정규화: 금액 숫자화·월·환불 표시, 실패는 원문 보존\n[def:행정규화]($행,$파일) {\n  $월 = split($행.일자,\"-\")[1]\n  [try] {\n    $금 = number($행.금액)\n    return {파일:$파일,일자:$행.일자,월:$월,설명:$행.설명,금액:$금,환불:$금 < 0,금액원문:$행.금액,금액오류:null}\n  } [catch] {\n    return {파일:$파일,일자:$행.일자,월:$월,설명:$행.설명,금액:null,환불:false,금액원문:$행.금액,금액오류:$error.message}\n  }\n}\n\n# 2) 규칙 분류: 첫 번째로 맞는 규칙의 분류, 없으면 null\n[def:규칙분류]($설명,$규칙들) {\n  $맞음 = $규칙들 >> [table:filter]{where:($r)=>contains($설명,$r.키워드)}\n  return len($맞음) > 0 ? $맞음[0].분류 : null\n}\n\n# ── 최상위 ──\n$파일들 = [self:list]{path:$폴더,pattern:\"tx_2025-*.csv\"} >> [table:sort]{by:\"name\"}\n$읽기 = $파일들 >> [table:each]{parallel:4,on_error:\"collect\"} {\n  $문 = [self:read]{path:$it.path}\n  return {파일:$it.name,행:$문.data.items}\n}\n$파일상태 = $파일들 >> [table:each] {\n  [if:is_ok($읽기[$i])] { return {파일:$it.name,상태:\"읽음\",행수:len(unwrap($읽기[$i]).행),오류:null} }\n  [else] { return {파일:$it.name,상태:\"실패\",행수:0,오류:error_of($읽기[$i]).message} }\n}\n$정규 = $읽기 >> [table:each]{mode:\"flat_map\"} {\n  [if:is_ok($it)] {\n    $f = unwrap($it)\n    return $f.행 >> [table:each] { [fn:행정규화]{행:$it,파일:$f.파일} }\n  }\n  [else] { return [] }\n}\n$규칙문 = [self:read]{path:$규칙}\n$규칙들 = $규칙문.data.items\n$가게들 = $정규 >> [table:dedup]{by:\"설명\"}\n$가게분류 = $가게들.items >> [table:each] { return {설명:$it.설명,분류:[fn:규칙분류]{설명:$it.설명,규칙들:$규칙들},출처:\"규칙\"} }\n$규칙분류됨 = $가게분류 >> [table:filter]{where:($g)=>$g.분류 != null}\n$미분류 = $가게분류 >> [table:filter]{where:($g)=>$g.분류 == null}\n$AI = $미분류 >> [table:ai]{instruction:\"각 행의 설명(카드 명세서의 가게 표기)이 어떤 지출 분류인지 정한다. 분류는 식비·교통·의료·쇼핑·문화·구독·주거·미용·여행·생활 중 하나만 쓴다.\",schema:\"분류(문자열)\",input_fields:[\"설명\"],preserve_rows:true}\n$AI분류 = $AI.items >> [table:each] { return {설명:$it.설명,분류:$it.분류,출처:\"AI\"} }\n$전체분류 = $규칙분류됨 + $AI분류\n$행 = [table:join]{left:$정규,right:$전체분류,on:\"설명\",how:\"left\",defaults:{분류:\"미분류\",출처:\"없음\"}}\n$금액오류행 = $정규 >> [table:filter]{where:($r)=>$r.금액오류 != null}\nreturn {행:$행.items,파일상태:$파일상태,행수:len($정규),금액오류행:$금액오류행,AI분류:$AI분류,가게수:len($가게들.items),미분류가게수:len($미분류)}\n",
