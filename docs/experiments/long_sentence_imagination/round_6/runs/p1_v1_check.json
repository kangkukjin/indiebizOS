 "request": {
  "code": "#!ibl edition=2\n# 6회차 P1 v1 수집·정규화·분류 — v0 는 행마다 함수+try 로 100k 단계 초과(2,291행에서 BUDGET). \n# v1: 파일 단위 table:compute 빠른 경로(한 행이라도 금액 해석 실패면 그 파일만 행 단위 try 느린 경로). inputs: 폴더, 규칙\n\n[def:빠른정규화]($행들) {\n  $행들 >> [table:compute]{set:($r)=>{월:split($r.일자,\"-\")[1],금액수:number($r.금액),환불:number($r.금액) < 0,금액오류:null}}\n}\n[def:느린정규화]($행들) {\n  $행들 >> [table:each] {\n    [try] { $금 = number($it.금액)\n      return {**$it,월:split($it.일자,\"-\")[1],금액수:$금,환불:$금 < 0,금액오류:null} }\n    [catch] { return {**$it,월:split($it.일자,\"-\")[1],금액수:null,환불:false,금액오류:$error.message} }\n  }\n}\n[def:파일정규화]($행들) {\n  [try] { return {행:[fn:빠른정규화]{행들:$행들},경로:\"빠름\"} }\n  [catch] { return {행:[fn:느린정규화]{행들:$행들},경로:\"느림\"} }\n}\n[def:규칙분류]($설명,$규칙들) {\n  $맞음 = $규칙들 >> [table:filter]{where:($r)=>contains($설명,$r.키워드)}\n  return len($맞음) > 0 ? $맞음[0].분류 : null\n}\n\n# ── 최상위 ──\n$파일들 = [self:list]{path:$폴더,pattern:\"tx_2025-*.csv\"} >> [table:sort]{by:\"name\"}\n$읽기 = $파일들 >> [table:each]{parallel:4,on_error:\"collect\"} {\n  $문 = [self:read]{path:$it.path}\n  $정 = [fn:파일정규화]{행들:$문.data.items}\n  return {파일:$it.name,행:$정.행,경로:$정.경로}\n}\n$파일상태 = $파일들 >> [table:each] {\n  [if:is_ok($읽기[$i])] { $f = unwrap($읽기[$i]); return {파일:$it.name,상태:\"읽음\",행수:len($f.행),경로:$f.경로,오류:null} }\n  [else] { return {파일:$it.name,상태:\"실패\",행수:0,경로:null,오류:error_of($읽기[$i]).message} }\n}\n$정규 = $읽기 >> [table:each]{mode:\"flat_map\"} {\n  [if:is_ok($it)] { return unwrap($it).행 }\n  [else] { return [] }\n}\n$금액오류행 = $정규 >> [table:filter]{where:($r)=>$r.금액오류 != null}\n$규칙문 = [self:read]{path:$규칙}\n$규칙들 = $규칙문.data.items\n$가게들 = $정규 >> [table:dedup]{by:\"설명\"}\n$가게분류 = $가게들.items >> [table:each] { return {설명:$it.설명,분류:[fn:규칙분류]{설명:$it.설명,규칙들:$규칙들},출처:\"규칙\"} }\n$규칙분류됨 = $가게분류 >> [table:filter]{where:($g)=>$g.분류 != null}\n$미분류 = $가게분류 >> [table:filter]{where:($g)=>$g.분류 == null}\n$AI = $미분류 >> [table:ai]{instruction:\"각 행의 설명(카드 명세서의 가게 표기)이 어떤 지출 분류인지 정한다. 분류는 식비·교통·의료·쇼핑·문화·구독·주거·미용·여행·생활 중 하나만 쓴다.\",schema:\"분류(문자열)\",input_fields:[\"설명\"],preserve_rows:true}\n$AI분류 = $AI.items >> [table:each] { return {설명:$it.설명,분류:$it.분류,출처:\"AI\"} }\n$전체분류 = $규칙분류됨 + $AI분류\n$행 = [table:join]{left:$정규,right:$전체분류,on:\"설명\",how:\"left\",defaults:{분류:\"미분류\",출처:\"없음\"}}\nreturn {행:$행.items,파일상태:$파일상태,행수:len($정규),금액오류행:$금액오류행,AI분류:$AI분류,가게수:len($가게들.items),미분류가게수:len($미분류)}\n",
