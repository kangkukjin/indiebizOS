 "request": {
  "code": "#!ibl edition=2\n# 6회차 P2 v2 분석·판정 (v0: 63행 SYNTAX / v1: 49행 filter 가 List<Text> 거절 → each flat_map, 73행 오류(전부 null 인스턴스) 보간 FORMAT_TYPE → null 분기) — inputs: 자료={$ref P1}, 고정(fixed.json 경로). 렌더·저장은 P3.\n\n# 한 분류의 월별 합계에서 \"다른 달 평균의 2배 이상\"인 달\n[def:튄달]($분류,$월합) {\n  $내 = $월합 >> [table:filter]{where:($m)=>$m.분류 == $분류}\n  $내 >> [table:each]{mode:\"flat_map\"} {\n    $me = $it\n    $다른 = $내 >> [table:filter]{where:($m)=>$m.월 != $me.월}\n    [if:len($다른) == 0] { return [] }\n    $다른합 = $다른 >> [table:each] { return $it.합계 }\n    $평균 = sum($다른합) / len($다른)\n    [if:$me.합계 >= 2 * $평균] { return [{종류:\"지출 급증\",분류:$분류,월:$me.월,금액:$me.합계,다른달평균:round($평균),설명문:f\"${$분류} ${$me.월}월 ${$me.합계}원 — 다른 달 평균 ${round($평균)}원의 2배 이상\"}] }\n    return []\n  }\n}\n\n# ── 최상위 ──\n$고정문 = [self:read]{path:$고정}\n$고정들 = $고정문.data.items\n$행 = $자료.행\n$지출 = $행 >> [table:filter]{where:($r)=>$r.금액수 != null and $r.금액수 >= 0}\n$환불 = $행 >> [table:filter]{where:($r)=>$r.금액수 != null and $r.금액수 < 0}\n$월별 = $지출 >> [table:groupby]{by:\"월\",agg:{합계:[\"sum\",\"금액수\"],건수:[\"count\"]}}\n$월별행 = $월별.items >> [table:sort]{by:\"월\"}\n$월합들 = $월별행 >> [table:each] { return $it.합계 }\n$총지출 = sum($월합들)\n$환불월 = $환불 >> [table:groupby]{by:\"월\",agg:{합계:[\"sum\",\"금액수\"]}}\n$환불합들 = $환불월.items >> [table:each] { return $it.합계 }\n$환불합 = sum($환불합들)\n$월분류 = $지출 >> [table:groupby]{by:[\"월\",\"분류\"],agg:{합계:[\"sum\",\"금액수\"],건수:[\"count\"]}}\n$월분류행 = $월분류.items >> [table:sort]{by:\"월\"}\n$분류합 = $지출 >> [table:groupby]{by:\"분류\",agg:{합계:[\"sum\",\"금액수\"],건수:[\"count\"]}}\n$분류행 = $분류합.items >> [table:sort]{by:\"합계\",descending:true}\n\n# 중복 결제 의심: 같은 날·가게·금액 2회 이상\n$중복군 = $지출 >> [table:groupby]{by:[\"일자\",\"설명\",\"금액\"],agg:{건수:[\"count\"]}}\n$중복 = $중복군.items >> [table:filter]{where:($g)=>$g.건수 > 1} >> [table:sort]{by:\"일자\"} >> [table:each] { return {종류:\"중복 결제 의심\",일자:$it.일자,설명:$it.설명,금액:$it.금액,건수:$it.건수,설명문:f\"${$it.일자} ${$it.설명} ${$it.금액}원 ${$it.건수}회\"} }\n\n# 고정지출: 키워드별 월 합계 → 빠진 달·금액 다른 달\n$파일월 = $자료.파일상태 >> [table:filter]{where:($f)=>$f.상태 == \"읽음\"} >> [table:each] { return split(split($it.파일,\"-\")[1],\".\")[0] }\n$가게월 = $지출 >> [table:groupby]{by:[\"설명\",\"월\"],agg:{합계:[\"sum\",\"금액수\"],건수:[\"count\"]}}\n$고정키 = $고정들 >> [table:each] { return $it.키워드 }\n$고정가게월 = $가게월.items >> [table:filter]{where:($m)=>$m.설명 in $고정키}\n$고정이상 = $고정들 >> [table:each]{mode:\"flat_map\"} {\n  $g = $it\n  $내달 = $고정가게월 >> [table:filter]{where:($m)=>$m.설명 == $g.키워드}\n  $있는월 = $내달 >> [table:each] { return $it.월 }\n  $빠짐 = $파일월 >> [table:each]{mode:\"flat_map\"} {\n    [if:$it in $있는월] { return [] }\n    return [{종류:\"고정지출 빠짐\",이름:$g.이름,월:$it,기대금액:$g.금액,설명문:f\"${$g.이름} ${$it}월 결제 없음(기대 ${$g.금액}원)\"}]\n  }\n  $다름 = $내달 >> [table:filter]{where:($m)=>$m.합계 != $g.금액} >> [table:each] { return {종류:\"고정지출 금액 다름\",이름:$g.이름,월:$it.월,금액:$it.합계,기대금액:$g.금액,설명문:f\"${$g.이름} ${$it.월}월 ${$it.합계}원(기대 ${$g.금액}원, ${$it.건수}건)\"} }\n  return $빠짐 + $다름\n}\n\n# 튄 달\n$분류이름들 = $분류행 >> [table:each] { return $it.분류 }\n$급증 = $분류이름들 >> [table:each]{mode:\"flat_map\"} { [fn:튄달]{분류:$it,월합:$월분류행} }\n\n# 구독 겹침: 구독 가게 쌍 판정(미결정 null 은 따로)\n$구독이름 = $자료.가게분류 >> [table:filter]{where:($g)=>$g.분류 == \"구독\"} >> [table:each] { return $it.설명 }\n$쌍 = $구독이름 >> [table:each]{mode:\"flat_map\"} {\n  $a = $i\n  $A = $it\n  $구독이름 >> [table:each]{mode:\"flat_map\"} {\n    [if:$i > $a] { return [{서비스1:$A,서비스2:$it}] }\n    return []\n  }\n}\n$판정 = $쌍 >> [table:judge]{instruction:\"서비스1과 서비스2는 같은 종류의 구독 서비스(예: 음악 스트리밍 둘, 영상 스트리밍 둘)라서 한쪽을 해지해도 되는 겹치는 구독인가?\",type:\"boolean\"}\n$겹침 = $판정.items >> [table:filter]{where:($p)=>$p.judgment_result_value == true} >> [table:each] { return {종류:\"구독 겹침\",서비스1:$it.서비스1,서비스2:$it.서비스2,확률:$it.judgment_result_probability,설명문:f\"${$it.서비스1} ↔ ${$it.서비스2} 같은 종류(확률 ${$it.judgment_result_probability})\"} }\n$미결정 = $판정.items >> [table:filter]{where:($p)=>$p.judgment_result_status != \"decided\"} >> [table:each] { return {종류:\"구독 겹침 확인 필요\",서비스1:$it.서비스1,서비스2:$it.서비스2,확률:$it.judgment_result_probability,설명문:f\"${$it.서비스1} ↔ ${$it.서비스2} 판정 미결정(확률 ${$it.judgment_result_probability})\"} }\n\n# 읽기·금액 문제\n$파일문제 = $자료.파일상태 >> [table:filter]{where:($f)=>$f.상태 != \"읽음\"} >> [table:each] { return {종류:\"파일 읽지 못함\",파일:$it.파일,설명문:f\"${$it.파일}: ${$it.오류 == null ? '사유 없음' : $it.오류}\"} }\n$금액문제 = $자료.금액오류행 >> [table:each] { return {종류:\"금액 읽지 못함\",일자:$it.일자,설명:$it.설명,금액원문:$it.금액,설명문:f\"${$it.일자} ${$it.설명} 금액 '${$it.금액}' 해석 불가 — 합계에서 제외\"} }\n\n$이상 = $중복 + $고정이상 + $급증 + $겹침 + $미결정 + $파일문제 + $금액문제\n$종류별 = $이상 >> [table:groupby]{by:\"종류\",agg:{건수:[\"count\"]}}\nreturn {총지출:$총지출,환불합:$환불합,지출건수:len($지출),환불건수:len($환불),월별:$월별행,월분류:$월분류행,분류합:$분류행,\n        이상:$이상,종류별:$종류별.items,판정원본:$판정.items,쌍수:len($쌍)}\n",
