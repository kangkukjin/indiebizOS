#!ibl edition=2
[def:읽기]($project,$thread,$qid) {
  $q=[self:project]{op:"thread_messages",project_ref:$project,thread_ref:$thread,questions_only:true,question_id:$qid}
  return $q.items[0]
}
[def:깨끗]($refs) {
  return map($refs,($r)=>{version_ref:$r.version_ref,extraction_revision:$r.extraction_revision,locator:$r.locator,quote:$r.quote})
}
[def:근거]($paper,$cell) {
  $parts=split($cell,"||")
  $loc=len($parts)==2?strip($parts[0]):""
  $quote=len($parts)==2?strip($parts[1]):""
  $exact=len($parts)==2 and len($quote)>0 and contains($paper.text,$quote)
  return {version_ref:$paper.version_ref,extraction_revision:$paper.extraction_revision,locator:$loc,quote:$quote,exact:$exact,empty:len($parts)<2 or len($quote)==0}
}
[def:저장시도]($project,$thread,$change) {
  [try] { $r=[self:project]{op:"thread_update",project_ref:$project,thread_ref:$thread,questions:[$change]}; return {ok:true,conflict:false,message:"성공",item:$r.items[0]} }
  [catch] { return {ok:false,conflict:$error.code=="CONFLICT" or contains($error.message,"변경됐습니다"),message:$error.message,item:null} }
}
[def:반영저장]($go,$project,$thread,$change,$s,$k,$probe) {
  [if:not $go] { return {first:{ok:false,conflict:false,message:"닿지 않음 — 저장하지 않음"},resolved:null} }
  $첫=[fn:저장시도]{project:$project,thread:$thread,change:$change}
  [if:not $첫.conflict] { return {first:{ok:$첫.ok,conflict:false,message:$첫.message},resolved:null} }
  $최신=[fn:읽기]{project:$project,thread:$thread,qid:$change.question_id}
  $재=[fn:저장시도]{project:$project,thread:$thread,change:{**$change,expected_revision:$최신.revision,supporting:[fn:깨끗]{refs:$최신.supporting}+$s,contradicting:[fn:깨끗]{refs:$최신.contradicting}+$k,next_probes:$최신.next_probes+[$probe]}}
  return {first:{ok:false,conflict:true,message:$첫.message},resolved:{ok:$재.ok,message:$재.message,retried_with_revision:$최신.revision}}
}
$a=[self:notebook]{op:"add",project_ref:$project,thread_ref:$thread,path:$new.path}
$v=$a.items[0]
$r=[self:notebook]{op:"read",project_ref:$project,thread_ref:$thread,version_ref:$v.version_ref}
$paper={id:$new.id,title:$new.title,version_ref:$v.version_ref,extraction_revision:$r.extraction_revision,text:$r.text,truncated:$r.next_cursor!=null}
$목록=[self:project]{op:"thread_messages",project_ref:$project,thread_ref:$thread,questions_only:true}
$전=$목록.items >> [table:each]{ [fn:읽기]{project:$project,thread:$thread,qid:$it.question_id} }
$행=$전 >> [table:each]{ return {question_id:$it.question_id,question:$it.text,answer:$it.provisional_answer,text:$paper.text} }
$추출=$행 >> [table:ai]{preserve_rows:true,input_fields:["question_id","question","answer","text"],schema:"support(문자열), contra(문자열), why(문자열)",instruction:"text 는 새로 도착한 논문 원문이며 문단마다 [자료:판본:위치] 표식이 앞에 있다. question 과 그 잠정 답변 answer 에 대해 이 논문이 지지하는 문장 하나(support)와 반박하는 문장 하나(contra)를 고른다. 값 형식은 '위치||인용' 이며 위치는 그 문장 앞 표식의 세 번째 칸(예: p.1), 인용은 원문에서 60~240자를 글자 그대로 연속 복사(줄바꿈 하이픈 '- ' 과 띄어쓰기까지 원문 그대로, 요약·수정 금지). 닿지 않으면 둘 다 빈 문자열. why 는 왜 닿는지 또는 닿지 않는지 한 문장. 입력 각 행을 보존."}
$셀=from_entries(map($추출.items,($r)=>[$r.question_id,$r]))
$반영=$전 >> [table:each]{
  $c=get($셀,$it.question_id,{})
  $s=[fn:근거]{paper:$paper,cell:get($c,"support","")}
  $k=[fn:근거]{paper:$paper,cell:get($c,"contra","")}
  $닿음=$s.exact or $k.exact
  $새s=$s.exact?[fn:깨끗]{refs:[$s]}:[]
  $새k=$k.exact?[fn:깨끗]{refs:[$k]}:[]
  $probe=f"논문 ${$new.id} 의 조건이 기존 결론과 같은 설정인지 확인"
  $변경={question_id:$it.question_id,expected_revision:$it.revision,supporting:[fn:깨끗]{refs:$it.supporting}+$새s,contradicting:[fn:깨끗]{refs:$it.contradicting}+$새k,next_probes:$it.next_probes+[$probe]}
  $저장=[fn:반영저장]{go:$닿음,project:$project,thread:$thread,change:$변경,s:$새s,k:$새k,probe:$probe}
  return {question_id:$it.question_id,question:$it.text,revision_before:$it.revision,status_before:$it.status,touched:$닿음,why:get($c,"why",""),support_exact:$s.exact,contra_exact:$k.exact,mismatched:(not $s.empty and not $s.exact)or(not $k.empty and not $k.exact),first:$저장.first,conflict_resolved:$저장.resolved}
}
$후=$목록.items >> [table:each]{ [fn:읽기]{project:$project,thread:$thread,qid:$it.question_id} }
$비교=$반영 >> [table:each]{
  $q=$후[$i]
  return {**$it,revision_after:$q.revision,status_after:$q.status,supporting_after:len($q.supporting),contradicting_after:len($q.contradicting),unchanged:$q.revision==$it.revision_before,reopened:$it.status_before=="resolved" and $q.status=="open"}
}
$결과={project_ref:$project,thread_ref:$thread,new_paper:{id:$paper.id,title:$paper.title,version_ref:$paper.version_ref,extraction_revision:$paper.extraction_revision,truncated:$paper.truncated},questions:$비교}
$표=$비교 >> [table:each]{ return f"|${it.question_id}|${it.revision_before}→${it.revision_after}|${it.status_before}→${it.status_after}|${it.touched?'닿음':'무관'}|${it.first.message}|${it.conflict_resolved==null?'-':(it.conflict_resolved.ok?'재읽기 후 저장(판본 '+text($it.conflict_resolved.retried_with_revision)+')':$it.conflict_resolved.message)}|${it.why}|" }
$본문="# 늦게 도착한 논문 반영\n\n|question_id|판본|상태|닿음|첫 저장|충돌 처리|이유|\n|---|---|---|---|---|---|---|\n"+join("\n",$표)+"\n\n닿지 않은 질문은 저장하지 않았고 판본이 그대로다. 닿은 질문은 내용 변경으로 자동 재개된다.\n"
$w1=[self:write]{path:f"${out}/change.json",content:json($결과)}
$w2=[self:write]{path:f"${out}/change.md",content:$본문}
$r1=[self:read]{path:$w1.path};$r2=[self:read]{path:$w2.path}
return {change:$w1.path,report:$w2.path,readback:$r1.text==json($결과) and $r2.text==$본문,questions:$비교}
