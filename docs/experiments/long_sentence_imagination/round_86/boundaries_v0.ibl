#!ibl edition=2
[def:PC점검]($대상,$항목) {
  [try] {
    $batch=[fn:PC조회묶음]{대상:$대상,항목:$항목}
    $rows=$batch.items >> [table:each] {
      $r=$it
      [if:$r.status=="pending"] { $r=[fn:PC제어확인]{작업:$r,대기:60} }
      return {action:$it.action,verified:get($r,"verified",false)==true,raw:$r}
    }
    $actions=$rows >> [table:each] { return $it.action }
    $passed=$rows >> [table:filter]{where:($r)=>$r.verified==true}
    return {target:$대상,items:$rows,expected_count:len($항목),actual_count:len($rows),
      ordered:$actions==$항목,verified_count:len($passed),
      all_verified:len($항목)>0 and $actions==$항목 and len($passed)==len($항목),error:null}
  } [catch] {
    return {target:$대상,items:[],expected_count:len($항목),actual_count:0,
      ordered:false,verified_count:0,all_verified:false,error:$error}
  }
}
$empty=[fn:PC점검]{대상:"__local__",항목:[]}
$invalid=[fn:PC점검]{대상:"__local__",항목:["status","L86_unknown_action"]}
$lost=[fn:PC제어확인]{작업:{status:"pending",target:"__local__",verified:false,result:null,task_ref:null,verification:null,evidence_ref:null,failure:null},대기:0}
$prior=[self:read]{path:$prior_path}
$report={empty:$empty,invalid:$invalid,lost:$lost,prior_summary:{pc_verified:$prior.data.pc.verified_count,safari_verified:$prior.data.safari.verified,all_reads_verified:$prior.data.all_reads_verified}}
assert $empty.all_verified==false,"빈 요구를 전체 점검 성공으로 처리"
assert $invalid.all_verified==false,"미지원 항목을 점검 성공으로 처리"
assert $lost.status=="unknown" and $lost.verified==false,"소실 영수증을 성공으로 처리"
$text=json($report)
[self:write]{path:$out,content:$text}
$saved=[self:read]{path:$out}
assert $saved.text==$text,"경계 보고서 재독 불일치"
return {saved:$out,reread_equal:true,empty_verified:$empty.all_verified,invalid_verified:$invalid.all_verified,lost_status:$lost.status,prior:$report.prior_summary}
