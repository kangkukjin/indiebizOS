 "request": {
  "code": "#!ibl edition=2\n# 9회차 P1 v0 수집·정규화·사유 유형화 — inputs: 폴더. 요청 budget {steps:600000,rows:60000}\n# 반환: 주문(금액수·월), 배송(택배사·주문번호·발송일·도착일 ISO), 반품(유형 포함), 환불(환불금액수), 기준, 파일상태, 오류행\n\n# 금액 열을 숫자로. 빠른 경로가 실패한 파일만 행별로 다시 읽어 오류 행을 보존한다.\n[def:금액정규화]($행들,$열) {\n  [try] { return {행:$행들 >> [table:compute]{set:($r)=>{금액수:number(get($r,$열))}},오류행:[]} }\n  [catch] {\n    $느 = $행들 >> [table:each] {\n      [try] { return {**$it,금액수:number(get($it,$열)),금액오류:null} }\n      [catch] { return {**$it,금액수:null,금액오류:$error.message} }\n    }\n    return {행:$느,오류행:$느 >> [table:filter]{where:($r)=>$r.금액오류 != null}}\n  }\n}\n\n# 있을 수도 없을 수도 있는 파일 하나를 읽어 상태와 함께 돌려준다.\n[def:파일읽기]($경로,$이름) {\n  [try] { $문 = [self:read]{path:$경로}\n    return {파일:$이름,상태:\"읽음\",자료:$문.data,오류:null} }\n  [catch] { return {파일:$이름,상태:\"실패\",자료:null,오류:$error.message} }\n}\n\n# ── 주문 ──\n$주문파일 = [self:list]{path:f\"${$폴더}/orders\",pattern:\"orders_2025-*.csv\"} >> [table:sort]{by:\"name\"}\n$주문읽기 = $주문파일 >> [table:each]{parallel:4} {\n  $f = [fn:파일읽기]{경로:$it.path,이름:$it.name}\n  [if:$f.상태 != \"읽음\"] { return {파일:$it.name,상태:\"실패\",행:[],오류행:[],오류:$f.오류} }\n  $정 = [fn:금액정규화]{행들:$f.자료.items,열:\"금액\"}\n  return {파일:$it.name,상태:\"읽음\",행:$정.행,오류행:$정.오류행,오류:null}\n}\n$주문원 = $주문읽기 >> [table:each]{mode:\"flat_map\"} { return $it.행 }\n$주문 = $주문원 >> [table:compute]{set:($r)=>{월:split($r.주문일,\"-\")[1]}}\n$주문오류 = $주문읽기 >> [table:each]{mode:\"flat_map\"} { return $it.오류행 }\n\n# ── 배송: A(CSV, ISO 날짜) · B(JSON, order_id/shipped/delivered, 슬래시 날짜·null) ──\n$fa = [fn:파일읽기]{경로:f\"${$폴더}/shipments/carrier_A.csv\",이름:\"carrier_A.csv\"}\n$fb = [fn:파일읽기]{경로:f\"${$폴더}/shipments/carrier_B.json\",이름:\"carrier_B.json\"}\n$배송A = []\n[if:$fa.상태 == \"읽음\"] {\n  $배송A = $fa.자료.items >> [table:compute]{set:($r)=>{택배사:\"A\",도착:$r.도착일 == \"\" ? null : $r.도착일}} >> [table:select]{columns:[\"택배사\",\"주문번호\",\"발송일\",\"도착\"]}\n}\n$배송B = []\n[if:$fb.상태 == \"읽음\"] {\n  $배송B = $fb.자료.shipments >> [table:compute]{set:($r)=>{택배사:\"B\",주문번호:$r.order_id,발송일:replace($r.shipped,\"/\",\"-\"),도착:$r.delivered == null ? null : replace($r.delivered,\"/\",\"-\")}} >> [table:select]{columns:[\"택배사\",\"주문번호\",\"발송일\",\"도착\"]}\n}\n$배송 = $배송A + $배송B\n\n# ── 반품·환불·기준 ──\n$fr = [fn:파일읽기]{경로:f\"${$폴더}/returns.csv\",이름:\"returns.csv\"}\n$ff = [fn:파일읽기]{경로:f\"${$폴더}/refunds.csv\",이름:\"refunds.csv\"}\n$fs = [fn:파일읽기]{경로:f\"${$폴더}/sla.json\",이름:\"sla.json\"}\n$반품원 = $fr.상태 == \"읽음\" ? $fr.자료.items : []\n$환불정 = [fn:금액정규화]{행들:$ff.상태 == \"읽음\" ? $ff.자료.items : [],열:\"환불금액\"}\n\n# 사유 문장(서로 다른 것만)을 AI 로 유형화 → 반품 행에 붙인다.\n$사유들 = $반품원 >> [table:dedup]{by:\"사유\"}\n$사유표 = $사유들.items >> [table:select]{columns:[\"사유\"]}\n$AI = $사유표 >> [table:ai]{instruction:\"각 행의 사유는 온라인 상점 고객이 적은 반품 사유다. 유형을 '불량·파손', '오배송', '단순 변심', '배송 지연', '기대와 다름', '기타' 중 하나로 정한다.\",schema:\"유형(문자열)\",preserve_rows:true}\n$반품 = [table:join]{left:$반품원,right:$AI.items,on:\"사유\",how:\"left\",defaults:{유형:\"미분류\"}}\n\n$주문상태 = $주문읽기 >> [table:each] { return {파일:$it.파일,상태:$it.상태,행수:len($it.행),오류:$it.오류} }\n$파일상태 = $주문상태 + [\n  {파일:\"carrier_A.csv\",상태:$fa.상태,행수:len($배송A),오류:$fa.오류},\n  {파일:\"carrier_B.json\",상태:$fb.상태,행수:len($배송B),오류:$fb.오류},\n  {파일:\"returns.csv\",상태:$fr.상태,행수:len($반품원),오류:$fr.오류},\n  {파일:\"refunds.csv\",상태:$ff.상태,행수:len($환불정.행),오류:$ff.오류},\n  {파일:\"sla.json\",상태:$fs.상태,행수:0,오류:$fs.오류}]\nreturn {주문:$주문,배송:$배송,반품:$반품.items,환불:$환불정.행,기준:$fs.자료,파일상태:$파일상태,\n        오류행:$주문오류 + $환불정.오류행,사유유형:$AI.items,행수:{주문:len($주문),배송:len($배송),반품:len($반품원),환불:len($환불정.행)}}\n",
