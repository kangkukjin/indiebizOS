{
 "request": {
  "code": "#!ibl edition=2\n# 9회차 P3 v1 (변형 B: 고객표) 렌더·저장 (변형 A 는 문제 2,653건이라 요청 budget steps 400000 필요 — 기본 10만 초과) — inputs: 분석={$ref P2}, 보고서(md 경로), 목록(json 경로)\n$파일줄 = $분석.파일상태 >> [table:each] { return f\"| ${$it.파일} | ${$it.상태} | ${$it.행수} | ${$it.오류 == null ? '' : $it.오류} |\" }\n$종류줄 = $분석.종류별 >> [table:each] { return f\"| ${$it.종류} | ${$it.건수} |\" }\n$택배줄 = $분석.택배사표 >> [table:each] { return f\"| ${$it.택배사} | ${$it.도착} | ${$it.지연} | ${$it.지연율}% |\" }\n$지역줄 = $분석.지역표 >> [table:each] { return f\"| ${$it.지역} | ${$it.도착} | ${$it.지연} | ${$it.지연율}% |\" }\n$유형줄 = $분석.유형표 >> [table:each] { return f\"| ${$it.유형} | ${$it.건수} |\" }\n$사유줄 = $분석.사유유형 >> [table:each] { return f\"- ${$it.사유} → ${$it.유형} (AI)\" }\n$월줄 = $분석.월표 >> [table:each] { return f\"| ${$it.월} | ${$it.주문수} | ${$it.매출} | ${$it.반품} | ${$it.반품률 == null ? '-' : text($it.반품률)}% |\" }\n$고객줄 = $분석.고객표 >> [table:each] { return f\"| ${$it.고객} | ${$it.반품} | ${$it.주문} | ${$it.반품률 == null ? '-' : text($it.반품률)}% |\" }\n$문제줄 = $분석.문제 >> [table:each] { return f\"- [${$it.종류}] ${get($it,'주문번호',get($it,'파일',''))} — ${$it.근거}${get($it,'단서',null) == null ? '' : ' (' + get($it,'단서','') + ')'}\" }\n$단서문 = $분석.배송단서 == null ? \"\" : f\"\\n> 주의: ${$분석.배송단서}. '배송 기록 없음'·지연율·분실 의심은 읽은 택배사 기록만으로 계산했다.\\n\"\n$보고 = f\"# 2025년 상반기 주문·배송·반품 대사 보고서\\n\\n- 주문 ${$분석.주문수}건(취소 ${$분석.취소수}건), 매출(취소 제외) ${$분석.총매출}원\\n- 도착한 배송 ${$분석.도착수}건 중 지연 ${$분석.지연건수}건, 도착 기록 없는 배송 ${$분석.미도착수}건\\n- 문제 ${len($분석.문제)}건\\n${$단서문}\\n## 읽은 파일\\n| 파일 | 상태 | 행수 | 오류 |\\n| --- | --- | --- | --- |\\n${join('\\n',$파일줄)}\\n\\n## 문제 요약\\n| 종류 | 건수 |\\n| --- | --- |\\n${join('\\n',$종류줄)}\\n\\n## 배송 지연율 — 택배사별\\n| 택배사 | 도착 | 지연 | 지연율 |\\n| --- | --- | --- | --- |\\n${join('\\n',$택배줄)}\\n\\n## 배송 지연율 — 지역별\\n| 지역 | 도착 | 지연 | 지연율 |\\n| --- | --- | --- | --- |\\n${join('\\n',$지역줄)}\\n\\n## 월별 주문·매출·반품률\\n| 월 | 주문 수 | 매출(취소 제외) | 반품 | 반품률 |\\n| --- | --- | --- | --- | --- |\\n${join('\\n',$월줄)}\\n\\n## 반품 사유 유형 (AI 가 묶음)\\n| 유형 | 건수 |\\n| --- | --- |\\n${join('\\n',$유형줄)}\\n\\n문장별 AI 판정:\\n${join('\\n',$사유줄)}\\n\\n## 반품 많은 고객 상위 10\\n| 고객 | 반품 | 주문 | 반품률 |\\n| --- | --- | --- | --- |\\n${join('\\n',$고객줄)}\\n\\n## 문제 목록\\n${len($문제줄) == 0 ? '- 없음' : join('\\n',$문제줄)}\\n\"\n$목록본 = json({문제수:len($분석.문제),종류별:$분석.종류별,단서:$분석.배송단서,문제:$분석.문제})\n$쓰기 = [self:write]{path:$보고서,content:$보고} & [self:write]{path:$목록,content:$목록본}\n$재읽기 = [self:read]{path:$보고서} & [self:read]{path:$목록}\nreturn {보고일치:$재읽기[0].text == $보고,목록일치:$재읽기[1].text == $목록본,보고글자:len($보고),문제수:len($분석.문제)}\n",
