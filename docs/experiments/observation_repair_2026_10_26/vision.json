      "name": "화면검수",
      "function_id": "a33f45a7abc25eccbd1cd5f2402ffbcc",
      "revision": "8dbfd076487166d3f544942f51fbe150240fc883f21815b006746fd39e74edcc",
      "source_hash": "f34478377987ebc652bd9c5fb63821db1b1ec7647f06d9ab1f76303896a50724",
      "source": "#!ibl edition=2\n[def:화면검수]($path,$intent,$criteria=\"web\") {\n  $화면 = [engines:render]{path:$path,viewports:[\"1280x800\",\"390x844\"]}\n  $대상 = $화면.items\n  $수집 = $대상 >> [table:each]{on_error:\"collect\"} { return [engines:image_read]{op:\"critic\",image_path:$it.path,intent:f\"{$intent} — {$it.label} 폭에서 성립하는가\",criteria:$criteria,prescreen:$it.prescreen} }\n  $값 = $수집 >> [table:each]{} {\n    [if:is_ok($it)] { return {ok:true,source:$대상[$i],value:unwrap($it)} }\n    return {ok:false,source:$대상[$i],error:error_of($it)}\n  }\n  $결과 = [self:script]{id:\"판정관용구\",args:{op:\"collect\",results:$값,keep:[]}}\n  return $결과\n}"
    }
  ]
