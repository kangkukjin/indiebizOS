{
  "name": "indiebiz-member",
  "version": "0.1.3",
  "private": true,
  "description": "IndieBiz centrally managed member desktop",
  "author": "IndieBiz",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "prepare": "python3 ../scripts/build_member_desktop.py",
    "build": "node build.cjs"
  },
  "build": {
    "appId": "com.indiebiz.member",
    "productName": "IndieBiz Member",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "session.cjs",
      "security.cjs",
      "preload.cjs",
      "updates.cjs",
      "workspace.cjs",
      "setup.cjs",
      "*.html",
      "package.json",
      "update-trust.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "member",
        "filter": [
          "indiebiz-member*"
        ]
      }
    ],
    "protocols": [
      {
        "name": "IndieBiz Member registration",
        "schemes": [
          "indiebiz-member"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "IndieBizMember-${os}-${arch}.${ext}"
  }
}
