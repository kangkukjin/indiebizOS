#!/usr/bin/env bash
# IBL 어휘 정합성 pre-commit 훅
#
# `build_ibl_nodes.py --check` 의 트리거 목록은 **여기 없다** — 빌더가 선언하고
# (iblbuild_common.GUARD_INPUT_PATTERNS) 훅이 `--inputs-regex` 로 물어본다.
# 무엇이 트리거인지 보려면: python3 scripts/build_ibl_nodes.py --inputs
#
# (2026-07-25: 훅이 목록을 하드코딩하던 시절, 그 목록이 가드가 실제로 읽는 파일과
#  어긋나 뷰-렌더러 가드가 렌더러 편집에 발동하지 않았다. 목록의 거처를 옮겨 봉합.)
#
# 검사 실패 시 커밋 차단. `--no-verify` 로 우회 가능하지만 권장 X.
#
# 설치:
#   ln -sf "$(pwd)/scripts/git-hooks/pre-commit" .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit  (이미 +x 면 생략 가능)
set -euo pipefail

# 스테이징된 파일 목록.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# 검사 트리거 — ★빌더에게 물어본다(2026-07-25).
#
# 옛 구현은 이 정규식을 훅 안에 하드코딩했고, 그 목록이 가드가 *실제로 읽는 파일*과
# 어긋나 있었다: 뷰-렌더러 가드는 GenericInstrument.tsx·launcher_web_render.py 를
# 읽는데 둘 다 트리거에 없어, 렌더러에서 프리미티브 케이스를 지워도 커밋이 통과했다.
# 이제 트리거의 단일 진실 소스는 iblbuild_common.GUARD_INPUT_PATTERNS 이고
# 훅은 `--inputs-regex` 로 물어보기만 한다 — 가드가 새 파일을 읽기 시작해도 훅은 불변.
repo_root=$(git rev-parse --show-toplevel)
if ! ibl_trigger=$(python3 "$repo_root/scripts/build_ibl_nodes.py" --inputs-regex 2>/dev/null) \
   || [ -z "$ibl_trigger" ]; then
  # 트리거를 물어보지 못하면 *넓게* 잡는다(fail-closed) — 트리거 조회 실패를 이유로
  # 검사를 건너뛰면, 게이트 고장이 곧 무검사가 된다.
  echo "[pre-commit] ⚠ 가드 입력 목록 조회 실패 — 검사를 강제 실행합니다." >&2
  ibl_trigger='.'
fi

if echo "$staged" | grep -qE "$ibl_trigger"; then
  echo "[pre-commit] IBL 정합성 검사 실행..."
  if ! python3 "$repo_root/scripts/build_ibl_nodes.py" --check; then
    echo "" >&2
    echo "[pre-commit] IBL 검증 실패 — 커밋 차단." >&2
    echo "[pre-commit]   • src 편집 후 \`python3 scripts/build_ibl_nodes.py\` 재실행하여 ibl_nodes.yaml 갱신" >&2
    echo "[pre-commit]   • 검증 실패 항목은 위 로그 참조" >&2
    echo "[pre-commit]   • 정말로 우회하려면 \`git commit --no-verify\` (권장 X)" >&2
    exit 1
  fi
  echo "[pre-commit] IBL 정합성 OK ✓"
fi

# 폰(제약된 몸) 엔진 번들 매니페스트가 backend 변경에 맞게 최신인지 — 드리프트 게이트.
# backend/*.py 나 몸 프로파일이 스테이징되면 build_body_bundle.py --check 로 파생본 일치 확인.
if echo "$staged" | grep -qE '^(backend/.*\.py|data/bodies/.*\.json|scripts/build_body_bundle\.py)$'; then
  repo_root=$(git rev-parse --show-toplevel)
  echo "[pre-commit] 몸 번들 파생 검사 실행..."
  if ! python3 "$repo_root/scripts/build_body_bundle.py" android --check; then
    echo "" >&2
    echo "[pre-commit] 폰 엔진 번들이 backend 변경에 뒤처짐 — 커밋 차단." >&2
    echo "[pre-commit]   • \`python3 scripts/build_body_bundle.py android\` 재실행하여 매니페스트 갱신" >&2
    echo "[pre-commit]   • 새 backend 모듈이 폰 비호환이면 data/bodies/android.json 의 absent_packages/force_exclude 에 사유와 함께 선언" >&2
    exit 1
  fi
  echo "[pre-commit] 몸 번들 파생 OK ✓"
fi

# 의식 출력 스키마 이름 드리프트 — 프롬프트 응답 형식(생산자)이나 소비처 코드가 스테이징되면
# 생산자↔소비처 키 정합을 검사(개명 시 highlight_actions/hint 무성음 누락 방지, 4번째 층).
if echo "$staged" | grep -qE '^(data/common_prompts/consciousness_prompt\.md|backend/(prompt_builder|agent_cognitive|consciousness_agent)\.py|scripts/consciousness_schema_check\.py)$'; then
  repo_root=$(git rev-parse --show-toplevel)
  echo "[pre-commit] 의식 출력 스키마 정합 검사 실행..."
  if ! python3 "$repo_root/scripts/consciousness_schema_check.py"; then
    echo "" >&2
    echo "[pre-commit] 의식 출력 스키마 드리프트 — 커밋 차단." >&2
    echo "[pre-commit]   • 소비처가 프롬프트 미선언 키를 읽음(항상 빈 값=조언 유실)." >&2
    echo "[pre-commit]   • 소비처를 정본 키로 정렬하거나 consciousness_prompt.md 응답 형식에 키를 선언." >&2
    echo "[pre-commit]   • 우회: \`git commit --no-verify\` (권장 X)" >&2
    exit 1
  fi
  echo "[pre-commit] 의식 출력 스키마 정합 OK ✓"
fi

# 표준 코어 매니페스트 드리프트 — 패키지/앱/중앙어휘가 추가·제거되면 core_manifest.json 이
# 배포 집합(git 추적)과 어긋날 수 있다. 코어/사용자 경계의 단일 진실이므로 stale 커밋 차단.
if echo "$staged" | grep -qE '^(data/packages/(installed|not_installed)/[^/]+/[^/]+/|data/instruments/.*\.yaml|data/ibl_nodes_src/.*\.yaml|scripts/build_core_manifest\.py|scripts/build_dist_filter\.py|frontend/package\.json)'; then
  repo_root=$(git rev-parse --show-toplevel)
  echo "[pre-commit] 표준 코어 매니페스트 검사 실행..."
  if ! python3 "$repo_root/scripts/build_core_manifest.py" --check; then
    echo "" >&2
    echo "[pre-commit] core_manifest.json 이 배포 집합과 불일치 — 커밋 차단." >&2
    echo "[pre-commit]   • \`python3 scripts/build_core_manifest.py\` 재실행하여 매니페스트 갱신 후 스테이지" >&2
    echo "[pre-commit]   • 이 매니페스트는 코어/사용자(앱·어휘) 경계의 단일 진실 — 업데이터가 참조함" >&2
    echo "[pre-commit]   • 우회: \`git commit --no-verify\` (권장 X)" >&2
    exit 1
  fi
  echo "[pre-commit] 표준 코어 매니페스트 OK ✓"
  # 설치 파일 필터도 매니페스트 주도로 최신인지 (개인 앱·패키지가 배포에 새지 않게)
  echo "[pre-commit] 설치 파일 필터 검사 실행..."
  if ! python3 "$repo_root/scripts/build_dist_filter.py" --check; then
    echo "" >&2
    echo "[pre-commit] package.json 설치필터가 매니페스트와 불일치 — 커밋 차단." >&2
    echo "[pre-commit]   • \`python3 scripts/build_dist_filter.py\` 재실행 후 스테이지" >&2
    echo "[pre-commit]   • 비-코어 패키지/앱이 설치 파일로 새는 걸 막는 매니페스트 주도 필터" >&2
    echo "[pre-commit]   • 우회: \`git commit --no-verify\` (권장 X)" >&2
    exit 1
  fi
  echo "[pre-commit] 설치 파일 필터 OK ✓"
fi

# 윈도우 이식성 정적 검사 — 유닉스 전용 stdlib(fcntl 등)의 무가드 톱레벨 import 는
# 윈도우에서 모듈 로드 자체를 죽인다(2026-07-20 portal_core/bulletin_core 실측 부류).
# 의존성 0 AST 검사라 빠름. CI(portability.yml) 정적 잡과 같은 스크립트.
if echo "$staged" | grep -qE '^(backend/.*\.py|data/packages/installed/.*\.py|scripts/check_win_portability\.py)$'; then
  repo_root=$(git rev-parse --show-toplevel)
  echo "[pre-commit] 윈도우 이식성 검사 실행..."
  if ! python3 "$repo_root/scripts/check_win_portability.py"; then
    echo "" >&2
    echo "[pre-commit] 윈도우 이식성 위반 — 커밋 차단." >&2
    echo "[pre-commit]   • try/except ImportError 폴백(portal_core.py 참조) 또는 lazy import 로 가드" >&2
    echo "[pre-commit]   • 우회: \`git commit --no-verify\` (권장 X)" >&2
    exit 1
  fi
  echo "[pre-commit] 윈도우 이식성 OK ✓"
fi

# 모듈 그림자 — 패키지 최상위 모듈명이 backend/stdlib 이름과 겹치면 sys.modules 오염
# (cctv 옛 common.py 가 backend/common 을 덮어 공유 유틸 불능→복붙 확산 부류, 2026-08-05 가드화).
if echo "$staged" | grep -qE '^(data/packages/installed/tools/.*|backend/[^/]+\.py|scripts/check_module_shadowing\.py)$'; then
  repo_root=$(git rev-parse --show-toplevel)
  echo "[pre-commit] 모듈 그림자 검사 실행..."
  if ! python3 "$repo_root/scripts/check_module_shadowing.py"; then
    echo "" >&2
    echo "[pre-commit] 모듈 그림자 위반 — 커밋 차단." >&2
    echo "[pre-commit]   • 패키지 모듈을 '<패키지>_<이름>.py' 로 개명 (예: common.py → cctv_common.py)" >&2
    echo "[pre-commit]   • 우회: \`git commit --no-verify\` (권장 X)" >&2
    exit 1
  fi
  echo "[pre-commit] 모듈 그림자 OK ✓"
fi

# 파라미터·op 정본 — 같은 개념의 새 이름(검색어 7이름·상한 7이름 사태) 재발 차단.
# 기존 위반은 스크립트 내 BASELINE 동결, 신규 어휘만 게이트 (2026-08-05 어휘 감사).
if echo "$staged" | grep -qE '^(data/packages/installed/tools/.*/(ibl_actions\.yaml|tool\.json)|data/ibl_nodes_src/.*\.yaml|data/ibl_nodes\.yaml|scripts/check_param_canon\.py)$'; then
  repo_root=$(git rev-parse --show-toplevel)
  echo "[pre-commit] 파라미터/op 정본 검사 실행..."
  if ! python3 "$repo_root/scripts/check_param_canon.py"; then
    echo "" >&2
    echo "[pre-commit] 파라미터/op 정본 위반 — 커밋 차단." >&2
    echo "[pre-commit]   • 정본으로 개명: q/keyword→query, count/max_results/display→limit, lon→lng, op get→detail" >&2
    echo "[pre-commit]   • 관습어 수용은 aliases: 블록으로 (예: aliases: {query: [q]})" >&2
    echo "[pre-commit]   • 우회: \`git commit --no-verify\` (권장 X)" >&2
    exit 1
  fi
  echo "[pre-commit] 파라미터/op 정본 OK ✓"
fi

# 맨 문자열 반환 — 도구 결과 경로(execute/디스패처 op 함수)의 문자열 리터럴 return 차단.
# 관례: 에러={"success":False,"error"} / 효과·빈 결과={"success":True,"message"[,"items":[]]}
# (2026-08-05 감사 ② 수렴 완료 후 재발 봉쇄. system_essentials 텍스트 계약만 BASELINE 래칫.)
if echo "$staged" | grep -qE '^(data/packages/installed/tools/.*/handler\.py|scripts/check_string_returns\.py)$'; then
  repo_root=$(git rev-parse --show-toplevel)
  echo "[pre-commit] 맨 문자열 반환 검사 실행..."
  if ! python3 "$repo_root/scripts/check_string_returns.py"; then
    echo "" >&2
    echo "[pre-commit] 맨 문자열 반환 위반 — 커밋 차단." >&2
    echo "[pre-commit]   • 에러는 json.dumps({\"success\": False, \"error\": msg}, ensure_ascii=False) 로" >&2
    echo "[pre-commit]   • 빈 결과는 {\"success\": True, \"message\": msg, \"items\": []} 로 (파이프 보호)" >&2
    echo "[pre-commit]   • 우회: \`git commit --no-verify\` (권장 X)" >&2
    exit 1
  fi
  echo "[pre-commit] 맨 문자열 반환 OK ✓"
fi

# 공용 렌더 코어 — 앱 표면 렌더 로직이 다시 데스크탑/원격 두 벌로 갈라지는 것 차단.
# (2026-08-05 감사 ④: 로직 정본=backend/static/app_render_core.js, 마크업만 표면별)
# ★가드 ④(미디어 라우트 목록)의 입력은 통화를 만드는 backend/·핸들러 .py 다 — 그쪽도
#   방아쇠에 넣는다("게이트가 자기 입력을 안 본다"를 여기서 반복하지 않기 위해. 0.2초).
if echo "$staged" | grep -qE '^(backend/.*\.py|backend/static/app_render_core\.js|frontend/src/components/GenericInstrument\.tsx|frontend/src/components/generic/.*|data/packages/installed/.*\.py|scripts/check_render_core\.py)$'; then
  repo_root=$(git rev-parse --show-toplevel)
  echo "[pre-commit] 공용 렌더 코어 검사 실행..."
  if ! python3 "$repo_root/scripts/check_render_core.py"; then
    echo "" >&2
    echo "[pre-commit] 공용 렌더 코어 위반 — 커밋 차단." >&2
    echo "[pre-commit]   • 로직은 backend/static/app_render_core.js 하나가 정본(표면은 마크업만)" >&2
    echo "[pre-commit]   • export 는 그 파일 맨 끝 블록 하나로만 (원격은 고전 <script> 로 인라인)" >&2
    echo "[pre-commit]   • 우회: \`git commit --no-verify\` (권장 X)" >&2
    exit 1
  fi
  echo "[pre-commit] 공용 렌더 코어 OK ✓"
fi

# 파일 크기 규칙(1500줄) — 게이트 없는 규칙은 선호일 뿐(2026-07 모듈화가 3주 만에
# 재위반된 실증에서 가드화). 기존 부채는 BASELINE 래칫 동결(악화 금지), 신규 위반 차단.
if echo "$staged" | grep -qE '\.(py|ts|tsx|js)$'; then
  repo_root=$(git rev-parse --show-toplevel)
  echo "[pre-commit] 파일 크기 검사 실행..."
  if ! python3 "$repo_root/scripts/check_file_size.py"; then
    echo "" >&2
    echo "[pre-commit] 파일 크기 위반 — 커밋 차단." >&2
    echo "[pre-commit]   • 1500줄 초과분을 형제 모듈로 분리 (CLAUDE.md 파일 크기 규칙)" >&2
    echo "[pre-commit]   • 부채 파일(BASELINE)은 더 자랄 수 없음 — 변경분을 새 모듈로" >&2
    echo "[pre-commit]   • 우회: \`git commit --no-verify\` (권장 X)" >&2
    exit 1
  fi
  echo "[pre-commit] 파일 크기 OK ✓"
fi

# 이벤트 루프 규율 — async 함수 본문의 동기 블로킹 호출은 단일 프로세스 서버 전체를
# 세우고, 이 서버는 자기 자신을 부르는 경로가 많아 자기교착까지 간다(같은 부류 3회
# 재발: 창고 폴러 · public_face 인프로세스 프록시 · /ibl/execute). 이식성 검사와 같은
# AST 기법·같은 대상이라 비용도 같은 수준.
if echo "$staged" | grep -qE '^(backend/.*\.py|data/packages/installed/.*\.py|scripts/check_event_loop\.py)$'; then
  repo_root=$(git rev-parse --show-toplevel)
  echo "[pre-commit] 이벤트 루프 규율 검사 실행..."
  if ! python3 "$repo_root/scripts/check_event_loop.py"; then
    echo "" >&2
    echo "[pre-commit] 이벤트 루프 블로킹 — 커밋 차단." >&2
    echo "[pre-commit]   • await asyncio.to_thread(fn, *args) 로 스레드에 내리기" >&2
    echo "[pre-commit]   • await 가 없는 FastAPI 라우트면 \`async def\` → \`def\` (Starlette 이 스레드풀로 돌림)" >&2
    echo "[pre-commit]   • 진짜 예외면 그 줄에 \`# eventloop-ok: <사유>\` (사유 필수)" >&2
    echo "[pre-commit]   • 우회: \`git commit --no-verify\` (권장 X)" >&2
    exit 1
  fi
  echo "[pre-commit] 이벤트 루프 규율 OK ✓"
fi

# 공개 노출 ↔ 인증 대조 — is_public_remote_path 가 세션 없이 통과시키는 경로가 자체
# 인증을 실제로 가졌는지. "자체 시크릿 게이트 보유"는 지금까지 주석으로만 있던 불변식이라
# 등록만 하고 검사를 빠뜨리면 그 라우트가 조용히 공개 인터넷에 열렸다.
if echo "$staged" | grep -qE '^(backend/api_.*\.py|backend/public_face\.py|scripts/check_public_routes\.py)$'; then
  repo_root=$(git rev-parse --show-toplevel)
  echo "[pre-commit] 공개 라우트 인증 대조 실행..."
  if ! python3 "$repo_root/scripts/check_public_routes.py"; then
    echo "" >&2
    echo "[pre-commit] 무인증 공개 라우트 — 커밋 차단." >&2
    echo "[pre-commit]   • 자체 게이트 추가(_check_secret / @require_auth / limb_keys.validate)" >&2
    echo "[pre-commit]   • 또는 is_public_remote_path 에서 제거해 런처 세션을 요구" >&2
    echo "[pre-commit]   • 정말 익명이어야 하면 check_public_routes.py 의 ANONYMOUS_ALLOW 에 사유와 함께 선언" >&2
    exit 1
  fi
fi

# 자기수정 안전장치 기능 스모크 (③검증자 없는 영역 보강, 2026-08-05) —
